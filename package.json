  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@playwright/test": "^1.63.0",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.1",
    "vitest": "4.1.11",
    "wrangler": "4.146.0"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "scripts": {
    "astro": "astro",
    "build": "astro build && node scripts/verify-access.mjs",
    "cf-typegen": "wrangler types",
