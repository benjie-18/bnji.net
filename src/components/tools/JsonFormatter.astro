---
/**
 * Tools — JSON Formatter & Validator.
 *
 * Markup and CSS only; the behaviour lives in src/scripts/tools-json.ts and is
 * started from boot(). The editor's contents are rendered as text everywhere
 * (status, error, note) — this component has no innerHTML sink at all, which is
 * what keeps a hostile paste inert.
 */
import Chip from '../Chip.astro';
import GlassPanel from '../GlassPanel.astro';
import { TOOL_JSON_CONFIG } from '../../config/tools.config';
---

<section
	class="tool tool--json"
	id="json-formatter"
	aria-labelledby="json-formatter-title"
	data-json-formatter
>
	<GlassPanel pad="lg" reveal>
		<header class="tool__head">
			<p class="eyebrow"><span>02</span><span>/ JSON</span></p>
			<h2 class="tool__title" id="json-formatter-title">JSON Formatter &amp; Validator</h2>
			<p class="tool__lead">
				Paste JSON to check it, pretty-print it, or squeeze it onto one line. A failed parse keeps every
				character you typed and tells you the line and column where it broke. Nothing is sent anywhere.
			</p>
			<ul class="tool__chips" role="list">
				<li><Chip tone="live" dot>Runs locally</Chip></li>
				<li><Chip>Format · Minify · Copy · Clear</Chip></li>
			</ul>
		</header>

		<div class="tool__body">
			<div class="tool__field">
				<label class="tool__label" for="json-editor">JSON</label>
				<textarea
					class="tool__editor"
					id="json-editor"
					data-json-editor
					rows="12"
					spellcheck="false"
					autocapitalize="off"
					autocomplete="off"
					aria-describedby="json-editor-hint"
					placeholder={'{\n  "paste": "json here"\n}'}
				></textarea>
				<p class="tool__hint" id="json-editor-hint">
					Up to {TOOL_JSON_CONFIG.maxCharacters.toLocaleString('en-US')} characters. Invalid JSON is never
					discarded — the error points at the exact line and column.
				</p>
			</div>

			{/*
			  Plain <button class="glass-button"> rather than the GlassButton
			  component: GlassButton only forwards the props it declares, so a
			  data-* hook passed to it is dropped and the script would find
			  nothing to bind. The lab components use the same markup for the
			  same reason.
			*/}
			<div class="tool__actions">
				<button class="glass-button glass-button--primary" type="button" data-glass="" data-json-format>
					Format
				</button>
				<button class="glass-button" type="button" data-glass="" data-json-minify>
					Minify
				</button>
				<button class="glass-button" type="button" data-glass="" data-json-copy>
					Copy
				</button>
				<button class="glass-button glass-button--quiet" type="button" data-glass="" data-json-clear>
					Clear
				</button>
			</div>

			<p class="tool__status" role="status" data-json-status aria-live="polite"></p>
			<p class="tool__error" role="alert" data-json-error hidden></p>
			<p class="tool__note" data-json-note hidden></p>
		</div>
	</GlassPanel>
</section>
