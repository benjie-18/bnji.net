---
/**
 * Tools — Text Diff.
 *
 * Same split as the image converter and the word counter: the whole interface is
 * markup plus CSS, and every behaviour lives in src/scripts/tools-diff.ts,
 * reached through boot(). With JavaScript blocked, late or broken, the two boxes
 * and the note still explain what the tool compares, what it refuses and how a
 * row is read — the comparison table is simply empty rather than missing, so
 * nothing on the page depends on the script to make sense.
 *
 * Limits, the view labels and the sentences that explain a trade-off come from
 * src/config/tools.config.ts: the component never hard-codes a limit, a context
 * default or a hint.
 */
import GlassPanel from '../GlassPanel.astro';
import {
	DIFF_VIEWS,
	DIFF_VIEW_HINT,
	DIFF_VIEW_LABEL,
	TEXT_FILE_CONFIG,
	TEXT_INPUT_ACCEPT,
	TEXT_INPUT_LABELS,
	TOOL_DIFF_CONFIG,
} from '../../config/tools.config';

const { context, maxInputCharacters, autoCompareMaxCharacters, maxRenderedRows } = TOOL_DIFF_CONFIG;
/* The byte limit is the shared text-file policy, not a diff setting. */
const { maxBytes: maxFileBytes } = TEXT_FILE_CONFIG;
---

<section
	class="tool tool--diff"
	id="text-diff"
	aria-labelledby="text-diff-title"
	data-text-diff
	data-view="unified"
>
	<GlassPanel pad="lg" reveal>
		<header class="tool__head">
			<p class="eyebrow"><span>03</span><span>/ DIFF</span></p>
			<h2 class="tool__title" id="text-diff-title">Text diff</h2>
			<p class="tool__lead">
				Paste two versions of a text — or drop two files — and see what changed: line by line, and
				inside a line, word by word. The comparison runs in this tab, so nothing you paste is sent
				anywhere.
			</p>
		</header>

		<div class="tool__body">
			<div class="tool__panes">
				<div class="tool__pane">
					<div class="tool__field">
						<label class="tool__label" for="diff-left">Left text</label>
						{/*
						  spellcheck is off on purpose: a diff is full of fragments that
						  are not words, and a browser's spelling pass over both boxes is
						  work nobody asked for. No maxlength either — it would truncate a
						  paste silently, and this tool refuses over the limit out loud
						  instead (see checkSideText).
						*/}
						<textarea
							class="tool__textarea"
							id="diff-left"
							rows="10"
							spellcheck="false"
							autocapitalize="off"
							autocomplete="off"
							placeholder="The version you started from…"
							aria-describedby="diff-source-hint"
							data-diff-left></textarea>
						{/* The label IS the drop target, as in the other two tools: clicking
						    it opens the picker natively, dragging a file onto it loads it, and
						    Tab reaches the input inside. */}
						<label class="tool-drop" data-diff-left-drop>
							<span class="sr-only">Choose a text file for the left side</span>
							<input
								class="tool-drop__input"
								type="file"
								accept={TEXT_INPUT_ACCEPT}
								aria-describedby="diff-source-hint"
								data-diff-left-source
							/>
							<span class="tool-drop__prompt">Or choose / drop a text file</span>
						</label>
						<p class="tool__preview-meta mono" data-diff-left-meta></p>
					</div>
				</div>

				<div class="tool__pane">
					<div class="tool__field">
						<label class="tool__label" for="diff-right">Right text</label>
						<textarea
							class="tool__textarea"
							id="diff-right"
							rows="10"
							spellcheck="false"
							autocapitalize="off"
							autocomplete="off"
							placeholder="The version you ended with…"
							aria-describedby="diff-source-hint"
							data-diff-right></textarea>
						<label class="tool-drop" data-diff-right-drop>
							<span class="sr-only">Choose a text file for the right side</span>
							<input
								class="tool-drop__input"
								type="file"
								accept={TEXT_INPUT_ACCEPT}
								aria-describedby="diff-source-hint"
								data-diff-right-source
							/>
							<span class="tool-drop__prompt">Or choose / drop a text file</span>
						</label>
						<p class="tool__preview-meta mono" data-diff-right-meta></p>
					</div>
				</div>
			</div>

			<p class="tool__hint" id="diff-source-hint">
				Reads {TEXT_INPUT_LABELS} as UTF-8, up to {(maxFileBytes / (1024 * 1024)).toLocaleString('en-US')} MB
				each, and up to {maxInputCharacters.toLocaleString('en-US')} characters per side. A loaded file
				replaces whatever is in its own box, so you can edit it before comparing.
			</p>

			<div class="tool__controls">
				<div class="tool__field">
					<label class="tool__label" for="diff-view-mode">How the difference is shown</label>
					<select class="tool__select" id="diff-view-mode" data-diff-view-mode>
						{DIFF_VIEWS.map((view) => <option value={view}>{DIFF_VIEW_LABEL[view]}</option>)}
					</select>
					<p class="tool__hint" id="diff-view-hint" data-diff-view-hint>
						{DIFF_VIEW_HINT.unified}
					</p>
				</div>

				<div class="tool__field">
					<label class="tool__label" for="diff-context">
						Lines of context
						<span class="tool__value mono" data-diff-context-value>{context.default} lines</span>
					</label>
					<input
						class="tool__range"
						id="diff-context"
						type="range"
						min={context.min}
						max={context.max}
						step={context.step}
						value={context.default}
						aria-describedby="diff-context-hint"
						data-diff-context
					/>
					<p class="tool__hint" id="diff-context-hint">
						How many unchanged lines stay visible around each change — the same setting a unified
						patch's context is. {context.min} shows the changed lines only.
					</p>
				</div>

				<fieldset class="tool__field tool__field--checks">
					<legend class="tool__label">Comparing</legend>
					<label class="tool__check">
						<input type="checkbox" data-diff-ignore-space />
						<span>Ignore whitespace differences</span>
					</label>
					<label class="tool__check">
						<input type="checkbox" checked data-diff-inline-words />
						<span>Mark the words that changed inside a line</span>
					</label>
					<p class="tool__hint">
						Ignoring whitespace folds a run of spaces to one and trims the ends before comparing, but
						shows what you typed — and the summary counts the lines that matched only that way.
						Word marking is skipped for a line too long to be worth it, and the line is shown whole.
					</p>
				</fieldset>
			</div>

			{/*
			  Plain <button class="glass-button"> rather than the GlassButton
			  component: GlassButton only forwards the props it declares, so a
			  data-* hook passed to it is dropped and the script would find
			  nothing to bind. The other two tools use this markup for the same
			  reason, and tests/tools-markup.test.ts guards it.
			*/}
			<div class="tool__actions">
				<button class="glass-button glass-button--primary" type="button" data-glass="" data-diff-compare>
					Compare
				</button>
				<button class="glass-button" type="button" data-glass="" data-diff-copy disabled>
					Copy patch
				</button>
				<button class="glass-button glass-button--quiet" type="button" data-glass="" data-diff-reset>
					Reset
				</button>
			</div>

			<p class="tool__status" role="status" data-diff-status aria-live="polite"></p>
			<p class="tool__error" role="alert" data-diff-error hidden></p>

			<div class="tool__results" data-diff-results hidden>
				<dl class="tool__stats">
					<div class="tool__stat tool__stat--removed">
						<dt class="tool__stat-label">Lines removed</dt>
						<dd class="tool__stat-value mono" data-diff-removed>0</dd>
					</div>
					<div class="tool__stat tool__stat--added">
						<dt class="tool__stat-label">Lines added</dt>
						<dd class="tool__stat-value mono" data-diff-added>0</dd>
					</div>
					<div class="tool__stat">
						<dt class="tool__stat-label">Lines unchanged</dt>
						<dd class="tool__stat-value mono" data-diff-unchanged>0</dd>
					</div>
					<div class="tool__stat">
						<dt class="tool__stat-label">Places changed</dt>
						<dd class="tool__stat-value mono" data-diff-sections>0</dd>
					</div>
				</dl>

				<div class="tool__diff-block">
					<h3 class="tool__sub-title" id="text-diff-view-title">The difference</h3>
					<p class="tool__hint" id="text-diff-view-how">
						Each row is the left line number, the right line number, then <span class="mono">-</span>
						for a line only the left text has, <span class="mono">+</span> for a line only the right
						text has, <span class="mono">~</span> for a line that matches only because whitespace
						differences are being ignored, and no sign for a line both have. Colour repeats that; it
						never carries it alone.
					</p>
					{/*
					  Column captions are visual only: a screen reader meets the rows in
					  document order, and every row already says both of its line numbers,
					  so "Left" and "Right" floating past would be noise.
					*/}
					<div class="tool__diff-head mono" aria-hidden="true">
						<span>Left</span>
						<span>Right</span>
					</div>
					{/*
					  tabindex="0" because the table scrolls: a scrollable region a
					  keyboard cannot reach is a region a keyboard cannot read.
					*/}
					<div
						class="tool__diff mono"
						role="group"
						tabindex="0"
						aria-labelledby="text-diff-view-title"
						data-diff-view
					></div>
				</div>
			</div>

			<p class="tool__note">
				Comparisons run as you type until either side passes
				{autoCompareMaxCharacters.toLocaleString('en-US')} characters, after which Compare runs it when
				you ask: a diff costs the two sides multiplied together, where a word count costs one. Line
				endings are folded first, so a file saved on Windows does not show every line as changed, and a
				line break at the very end of one text is reported rather than swallowed. The table shows at
				most {maxRenderedRows.toLocaleString('en-US')} rows and says how many it withheld; the copied
				patch always has every line, in the unified format <span class="mono">git apply</span> reads.
				Both texts stay in this tab — nothing is uploaded, stored or logged.
			</p>
		</div>
	</GlassPanel>
</section>
