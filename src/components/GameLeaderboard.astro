---
/**
 * Shared leaderboard panel: mode tabs, a paged board, and the caller's own
 * standing. Used by `/projects/games/<game>/leaderboard/` for every game that has a
 * server verifier.
 *
 * The rows are fetched, not rendered — the page stays static, and mode/page
 * live in the query string (see `src/scripts/game-leaderboard`).
 */
import type { Game } from '../data/games';
import { leaderboardModes, MODE_LABEL } from '../data/game-adapters';

interface Props {
	game: Game;
	/** Initial mode, so the tab markup can be server-rendered without a flash. */
	initialMode?: string;
}
const { game, initialMode } = Astro.props;
const modes = leaderboardModes(game);
const current = initialMode && modes.includes(initialMode) ? initialMode : modes[0] ?? 'default';
---

<section
	class="glass-panel leaderboard"
	data-glass="raised large"
	data-board
	data-game-id={game.id}
	aria-labelledby="leaderboard-title"
>
	<header class="leaderboard__head">
		<div>
			<p class="eyebrow">Leaderboard</p>
			<h2 id="leaderboard-title">{game.title}</h2>
		</div>
		<p class="glass-item leaderboard__you" data-board-you hidden>
			<span class="glass-label">You</span> <span data-board-you-value></span>
		</p>
	</header>

	{
		modes.length > 1 && (
			<div class="glass-tabs leaderboard__tabs" role="tablist" aria-label="Score modes">
				<div class="glass-tabs__list" data-board-tabs>
					{modes.map((mode) => (
						<button
							type="button"
							class="glass-tabs__item"
							role="tab"
							data-board-mode={mode}
							aria-selected={mode === current ? 'true' : 'false'}
						>
							{MODE_LABEL[mode] ?? mode}
						</button>
					))}
					<span class="glass-tabs__indicator" data-board-indicator aria-hidden="true"></span>
				</div>
			</div>
		)
	}

	<ol class="leaderboard__rows" data-board-rows></ol>
	<p class="leaderboard__status" data-board-status role="status" aria-live="polite">Loading the board…</p>
	<div class="leaderboard__actions">
		<button type="button" class="glass-button glass-button--primary" data-board-more hidden>Load more</button>
	</div>
</section>

<script>
	import { mountGameLeaderboard } from '../scripts/game-leaderboard';
	for (const root of document.querySelectorAll<HTMLElement>('[data-board]')) mountGameLeaderboard(root);
</script>

<style>
	.leaderboard { display: grid; gap: var(--space-4); padding: clamp(var(--space-4), 3vw, var(--space-6)); }
	.leaderboard__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-3) var(--space-5); }
	.leaderboard__head h2 { margin: var(--space-1) 0 0; color: var(--text-strong); font-size: var(--text-title); }
	.leaderboard__you { margin: 0; min-height: 1.6em; border-color: var(--accent-line); background: var(--accent-soft); color: var(--text-strong); }
	.leaderboard__rows { display: grid; gap: var(--space-2); margin: 0; padding: 0; list-style: none; }
	.leaderboard__rows :global(.leaderboard-row) {
		display: grid;
		grid-template-columns: minmax(var(--space-7), auto) minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-2) var(--space-4);
		padding: var(--space-3) var(--space-4);
		border-color: var(--glass-border-strong);
		background: var(--glass-bg);
	}
	.leaderboard__rows :global(.leaderboard-row:nth-child(-n + 3)) { border-color: var(--accent-line); background: var(--glass-bg-raised); }
	.leaderboard__rows :global(.leaderboard-row--empty) { display: block; padding: var(--space-4); color: var(--text-strong); }
	.leaderboard__status { min-height: 1.6em; margin: 0; color: var(--text); font-size: var(--text-small); }
	.leaderboard__actions { display: flex; gap: var(--space-2); }
	:global(.leaderboard-row__rank) { color: var(--accent-strong); font-size: var(--text-small); font-weight: 700; min-inline-size: var(--space-7); }
	:global(.leaderboard-row__main) { display: grid; gap: var(--space-1); }
	:global(.leaderboard-row__main strong) { color: var(--text-strong); overflow-wrap: anywhere; }
	:global(.leaderboard-row__meta) { color: var(--text-muted); font-size: var(--text-micro); }
	:global(.leaderboard-row__score) { color: var(--text-strong); font-size: var(--text-lead); font-weight: 700; }
	@media (max-width: 560px) {
		.leaderboard__rows :global(.leaderboard-row) { grid-template-columns: minmax(0, 1fr) auto; }
		:global(.leaderboard-row__rank) { min-inline-size: 0; }
	}
</style>
