const { name, size = 18, class: className = '', title } = Astro.props;

const brandPath = BRAND_PATHS[name];
const strokePath = STROKE_PATHS[name];
---

{
	brandPath ? (
		<svg
			class:list={['icon', className]}
			width={size}
			height={size}
			viewBox="0 0 16 16"
			fill="currentColor"
			aria-hidden={title ? undefined : 'true'}
			role={title ? 'img' : undefined}
		>
			{title && <title>{title}</title>}
			<path d={brandPath} />
		</svg>
	) : (
		<svg
			class:list={['icon', className]}
			width={size}
			height={size}
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden={title ? undefined : 'true'}
			role={title ? 'img' : undefined}
		>
			{title && <title>{title}</title>}
			<path d={strokePath} />
		</svg>
	)
}

<style>
	.icon {
		flex: none;
	}
</style>
