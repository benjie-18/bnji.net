---
/**
 * Icon — the site's small inline icon set.
 *
 * One place for SVG paths so components never duplicate them. Stroke icons share
 * a 24x24 grid and inherit `currentColor`; the GitHub mark is a filled 16x16
 * brand path, which is why it is flagged separately.
 *
 * Icons are decorative unless the caller sets `title`, in which case the SVG is
 * exposed as an image with that accessible name.
 */
export type IconName =
	| 'arrow-right'
	| 'arrow-up-right'
	| 'chevron-down'
	| 'mail'
	| 'github'
	| 'flask'
	| 'spark'
	| 'terminal'
	| 'server'
	| 'compass'
	| 'globe'
	| 'rss';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
	/** Accessible name. Omit for decorative icons next to a text label. */
	title?: string;
}

/** Stroke icons: 24x24 viewBox, 1.5px round-cap strokes. */
const STROKE_PATHS: Partial<Record<IconName, string>> = {
	'arrow-right': 'M4 12h15m0 0-5.5-5.5M19 12l-5.5 5.5',
	'arrow-up-right': 'M7 17 17 7m0 0H8.5M17 7v8.5',
	'chevron-down': 'm6 9.5 6 6 6-6',
	mail: 'M3.5 6.5h17v11h-17zM3.5 7l8.5 6 8.5-6',
	flask: 'M9.5 3v6.2L4.6 17.4A2 2 0 0 0 6.3 20.5h11.4a2 2 0 0 0 1.7-3.1L14.5 9.2V3M8 3h8M7.8 14.5h8.4',
	spark: 'M12 3.2c.8 4.6 2 6.9 4 8.3 1.2.8 2.6 1.2 4 1.3-1.4.2-2.8.6-4 1.4-2 1.4-3.2 3.7-4 8.3-.8-4.6-2-6.9-4-8.3-1.2-.8-2.6-1.2-4-1.4 1.4-.1 2.8-.5 4-1.3 2-1.4 3.2-3.7 4-8.3Z',
	terminal: 'm5 7 5 5-5 5M12.5 17h6.5',
	server:
		'M4 5.5h16v5H4zM4 13.5h16v5H4zM7.5 8h.01M7.5 16h.01M11 8h5M11 16h5',
	compass: 'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm3.8 4.7-2 5.6-5.6 2 2-5.6Z',
	globe:
		'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 0 0 0-17Zm0 0c2.3 2.5 3.5 5.4 3.5 8.5s-1.2 6-3.5 8.5c-2.3-2.5-3.5-5.4-3.5-8.5s1.2-6 3.5-8.5ZM3.9 9.5h16.2M3.9 14.5h16.2',
	rss: 'M4.5 11.5a8 8 0 0 1 8 8M4.5 4.5a15 15 0 0 1 15 15M5 18.1a0.9 0.9 0 1 0 0 1.8 0.9 0.9 0 0 0 0-1.8Z',
};

/** Filled brand icons: 16x16 viewBox. */
const BRAND_PATHS: Partial<Record<IconName, string>> = {
	github:
		'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z',
};

const { name, size = 18, class: className = '', title } = Astro.props;

const brandPath = BRAND_PATHS[name];
const strokePath = STROKE_PATHS[name];
---

{
	brandPath ? (
		<svg
			class:list={['icon', className]}
			width={size}
			height={size}
			viewBox="0 0 16 16"
			fill="currentColor"
			aria-hidden={title ? undefined : 'true'}
			role={title ? 'img' : undefined}
		>
			{title && <title>{title}</title>}
			<path d={brandPath} />
		</svg>
	) : (
		<svg
			class:list={['icon', className]}
			width={size}
			height={size}
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden={title ? undefined : 'true'}
			role={title ? 'img' : undefined}
		>
			{title && <title>{title}</title>}
			<path d={strokePath} />
		</svg>
	)
}

<style>
	.icon {
		flex: none;
	}
</style>
