/**
 * Filled brand icons.
 *
 * Each entry carries its OWN viewBox because brand marks do not share a grid:
 * the GitHub mark below is a 16x16 path, while Reddit/Steam/Twitch/Discord are
 * canonical 24x24 Simple Icons glyphs (CC0). Forcing all of them onto one viewBox
 * is what made the old icons render as featureless discs — 24x24 artwork squeezed
 * into a 16-unit box loses exactly the detail that makes a logo recognisable, and
 * Twitch, which had no path at all, rendered as an empty <svg>.
 */
const BRAND_PATHS: Partial<Record<IconName, { d: string; viewBox: string }>> = {
	github: {
		viewBox: '0 0 16 16',
		d:
			'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z',
