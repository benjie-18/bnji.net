	reddit: {
		viewBox: '0 0 24 24',
		d:
			'M12 0C5.373 0 0 5.372 0 12s5.373 12 12 12 12-5.372 12-12S18.627 0 12 0zm4.388 3.199a1.999 1.999 0 1 1 0 3.998 1.999 1.999 0 0 1 0-3.998zm1.406 6.817c-.595 0-1.021.413-1.021.919 0 .472.391.889 1.01.89.618 0 1.029-.417 1.029-.92 0-.506-.417-.889-1.018-.889zM12 16.19c-2.654 0-5.078-1.234-5.078-2.752 0-.361.336-.654.713-.654.376 0 .686.293.686.654 0 1.198 1.962 2.28 4.679 2.28 2.713 0 4.679-1.082 4.679-2.28 0-.361.31-.654.687-.654.376 0 .712.293.712.654 0 1.518-2.423 2.752-5.078 2.752zm4.988-5.131c-.315 0-.57.262-.57.588 0 .325.255.588.57.588h1.321c.315 0 .57-.263.57-.588 0-.326-.255-.588-.57-.588zm-9.988 0c-.315 0-.57.262-.57.588 0 .325.255.588.57.588h1.321c.315 0 .57-.263.57-.588 0-.326-.255-.588-.57-.588z',
	},
	steam: {
		viewBox: '0 0 24 24',
		d:
			'M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.493 2.028-4.521 4.521-4.521 2.494 0 4.521 2.028 4.521 4.521s-2.027 4.521-4.521 4.521c-2.007 0-3.716-1.271-4.369-3.034l-2.867 4.142c.212.297.427.596.641.901l2.806 4.051c.003-.003.003-.005.006-.007l.015-.013c3.628-3.431 5.831-8.441 5.831-13.781C24.005 5.178 18.278 0 11.979 0zM7.546 13.528a1.453 1.453 0 1 1-2.906 0 1.453 1.453 0 0 1 2.906 0zm6.879 4.278a2.415 2.415 0 1 1-4.83 0 2.415 2.415 0 0 1 4.83 0zm3.302-3.488a.855.855 0 1 1-1.71 0 .855.855 0 0 1 1.71 0z',
	},
	twitch: {
		viewBox: '0 0 24 24',
		d:
			'M11.571 4.714h1.715v5.143h-1.715zm4.715 0H18v5.143h-1.714zM6 0 1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm15.428 11.143-3.428 3.429h-3.429l-3 3v-3H6.857V1.714h14.571z',
	},
	discord: {
		viewBox: '0 0 24 24',
		d:
			'M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z',
	},
};

const { name, size = 18, class: className = '', title } = Astro.props;

const brand = BRAND_PATHS[name];
const strokePath = STROKE_PATHS[name];
const brandViewBox = brand?.viewBox ?? '0 0 16 16';
const brandPath = brand?.d;

/*
 * A name present in IconName but absent from BOTH path maps renders an empty
 * <svg> — an invisible gap exactly where an icon should be. That is how Twitch
 * shipped broken, and it is invisible in a diff and in a type check. Warn at
 * build time and fall back to a neutral glyph, so the next name added without
 * artwork is loud instead of silent.
 */
if (!brandPath && !strokePath) {
	console.warn(`[bnji] Icon "${name}" has no path in BRAND_PATHS or STROKE_PATHS — falling back to "link".`);
}
---

{
	brandPath ? (
		<svg
			class:list={['icon', className]}
			width={size}
			height={size}
			viewBox={brandViewBox}
			fill="currentColor"
			aria-hidden={title ? undefined : 'true'}
			role={title ? 'img' : undefined}
		>
			{title && <title>{title}</title>}
			<path d={brandPath} />
		</svg>
	) : (
		<svg
			class:list={['icon', className]}
			width={size}
			height={size}
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden={title ? undefined : 'true'}
			role={title ? 'img' : undefined}
		>
			{title && <title>{title}</title>}
			{/* Fall back rather than emit d="" — an empty path is invisible. */}
			<path d={strokePath ?? STROKE_PATHS.link} />
		</svg>
	)
}

<style>
	.icon {
		flex: none;
	}
</style>
