---
/**
 * MusicPlayer — the small, unobtrusive music control (bottom right).
 *
 * Configurable layout:
 * - Open: (d s no music... ♫)
 * - Closed: (♫) — a small circular glass badge
 * Clicking ♫ toggles between open and closed.
 *
 * States ([data-state], driven by scripts/music.ts): idle, loading, playing,
 * paused, blocked, error, disabled.
 */
import { MUSIC_SOURCE } from '../config/music.config';

interface Props {
	isBoard?: boolean;
}

const { isBoard = false } = Astro.props;
const providerLabel =
	MUSIC_SOURCE.provider === 'none' ? 'not configured' : MUSIC_SOURCE.provider;
---

<div
	class="music-player"
	data-glass="raised"
	data-music-player
	data-provider={MUSIC_SOURCE.provider}
	data-state="idle"
	data-collapsed={isBoard ? 'true' : 'false'}
	data-on-board={isBoard ? 'true' : 'false'}
	role="group"
	aria-label={`Background music (${providerLabel})`}
>
	<div class="music-player__controls" data-music-controls>
		<button class="music-player__btn" type="button" data-music-play aria-label="Play music">
			<svg class="music-player__icon music-player__icon--play" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M8.5 5.8v12.4L19 12 8.5 5.8Z" fill="currentColor" />
			</svg>
			<svg class="music-player__icon music-player__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M8 5.5h3v13H8zM13 5.5h3v13h-3z" fill="currentColor" />
			</svg>
			<span class="music-player__spinner" aria-hidden="true"></span>
		</button>

		<button
			class="music-player__btn"
			type="button"
			data-music-mute
			aria-pressed="false"
			aria-label="Mute music"
		>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M4 9.5v5h3.4L12 18.6V5.4L7.4 9.5H4Z" fill="currentColor" />
				<path class="music-player__wave" d="M15 9.2a4 4 0 0 1 0 5.6M17.4 7a7 7 0 0 1 0 10" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
				<path class="music-player__cross" d="M15 9.5l5 5M20 9.5l-5 5" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" />
			</svg>
		</button>

		<p class="music-player__status mono" data-music-status aria-live="polite">Music off</p>
	</div>

	<button
		class="music-player__btn music-player__toggle"
		type="button"
		data-music-toggle
		aria-label={isBoard ? 'Expand music player' : 'Collapse music player'}
		aria-expanded={isBoard ? 'false' : 'true'}
		title="Toggle music player"
	>
		<svg class="music-player__note-icon" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6Z" fill="currentColor" />
		</svg>
		<span class="music-player__dot-badge" aria-hidden="true"></span>
	</button>

	<!-- Provider embed host: hidden for youtube (API-driven, pill is the UI),
	     visible above the pill for spotify (the embed is the UI), unused for
	     file/none. -->
	<div class="music-player__embed" data-music-embed aria-hidden="true"></div>
</div>

<style>
	.music-player {
		position: fixed;
		right: var(--gutter);
		bottom: var(--gutter);
		z-index: var(--z-player);
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.3rem 0.35rem 0.3rem 0.55rem;
		border-radius: var(--radius-pill);
		transition: all var(--dur-base) var(--ease-spring);
		user-select: none;
	}

	.music-player__controls {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	/* --- Collapsed mode: (♫) small circle --- */
	.music-player[data-collapsed='true'] {
		padding: 0;
		gap: 0;
		inline-size: 38px;
		block-size: 38px;
		border-radius: 50%;
		justify-content: center;
		cursor: pointer;
	}

	.music-player[data-collapsed='true'] .music-player__controls {
		display: none;
	}

	.music-player[data-collapsed='true'] .music-player__toggle {
		inline-size: 100%;
		block-size: 100%;
		border: none;
		background: transparent;
	}

	/* --- buttons --- */
	.music-player__btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 28px;
		block-size: 28px;
		flex: none;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-bg-quiet);
		color: var(--text-muted);
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-spring);
	}
	.music-player__btn:hover:not(:disabled) {
		color: var(--text-strong);
		background: var(--glass-bg);
		transform: scale(1.05);
	}
	.music-player__btn:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 2px;
	}
	.music-player__btn:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	.music-player__btn svg {
		inline-size: 13px;
		block-size: 13px;
	}

	/* Toggle ♫ Button */
	.music-player__toggle {
		color: var(--text-muted);
	}
	.music-player__note-icon {
		inline-size: 14px;
		block-size: 14px;
		fill: currentColor;
		transition: transform var(--dur-fast) var(--ease-spring), color var(--dur-fast) var(--ease-out);
	}

	/* Dot badge on the ♫ toggle button */
	.music-player__dot-badge {
		position: absolute;
		top: 3px;
		right: 3px;
		inline-size: 5px;
		block-size: 5px;
		border-radius: 50%;
		background: var(--text-dim);
		pointer-events: none;
		transition: background-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
	}
	.music-player[data-state='playing'] .music-player__dot-badge {
		background: var(--accent);
		box-shadow: 0 0 6px var(--accent);
		animation: music-dot-pulse 2.6s var(--ease-soft) infinite;
	}
	.music-player[data-state='playing'] .music-player__note-icon {
		color: var(--accent-strong);
	}
	.music-player[data-state='loading'] .music-player__dot-badge {
		background: var(--accent);
		animation: music-dot-blink 0.9s linear infinite;
	}
	.music-player[data-state='blocked'] .music-player__dot-badge,
	.music-player[data-state='error'] .music-player__dot-badge {
		background: var(--signal-soon);
	}
	.music-player[data-state='disabled'] .music-player__dot-badge {
		opacity: 0.4;
	}

	@keyframes music-dot-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(122, 196, 255, 0.45);
		}
		50% {
			box-shadow: 0 0 0 4px rgba(122, 196, 255, 0);
		}
	}
	@keyframes music-dot-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.3;
		}
	}

	/* Icon + spinner state machine */
	.music-player__icon--pause,
	.music-player__spinner {
		display: none;
	}
	.music-player[data-state='playing'] .music-player__icon--play {
		display: none;
	}
	.music-player[data-state='playing'] .music-player__icon--pause {
		display: block;
	}
	.music-player[data-state='loading'] .music-player__icon--play,
	.music-player[data-state='loading'] .music-player__icon--pause {
		display: none;
	}
	.music-player[data-state='loading'] .music-player__spinner {
		display: block;
		inline-size: 13px;
		block-size: 13px;
		border-radius: 50%;
		border: 2px solid var(--glass-border-strong);
		border-top-color: var(--accent);
		animation: music-spin 0.9s linear infinite;
	}
	@keyframes music-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Blocked ring */
	.music-player[data-state='blocked'] .music-player__btn[data-music-play] {
		color: var(--text-strong);
		border-color: var(--accent-strong);
		animation: music-blocked-ring 1.8s var(--ease-soft) infinite;
	}
	@keyframes music-blocked-ring {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(122, 196, 255, 0.4);
		}
		55% {
			box-shadow: 0 0 0 6px rgba(122, 196, 255, 0);
		}
	}

	/* Mute cross */
	.music-player__cross {
		display: none;
	}
	.music-player__btn[aria-pressed='true'] .music-player__cross {
		display: block;
	}
	.music-player__btn[aria-pressed='true'] .music-player__wave {
		display: none;
	}

	/* Status line */
	.music-player__status {
		margin: 0;
		font-size: var(--text-micro);
		letter-spacing: var(--tracking-mono);
		text-transform: uppercase;
		color: var(--text-dim);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 10ch;
	}
	.music-player[data-state='playing'] .music-player__status {
		color: var(--text-muted);
	}
	.music-player[data-state='blocked'] .music-player__status {
		color: var(--accent-strong);
	}
	.music-player[data-state='error'] .music-player__status {
		color: var(--signal-soon);
	}
	.music-player[data-state='disabled'] {
		opacity: 0.72;
	}
	.music-player[data-state='error'] .music-player__btn[data-music-play] {
		color: var(--signal-soon);
		border-color: var(--signal-soon);
	}

	/* Provider embed host */
	.music-player__embed {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
	}

	.music-player[data-provider='spotify'] .music-player__embed:not(:empty) {
		position: fixed;
		right: var(--gutter);
		bottom: calc(var(--gutter) + 44px);
		inset: auto;
		inline-size: min(320px, calc(100vw - 2 * var(--gutter)));
		overflow: visible;
		pointer-events: auto;
		opacity: 1;
		border-radius: var(--radius-md);
		box-shadow: var(--glass-shadow-raised);
	}

	/* Placement rules: On the board page at <= 980px or on mobile <= 720px,
	   mount underneath the top nav dock so it NEVER collides with the composer */
	@media (max-width: 980px) {
		.music-player[data-on-board='true'],
		:global(body:has(.board)) .music-player {
			top: calc(var(--nav-offset) + var(--nav-height) + 8px);
			bottom: auto;
		}
		.music-player[data-on-board='true'][data-provider='spotify'] .music-player__embed:not(:empty),
		:global(body:has(.board)) .music-player[data-provider='spotify'] .music-player__embed:not(:empty) {
			top: calc(var(--nav-offset) + var(--nav-height) + 52px);
			bottom: auto;
		}
	}

	@media (max-width: 720px) {
		.music-player {
			top: calc(var(--nav-offset) + var(--nav-height) + 8px);
			bottom: auto;
		}
		.music-player[data-provider='spotify'] .music-player__embed:not(:empty) {
			top: calc(var(--nav-offset) + var(--nav-height) + 52px);
			bottom: auto;
		}
	}

	@media (max-width: 560px) {
		.music-player__status {
			max-width: 7ch;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.music-player__dot-badge,
		.music-player[data-state='blocked'] .music-player__btn[data-music-play],
		.music-player[data-state='loading'] .music-player__spinner {
			animation: none;
		}
	}
</style>
