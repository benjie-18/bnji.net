---
/**
 * MusicPlayer — floating background-music control (bottom right).
 *
 * Source configuration lives in src/config/music.config.ts (one place, all
 * providers). This component never hard-codes a source. It renders a compact
 * glass pill: play/pause, mute, volume and a live status line, with loading,
 * error and disabled states driven by [data-state] from scripts/music.ts.
 *
 * Autoplay: impossible by construction — every start path is a click handler,
 * and no media or player script is fetched before the first gesture.
 *
 * Placement: fixed bottom-right so it never collides with the message-board
 * composer (bottom centre) or the nav (top centre). Collapses to an icon-only
 * pill on narrow screens.
 */
import { MUSIC_SOURCE } from '../config/music.config';

const providerLabel =
	MUSIC_SOURCE.provider === 'none' ? 'not configured' : MUSIC_SOURCE.provider;
---

<div
	class="music-player"
	data-glass="raised"
	data-music-player
	data-state="idle"
	role="group"
	aria-label="Background music"
>
	<button class="music-player__btn" type="button" data-music-play aria-label="Play music">
		<svg class="music-player__icon music-player__icon--play" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M8.5 5.8v12.4L19 12 8.5 5.8Z" fill="currentColor" />
		</svg>
		<svg class="music-player__icon music-player__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M8 5.5h3v13H8zM13 5.5h3v13h-3z" fill="currentColor" />
		</svg>
		<span class="music-player__spinner" aria-hidden="true"></span>
	</button>

	<button
		class="music-player__btn"
		type="button"
		data-music-mute
		aria-pressed="false"
		aria-label="Mute music"
	>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M4 9.5v5h3.4L12 18.6V5.4L7.4 9.5H4Z" fill="currentColor" />
			<path class="music-player__wave" d="M15 9.2a4 4 0 0 1 0 5.6M17.4 7a7 7 0 0 1 0 10" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" />
			<path class="music-player__cross" d="M15 9.5l5 5M20 9.5l-5 5" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round" />
		</svg>
	</button>

	<label class="music-player__volume">
		<span class="sr-only">Music volume</span>
		<input
			type="range"
			min="0"
			max="100"
			step="5"
			value={String(Math.round(MUSIC_SOURCE.defaultVolume * 100))}
			data-music-volume
		/>
	</label>

	<p class="music-player__status mono" data-music-status aria-live="polite">Music off</p>
	<span class="music-player__provider mono" title={`Provider: ${providerLabel}`}>{providerLabel}</span>

	<!-- Hidden host for provider embeds (YouTube iframe / Spotify iframe). -->
	<div class="music-player__embed" data-music-embed aria-hidden="true"></div>
</div>

<style>
	.music-player {
		position: fixed;
		right: var(--gutter);
		bottom: var(--gutter);
		z-index: var(--z-player);
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.45rem 0.85rem 0.45rem 0.45rem;
		border-radius: var(--radius-pill);
		max-width: min(92vw, 380px);
	}

	.music-player__btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 34px;
		block-size: 34px;
		flex: none;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-bg-quiet);
		color: var(--text-muted);
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
	}
	.music-player__btn:hover:not(:disabled) {
		color: var(--text-strong);
		background: var(--glass-bg);
	}
	.music-player__btn:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 2px;
	}
	.music-player__btn:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	.music-player__icon {
		inline-size: 16px;
		block-size: 16px;
	}

	/* Icon + spinner state machine, pure CSS against [data-state]. */
	.music-player__icon--pause,
	.music-player__spinner {
		display: none;
	}
	.music-player[data-state='playing'] .music-player__icon--play {
		display: none;
	}
	.music-player[data-state='playing'] .music-player__icon--pause {
		display: block;
	}
	.music-player[data-state='loading'] .music-player__icon--play,
	.music-player[data-state='loading'] .music-player__icon--pause {
		display: none;
	}
	.music-player[data-state='loading'] .music-player__spinner {
		display: block;
		inline-size: 16px;
		block-size: 16px;
		border-radius: 50%;
		border: 2px solid var(--glass-border-strong);
		border-top-color: var(--accent);
		animation: music-spin 0.9s linear infinite;
	}
	@keyframes music-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Mute cross only when pressed. */
	.music-player__cross {
		display: none;
	}
	.music-player__btn[aria-pressed='true'] .music-player__cross {
		display: block;
	}
	.music-player__btn[aria-pressed='true'] .music-player__wave {
		display: none;
	}

	.music-player__volume {
		display: inline-flex;
		align-items: center;
		inline-size: 76px;
		flex: none;
	}
	.music-player__volume input {
		inline-size: 100%;
		accent-color: var(--accent);
		cursor: pointer;
	}
	.music-player__volume input:disabled {
		cursor: not-allowed;
		opacity: 0.5;
	}

	.music-player__status {
		margin: 0;
		font-size: var(--text-micro);
		letter-spacing: var(--tracking-mono);
		text-transform: uppercase;
		color: var(--text-dim);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 12ch;
	}
	.music-player[data-state='error'] .music-player__status {
		color: var(--signal-soon);
	}
	.music-player__provider {
		display: none;
	}

	.music-player__embed {
		position: absolute;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
	}

	/* Error / disabled read clearly at a glance. */
	.music-player[data-state='disabled'] {
		opacity: 0.72;
	}
	.music-player[data-state='error'] .music-player__btn[data-music-play] {
		color: var(--signal-soon);
		border-color: var(--signal-soon);
	}

	/* On phones the message-board composer owns the bottom edge: the pill
	   moves under the nav instead of competing for the corner. */
	@media (max-width: 720px) {
		.music-player {
			top: calc(var(--nav-offset) + var(--nav-height) + 8px);
			bottom: auto;
		}
	}

	@media (max-width: 560px) {
		.music-player__volume {
			display: none;
		}
		.music-player__status {
			max-width: 8ch;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.music-player[data-state='loading'] .music-player__spinner {
			animation-duration: 2s;
		}
	}
</style>
