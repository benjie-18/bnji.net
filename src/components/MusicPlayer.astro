---
/**
 * MusicPlayer — compact background-music controls and an ordered queue.
 *
 * The pill owns play/pause, next, and playlist controls; its label follows the
 * selected song rather than the playback state. Optional metadata is rendered
 * only when supplied. The queue shows track details and supported progress.
 * Volume and mute remain in the shared Settings overlay.
 *
 * THE MARKUP IS THE FALLBACK, NOT THE QUEUE. This component is prerendered, so
 * it renders `MUSIC_SOURCE.tracks` — the seed playlist and the offline
 * fallback. scripts/music.ts then fetches /api/playlist and rebuilds the queue
 * from the playlist stored in D1 before playback starts, so an operator's edits
 * appear without a deploy. Both paths build their markup through the same
 * helpers (`musicTrackAriaLabel`, `getMusicTrackDateLabel`) so the rendered and
 * runtime queues cannot drift, and an empty saved playlist stays empty rather
 * than falling back to this array.
 *
 * TWO PROVIDERS, BOTH WITH A TRANSPORT. `file` is the built-in <audio> element
 * and `youtube` is the IFrame API; both report progress and end events, so the
 * pill never has to pretend a control works when it does not. YouTube is the
 * only provider /admin can add — there is no upload, file picker or tag parsing
 * anywhere in this component.
 */
import Icon from './Icon.astro';
import {
	getMusicTrackDateLabel,
	getMusicTrackMetadata,
	musicTrackAriaLabel,
	MUSIC_SOURCE,
} from '../config/music.config';

interface Props {
	isBoard?: boolean;
}

const { isBoard = false } = Astro.props;
const tracks = MUSIC_SOURCE.tracks;
const firstTrack = tracks[0];
const firstTrackFields = getMusicTrackMetadata(firstTrack);
// One definition of the date line, shared with the runtime rebuild in
// scripts/music.ts: a YouTube upload date reads "Published …", which is the
// only date this playlist carries.
const firstTrackDate = getMusicTrackDateLabel(firstTrack);
const firstTrackMetadata = [firstTrackFields.artist, firstTrackFields.album, firstTrackDate].filter(Boolean);
const trackCount = tracks.length;
// Precomputed so the queue markup below stays a plain expression: the date
// label needs the same helper the pill and the runtime rebuild use.
const queue = tracks.map((track, index) => ({
	track,
	index,
	dateLabel: getMusicTrackDateLabel(track),
}));
---

<div
	class="music-player"
	data-glass="raised"
	data-music-player
	data-provider={firstTrack?.provider ?? 'none'}
	data-track-count={trackCount}
	data-state={trackCount > 0 ? 'idle' : 'disabled'}
	data-collapsed={isBoard ? 'true' : 'false'}
	data-playlist-open="false"
	data-on-board={isBoard ? 'true' : 'false'}
	role="group"
	aria-label="Background music player"
>
	<div class="music-player__controls" data-music-controls>
		<button class="music-player__btn" type="button" data-music-play aria-label="Play music" disabled={trackCount === 0}>
			<svg class="music-player__icon music-player__icon--play" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M8.5 5.8v12.4L19 12 8.5 5.8Z" fill="currentColor" />
			</svg>
			<svg class="music-player__icon music-player__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M8 5.5h3v13H8zM13 5.5h3v13h-3z" fill="currentColor" />
			</svg>
			<span class="music-player__spinner" aria-hidden="true"></span>
		</button>

		<button
			class="music-player__btn"
			type="button"
			data-music-next
			aria-label="Skip to next song"
			title="Skip to next song"
			disabled={trackCount < 2}
		>
			<Icon name="skip-forward" size={14} />
		</button>

		<button
			class="music-player__btn music-player__playlist-toggle"
			type="button"
			data-music-playlist-toggle
			aria-label="Open music playlist"
			aria-haspopup="dialog"
			aria-expanded="false"
			aria-controls="music-playlist"
			title="Open music playlist"
		>
			<Icon name="list" size={14} />
		</button>

		<p class="music-player__status" data-music-status>
			<span class="music-player__status-title" data-music-status-title>
				{firstTrack?.title ?? 'No songs configured'}
			</span>
			<span class="music-player__status-meta" data-music-status-meta hidden={!firstTrackMetadata.length}>
				{firstTrackMetadata.join(' · ')}
			</span>
			<span class="sr-only" data-music-state-announcement role="status" aria-live="polite" aria-atomic="true">
				{trackCount > 0 ? 'Music off' : 'No music'}
			</span>
		</p>
	</div>

	<button
		class="music-player__btn music-player__toggle"
		type="button"
		data-music-toggle
		aria-label={isBoard ? 'Expand music player' : 'Collapse music player'}
		aria-expanded={isBoard ? 'false' : 'true'}
		title="Toggle music player"
	>
		<svg class="music-player__note-icon" viewBox="0 0 24 24" aria-hidden="true">
			<path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6Z" fill="currentColor" />
		</svg>
		<span class="music-player__dot-badge" aria-hidden="true"></span>
	</button>

	<section
		class="music-player__playlist"
		id="music-playlist"
		data-music-playlist
		role="dialog"
		aria-labelledby="music-playlist-title"
		hidden
	>
		<header class="music-player__playlist-header">
			<div>
				<p class="music-player__eyebrow mono">BACKGROUND AUDIO</p>
				<h2 id="music-playlist-title">Music playlist</h2>
			</div>
			<button class="music-player__btn music-player__playlist-close" type="button" data-music-playlist-close aria-label="Close music playlist" title="Close playlist">
				<span aria-hidden="true">×</span>
			</button>
		</header>

		<section class="music-player__current" aria-label="Current song">
			<p class="music-player__eyebrow mono">NOW PLAYING</p>
			<h3 data-music-current-title>{firstTrack?.title ?? 'No songs configured'}</h3>
			<p class="music-player__metadata" data-music-current-artist hidden={!firstTrackFields.artist}>
				{firstTrackFields.artist}
			</p>
			<p class="music-player__metadata music-player__metadata--album" data-music-current-album hidden={!firstTrackFields.album}>
				{firstTrackFields.album}
			</p>
			<p class="music-player__metadata music-player__metadata--date" data-music-current-date hidden={!firstTrackDate}>
				{firstTrackDate}
			</p>

			<div class="music-player__progress-region" data-music-progress-region>
				<div
					class="music-player__progress"
					data-music-progress
					role="progressbar"
					aria-label="Song progress"
					aria-valuemin="0"
					aria-valuemax="100"
					aria-valuenow="0"
					aria-valuetext="0:00 of 0:00"
				>
					<span data-music-progress-fill></span>
				</div>
				<p class="music-player__time mono" aria-hidden="true">
					<span data-music-elapsed>0:00</span>
					<span data-music-duration>0:00</span>
				</p>
			</div>
			<p class="music-player__progress-note" data-music-progress-note hidden></p>
		</section>

		<div class="music-player__queue-heading">
			<h3>Songs</h3>
			<span class="mono" data-music-queue-count>{trackCount}</span>
		</div>
		{trackCount > 0 ? (
			<ol class="music-player__track-list" data-music-track-list>
				{queue.map(({ track, index, dateLabel }) => (
					<li>
						<button
							class="music-player__track"
							type="button"
							data-music-track-index={index}
							data-provider={track.provider}
							aria-pressed={index === 0 ? 'true' : 'false'}
							aria-label={musicTrackAriaLabel(track)}
						>
							<span class="music-player__track-number mono" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
							<span class="music-player__track-copy">
								<span class="music-player__track-title">{track.title}</span>
								{track.artist?.trim() && <span class="music-player__track-meta">{track.artist.trim()}</span>}
								{track.album?.trim() && <span class="music-player__track-meta music-player__track-meta--album">{track.album.trim()}</span>}
								{dateLabel && <span class="music-player__track-meta music-player__track-meta--date">{dateLabel}</span>}
							</span>
							<span class="music-player__provider mono">{track.provider}</span>
						</button>
					</li>
				))}
			</ol>
		) : (
			<p class="music-player__empty">No songs are configured. Add them from the admin playlist panel.</p>
		)}
	</section>

	<!-- Two embed hosts, kept separate on purpose.

	     The YouTube one holds the IFrame API player, which scripts/music.ts
	     creates and destroys. It is hidden because the pill is the control
	     surface, and a second visible YouTube player would be a duplicate set
	     of controls that disagrees with the queue.

	     The Spotify one holds the embed iframe. Unlike the YouTube player it
	     is VISIBLE, and deliberately so: Spotify's iFrame API is documented
	     for podcast controls and exposes no supported music-track progress or
	     end event, so the pill cannot drive it. Its own controls are the only
	     honest ones, and the progress note says as much. It stays in the DOM
	     empty and aria-hidden until a Spotify track is selected. -->
	<div class="music-player__youtube-host" data-music-youtube-host aria-hidden="true"></div>
	<div class="music-player__spotify-host" data-music-spotify-host aria-hidden="true"></div>
</div>

<style>
	.music-player {
		position: fixed;
		right: var(--gutter);
		bottom: var(--gutter);
		z-index: var(--z-player);
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) var(--space-2) var(--space-1) var(--space-3);
		border-radius: var(--radius-pill);
		/* Explicit property list, never `all`: border-radius must NOT animate.
		   Both states share --radius-pill; on a square badge that is already
		   circular, avoiding a one-frame square during the spring transition. */
		transition:
			padding var(--dur-base) var(--ease-spring),
			gap var(--dur-base) var(--ease-spring),
			inline-size var(--dur-base) var(--ease-spring),
			block-size var(--dur-base) var(--ease-spring),
			opacity var(--dur-fast) var(--ease-out);
		user-select: none;
	}

	.music-player[data-playlist-open='true'] {
		z-index: var(--z-modal);
	}

	.music-player__controls {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		min-inline-size: 0;
		transition: opacity var(--dur-fast) var(--ease-out);
	}

	/* --- Collapsed mode: small circular music badge --- */
	.music-player[data-collapsed='true'] {
		padding: 0;
		gap: 0;
		inline-size: var(--music-player-toggle-size);
		block-size: var(--music-player-toggle-size);
		border-radius: var(--radius-pill);
		justify-content: center;
		cursor: pointer;
	}

	.music-player[data-collapsed='true'] .music-player__controls {
		display: none;
	}

	.music-player[data-collapsed='true'] .music-player__toggle {
		inline-size: 100%;
		block-size: 100%;
		border: none;
		background: transparent;
	}

	/* --- buttons --- */
	.music-player__btn {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: var(--music-player-control-size);
		block-size: var(--music-player-control-size);
		flex: none;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-bg-quiet);
		color: var(--text-muted);
		cursor: pointer;
		transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-spring);
	}
	.music-player__btn:hover:not(:disabled) {
		color: var(--text-strong);
		background: var(--glass-bg);
		transform: scale(1.05);
	}
	.music-player__btn:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 2px;
	}
	.music-player__btn:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	.music-player__btn svg {
		inline-size: var(--music-player-icon-size);
		block-size: var(--music-player-icon-size);
	}

	.music-player__playlist-toggle[aria-expanded='true'] {
		color: var(--accent-strong);
		border-color: var(--accent-line);
		background: var(--accent-soft);
	}

	.music-player__toggle {
		color: var(--text-muted);
	}
	.music-player__note-icon {
		inline-size: var(--music-player-note-size);
		block-size: var(--music-player-note-size);
		fill: currentColor;
		transition: transform var(--dur-fast) var(--ease-spring), color var(--dur-fast) var(--ease-out);
	}

	/* Dot badge on the music-toggle button */
	.music-player__dot-badge {
		position: absolute;
		top: var(--space-1);
		right: var(--space-1);
		inline-size: 5px;
		block-size: 5px;
		border-radius: 50%;
		background: var(--text-dim);
		pointer-events: none;
		transition: background-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
	}
	.music-player[data-state='playing'] .music-player__dot-badge {
		background: var(--accent);
		box-shadow: 0 0 6px var(--accent);
		animation: music-dot-pulse 2.6s var(--ease-soft) infinite;
	}
	.music-player[data-state='playing'] .music-player__note-icon {
		color: var(--accent-strong);
	}
	.music-player[data-state='loading'] .music-player__dot-badge {
		background: var(--accent);
		animation: music-dot-blink 0.9s linear infinite;
	}
	.music-player[data-state='blocked'] .music-player__dot-badge,
	.music-player[data-state='error'] .music-player__dot-badge {
		background: var(--signal-soon);
	}
	.music-player[data-state='disabled'] .music-player__dot-badge {
		opacity: 0.4;
	}

	@keyframes music-dot-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(122, 196, 255, 0.45);
		}
		50% {
			box-shadow: 0 0 0 4px rgba(122, 196, 255, 0);
		}
	}
	@keyframes music-dot-blink {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.3;
		}
	}

	/* Icon + spinner state machine */
	.music-player__icon--pause,
	.music-player__spinner {
		display: none;
	}
	.music-player[data-state='playing'] .music-player__icon--play {
		display: none;
	}
	.music-player[data-state='playing'] .music-player__icon--pause {
		display: block;
	}
	.music-player[data-state='loading'] .music-player__icon--play,
	.music-player[data-state='loading'] .music-player__icon--pause {
		display: none;
	}
	.music-player[data-state='loading'] .music-player__spinner {
		display: block;
		inline-size: var(--music-player-icon-size);
		block-size: var(--music-player-icon-size);
		border-radius: 50%;
		border: 2px solid var(--glass-border-strong);
		border-top-color: var(--accent);
		animation: music-spin 0.9s linear infinite;
	}
	@keyframes music-spin {
		to {
			transform: rotate(360deg);
		}
	}

	/* Blocked ring */
	.music-player[data-state='blocked'] .music-player__btn[data-music-play] {
		color: var(--text-strong);
		border-color: var(--accent-strong);
		animation: music-blocked-ring 1.8s var(--ease-soft) infinite;
	}
	@keyframes music-blocked-ring {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(122, 196, 255, 0.4);
		}
		55% {
			box-shadow: 0 0 0 6px rgba(122, 196, 255, 0);
		}
	}

	/* Current-song label. Playback state remains available to assistive tech,
	   while the visible pill always identifies the selected song. */
	.music-player__status {
		display: grid;
		flex: 0 1 auto;
		gap: var(--space-1);
		min-inline-size: 0;
		max-inline-size: var(--music-player-status-max-width);
		margin: 0;
		color: var(--text-muted);
	}
	.music-player__status-title,
	.music-player__status-meta {
		display: block;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.music-player__status-title {
		color: var(--text-strong);
		font-family: var(--font-body);
		font-size: var(--text-small);
		font-weight: 600;
		line-height: var(--leading-tight);
	}
	.music-player__status-meta {
		color: var(--text-muted);
		font-size: var(--text-micro);
		line-height: var(--leading-snug);
	}
	.music-player__status-meta[hidden] {
		display: none;
	}
	.music-player[data-state='blocked'] .music-player__status-title {
		color: var(--accent-strong);
	}
	.music-player[data-state='error'] .music-player__status-title {
		color: var(--signal-soon);
	}
	.music-player[data-state='error'] .music-player__btn[data-music-play] {
		color: var(--signal-soon);
		border-color: var(--signal-soon);
	}

	/* Playlist popover */
	.music-player__playlist[hidden] {
		display: none;
	}
	.music-player__playlist {
		position: absolute;
		right: 0;
		bottom: calc(100% + var(--space-3));
		z-index: var(--z-player-popover);
		display: grid;
		gap: var(--space-4);
		inline-size: min(var(--music-playlist-width), calc(100vw - 2 * var(--gutter)));
		max-block-size: min(var(--music-playlist-max-block), calc(100dvh - var(--nav-height) - 2 * var(--gutter)));
		padding: var(--space-4);
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-lg);
		background: var(--glass-bg-fallback);
		color: var(--text);
		box-shadow: var(--glass-shadow-raised);
		backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
	}

	.music-player__playlist-header,
	.music-player__queue-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
	}
	.music-player__playlist-header h2,
	.music-player__queue-heading h3,
	.music-player__current h3 {
		margin: 0;
		color: var(--text-strong);
	}
	.music-player__playlist-header h2 {
		font-size: var(--text-lead);
		letter-spacing: var(--tracking-snug);
	}
	.music-player__eyebrow {
		margin: 0 0 var(--space-1);
		color: var(--text-dim);
		font-size: var(--text-micro);
		letter-spacing: var(--tracking-mono);
		text-transform: uppercase;
	}
	.music-player__playlist-close {
		font-size: var(--text-lead);
		line-height: 1;
	}

	.music-player__current {
		display: grid;
		gap: var(--space-2);
		min-inline-size: 0;
		padding: var(--space-3);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		background: var(--glass-bg-clear);
	}
	.music-player__current h3 {
		overflow: hidden;
		font-size: var(--text-body);
		font-weight: 650;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.music-player__metadata {
		margin: calc(-1 * var(--space-1)) 0 0;
		color: var(--text-muted);
		font-size: var(--text-small);
		line-height: var(--leading-snug);
	}
	.music-player__metadata[hidden],
	.music-player__progress-region[hidden],
	.music-player__progress-note[hidden] {
		display: none;
	}
	.music-player__metadata--album,
	.music-player__metadata--date {
		color: var(--text-dim);
		font-size: var(--text-micro);
	}

	.music-player__progress-region {
		display: grid;
		gap: var(--space-1);
		margin-block-start: var(--space-1);
	}
	.music-player__progress {
		block-size: var(--music-progress-height);
		overflow: hidden;
		border-radius: var(--radius-pill);
		background: var(--glass-border-strong);
	}
	.music-player__progress > span {
		display: block;
		inline-size: 100%;
		block-size: 100%;
		border-radius: inherit;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left center;
		transition: transform var(--dur-fast) linear;
	}
	.music-player__time {
		display: flex;
		justify-content: space-between;
		margin: 0;
		color: var(--text-dim);
		font-size: var(--text-micro);
		letter-spacing: var(--tracking-mono);
	}
	.music-player__progress-note,
	.music-player__empty {
		margin: 0;
		color: var(--text-muted);
		font-size: var(--text-small);
		line-height: var(--leading-snug);
	}
	.music-player__queue-heading h3 {
		font-size: var(--text-small);
	}
	.music-player__queue-heading > span {
		color: var(--text-dim);
		font-size: var(--text-micro);
	}

	.music-player__track-list {
		display: grid;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.music-player__track-list li {
		min-inline-size: 0;
	}
	.music-player__track {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-3);
		inline-size: 100%;
		padding: var(--space-3);
		border: 1px solid transparent;
		border-radius: var(--radius-md);
		background: transparent;
		color: var(--text);
		text-align: left;
		cursor: pointer;
		transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.music-player__track:hover {
		border-color: var(--glass-border);
		background: var(--glass-bg-quiet);
	}
	.music-player__track:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 2px;
	}
	.music-player__track[aria-pressed='true'] {
		border-color: var(--accent-line);
		background: var(--accent-soft);
	}
	.music-player__track-number {
		color: var(--text-dim);
