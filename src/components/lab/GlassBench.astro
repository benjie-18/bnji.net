---
/**
 * Lab experiment — Apple Liquid Glass 2027 Optical Laboratory & Calibration Bench.
 *
 * Implements a high-fidelity web recreation of Apple's Liquid Glass material
 * targeting the 2027-era iOS/iPadOS/macOS visual language.
 *
 * AUTHORITATIVE RESEARCH & EVIDENCE LABELING:
 * - Apple-Documented Properties (HIG & WWDC25/26):
 *   Functional layer above content, lensing/refraction as primary property,
 *   adaptive luminance & environment color collection, Regular vs. Clear variants
 *   (Clear employs 35% dimming layer on bright backgrounds), concentric geometry,
 *   interactive flex & energizing, 2027 dark edge structure & sharper specular.
 * - Reverse-Engineered Calibrations (Community Research):
 *   Refractive index n ≈ 1.5168, 4th-power squircle SDF profile,
 *   empirical luminance fit: glass_L = 0.58 * backdrop_L + 34.
 */
---

<div class="bench" data-lab-experiment="glass-bench">
	<!-- Isolated Calibration Stage -->
	<div class="lab-stage bench-stage" data-bench-stage>
		<!-- Switchable Calibration Backdrops -->
		<div class="bench-backdrop" data-bench-backdrop="checkerboard">
			<!-- Lines: parallel ruled lines testing geometric deflection -->
			<div class="bench-bg-layer bench-bg--lines" aria-hidden="true"></div>
			<!-- Checkerboard: high-frequency grid testing squircle bezel distortion -->
			<div class="bench-bg-layer bench-bg--checkerboard" aria-hidden="true"></div>
			<!-- Gradients: multi-stop spectral gradient testing chromatic response -->
			<div class="bench-bg-layer bench-bg--gradients" aria-hidden="true">
				<span class="bench-bg__blob bench-bg__blob--1"></span>
				<span class="bench-bg__blob bench-bg__blob--2"></span>
				<span class="bench-bg__blob bench-bg__blob--3"></span>
			</div>
			<!-- Photo: realistic scenic photograph testing transmission diffusion -->
			<div class="bench-bg-layer bench-bg--photo" aria-hidden="true"></div>
			<!-- Text: typography chart testing central legibility preservation -->
			<div class="bench-bg-layer bench-bg--text" aria-hidden="true">
				<div class="bench-text-chart mono">
					<p class="chart-line-1">APPLE LIQUID GLASS 2027 OPTICAL TEST CHART</p>
					<p class="chart-line-2">ABCDEFGHIJKL MNOPQRSTUVWXYZ 0123456789</p>
					<p class="chart-line-3">Snell's Law: n1·sin(θ1) = n2·sin(θ2) · n ≈ 1.5168 · Bezel lensing</p>
					<p class="chart-line-4">Flat interior center has zero displacement for 100% crisp legibility</p>
					<p class="chart-line-5">Concentric curvature · 4th-power squircle SDF · Grazing Fresnel rim</p>
					<p class="chart-line-6">2027 dark edge structure provides punchy separation from background</p>
					<p class="chart-line-7">Clear variant applies 35% dimming layer on high-luminance fields</p>
				</div>
			</div>
			<!-- Motion: animated dynamic canvas testing real-time refraction -->
			<canvas class="bench-bg-layer bench-bg--motion" data-bench-canvas aria-hidden="true"></canvas>
		</div>

		<!-- The Optical Glass Sample Surface -->
		<div
			class="bench-sample bench-sample--squircle"
			data-glass="interactive"
			data-bench-sample
			data-bench-shape="squircle"
			tabindex="0"
			role="region"
			aria-label="Liquid Glass optical test sample"
		>
			<!-- 1. Squircle View: standard card layout -->
			<div class="bench-shape-view bench-shape-view--squircle">
				<div class="bench-sample__header">
					<span class="bench-sample__tag mono" data-bench-mode-tag>Clear Variant</span>
					<span class="bench-sample__badge mono" data-bench-sdf-tag>n = 1.5168</span>
				</div>
				<p class="bench-sample__title">Lensing, not generic blur</p>
				<p class="bench-sample__body">
					Refraction bends light along the continuous convex bezel while the interior remains completely undistorted.
				</p>
				<div class="bench-sample__row" data-glass-group>
					<button class="glass-button glass-button--sm" type="button">Concentric child</button>
					<span class="chip chip--accent">Fresnel rim</span>
					<span class="chip">2027 dark edge</span>
				</div>
			</div>

			<!-- 2. Capsule View: floating status/media pill -->
			<div class="bench-shape-view bench-shape-view--capsule">
				<div class="bench-capsule-content">
					<span class="dot dot--live" aria-hidden="true"></span>
					<span class="bench-capsule-title mono">Optical Pill</span>
					<span class="bench-capsule-sep mono">&middot;</span>
					<span class="bench-capsule-meta mono" data-bench-capsule-n>n = 1.517</span>
					<button class="glass-button glass-button--sm" type="button">Concentric</button>
				</div>
			</div>

			<!-- 3. Circle View: optical iris lens orb -->
			<div class="bench-shape-view bench-shape-view--circle">
				<div class="bench-circle-content">
					<span class="bench-circle-symbol" aria-hidden="true">⟐</span>
					<span class="bench-circle-value mono" data-bench-circle-val>1.517</span>
					<span class="bench-circle-label mono">Snell Bezel</span>
				</div>
			</div>

			<!-- 4. Navbar View: floating glass navigation header -->
			<div class="bench-shape-view bench-shape-view--navbar">
				<div class="bench-navbar-content">
					<span class="bench-nav-brand mono">bnji.liquid</span>
					<div class="bench-nav-items">
						<span class="bench-nav-item is-active mono">Optics</span>
						<span class="bench-nav-item mono">Bezel</span>
						<span class="bench-nav-item mono">Fresnel</span>
					</div>
					<button class="glass-button glass-button--sm" type="button">Calibrate</button>
				</div>
			</div>

			<!-- 5. Panel View: deep multi-card console -->
			<div class="bench-shape-view bench-shape-view--panel">
				<div class="bench-panel-content">
					<div class="bench-panel-head">
						<div class="bench-panel-pips" aria-hidden="true"><span></span><span></span><span></span></div>
						<span class="bench-panel-title mono">Liquid Glass Laboratory Console</span>
						<span class="chip chip--accent">2027</span>
					</div>
					<div class="bench-panel-grid">
						<div class="bench-subcard" data-glass="quiet">
							<span class="mono text-muted">Luminance Equation</span>
							<strong>glass_L = 0.58 &middot; L_bg + 34</strong>
						</div>
						<div class="bench-subcard" data-glass="quiet">
							<span class="mono text-muted">Curvature Normal</span>
							<strong>4th-Power Squircle SDF</strong>
						</div>
					</div>
				</div>
			</div>
		</div>

		<p class="lab-hint mono">drag pointer over glass to observe specular travel & micro-flex</p>
	</div>

	<!-- Calibration Toolbars & Modifiers -->
	<div class="bench-controls-cluster">
		<!-- Toolbar 1: Test Backdrops & Geometry Shapes -->
		<div class="bench-toolbar">
			<div class="bench-toolbar__group">
				<span class="bench-toolbar__title mono">Backdrop:</span>
				<div class="bench-btn-group" role="radiogroup" aria-label="Calibration backdrop">
					<button class="bench-btn is-active" type="button" data-bench-set-bg="checkerboard">Checker</button>
					<button class="bench-btn" type="button" data-bench-set-bg="lines">Lines</button>
					<button class="bench-btn" type="button" data-bench-set-bg="gradients">Gradient</button>
					<button class="bench-btn" type="button" data-bench-set-bg="photo">Photo</button>
					<button class="bench-btn" type="button" data-bench-set-bg="text">Text</button>
					<button class="bench-btn" type="button" data-bench-set-bg="motion">Motion</button>
				</div>
			</div>

			<div class="bench-toolbar__group">
				<span class="bench-toolbar__title mono">Shape:</span>
				<div class="bench-btn-group" role="radiogroup" aria-label="Glass geometry shape">
					<button class="bench-btn is-active" type="button" data-bench-set-shape="squircle">Squircle</button>
					<button class="bench-btn" type="button" data-bench-set-shape="capsule">Capsule</button>
					<button class="bench-btn" type="button" data-bench-set-shape="circle">Circle</button>
					<button class="bench-btn" type="button" data-bench-set-shape="navbar">Navbar</button>
					<button class="bench-btn" type="button" data-bench-set-shape="panel">Panel</button>
				</div>
			</div>

			<div class="bench-toolbar__group">
				<span class="bench-toolbar__title mono">Variant:</span>
				<div class="bench-btn-group" role="radiogroup" aria-label="Material variant">
					<button class="bench-btn is-active" type="button" data-bench-set-variant="clear">Clear</button>
					<button class="bench-btn" type="button" data-bench-set-variant="regular">Regular</button>
				</div>
			</div>
		</div>

		<!-- Physical Parameters Sliders -->
		<div class="lab-controls">
			<label class="lab-control">
				<span class="lab-control__label">
					Refractive Index (n) <output data-bench-out="n">1.517</output>
				</span>
				<input class="lab-range" type="range" min="1.0" max="1.75" step="0.005" value="1.517" data-bench-in="n" />
			</label>

			<label class="lab-control">
				<span class="lab-control__label">
					Bezel Lensing Width <output data-bench-out="bezel">18px</output>
				</span>
				<input class="lab-range" type="range" min="4" max="36" step="1" value="18" data-bench-in="bezel" />
			</label>

			<label class="lab-control">
				<span class="lab-control__label">
					Diffusion Blur <output data-bench-out="blur">20px</output>
				</span>
				<input class="lab-range" type="range" min="0" max="48" step="1" value="20" data-bench-in="blur" />
			</label>

			<label class="lab-control">
				<span class="lab-control__label">
					Fresnel Rim Highlight <output data-bench-out="fresnel">0.75</output>
				</span>
				<input class="lab-range" type="range" min="0.1" max="1.0" step="0.02" value="0.75" data-bench-in="fresnel" />
			</label>

			<label class="lab-control">
				<span class="lab-control__label">
					Backdrop Luminance (L) <output data-bench-out="lum">50%</output>
				</span>
				<input class="lab-range" type="range" min="0" max="100" step="2" value="50" data-bench-in="lum" />
			</label>

			<label class="lab-control">
				<span class="lab-control__label">
					Dimming Layer (Clear) <output data-bench-out="dim">35%</output>
				</span>
				<input class="lab-range" type="range" min="0" max="70" step="5" value="35" data-bench-in="dim" />
			</label>
		</div>

		<!-- Optical Feature Switches -->
		<div class="bench-toggles">
			<label class="bench-toggle-label mono">
				<input type="checkbox" checked data-bench-toggle="darkEdge" />
				<span>2027 Dark Edge Definition</span>
			</label>
			<label class="bench-toggle-label mono">
				<input type="checkbox" checked data-bench-toggle="dispersion" />
				<span>Restrained Chromatic Dispersion (RGB)</span>
			</label>
			<label class="bench-toggle-label mono">
				<input type="checkbox" checked data-bench-toggle="concentric" />
				<span>Concentric Radius Architecture</span>
			</label>
		</div>

		<!-- Live Metrics Readout & Code -->
		<div class="bench-metrics-box mono">
			<div class="bench-metric">
				<span class="metric-name">Snell Max Deflection</span>
				<span class="metric-val" data-bench-metric="deflection">14.8 px</span>
			</div>
			<div class="bench-metric">
				<span class="metric-name">Calculated glass_L</span>
				<span class="metric-val" data-bench-metric="glassL">63.0%</span>
			</div>
			<div class="bench-metric">
				<span class="metric-name">Bezel Profile SDF</span>
				<span class="metric-val">z(u) = (1 - (1 - u)⁴)⁰·⁵</span>
			</div>
			<div class="bench-metric">
				<span class="metric-name">Fresnel Schlick R₀</span>
				<span class="metric-val">0.042 (grazing R = 0.88)</span>
			</div>
		</div>

		<div class="lab-code__title">
			<span class="mono">Apple Liquid Glass 2027 Optical Specification</span>
			<button class="lab-button" type="button" data-bench-copy>Copy</button>
		</div>
		<pre class="lab-code" data-bench-code></pre>

		<!-- Authoritative Research & Evidence Labeling Note -->
		<div class="bench-evidence-card">
			<h3 class="evidence-title mono">Authoritative Evidence & Calibration Model</h3>
			<ul class="evidence-list">
				<li>
					<strong>Apple HIG & WWDC Documentation:</strong> Liquid Glass is an active functional layer above content. Lensing/refraction is a primary optical property. Concentric child geometry, 35% dimming on bright fields, and 2027 dark edge structure with sharp specular highlights define the material system.
				</li>
				<li>
					<strong>Reverse-Engineered Measurements:</strong> Refractive index <code>n ≈ 1.5168</code>, 4th-power convex squircle SDF, and <code>glass_L = 0.58 * backdrop_L + 34</code> represent empirical calibrations from community research, not official Apple published constants.
				</li>
			</ul>
		</div>
	</div>
</div>

<script>
	import { generateRefractionMap, calculateAdaptiveLuminance } from '../../scripts/liquid-glass';

	const root = document.querySelector<HTMLElement>('[data-lab-experiment="glass-bench"]');
	const sample = root?.querySelector<HTMLElement>('[data-bench-sample]');
	const backdrop = root?.querySelector<HTMLElement>('[data-bench-backdrop]');
	const canvas = root?.querySelector<HTMLCanvasElement>('[data-bench-canvas]');
	const codeBlock = root?.querySelector<HTMLElement>('[data-bench-code]');
	const modeTag = root?.querySelector<HTMLElement>('[data-bench-mode-tag]');
	const sdfTag = root?.querySelector<HTMLElement>('[data-bench-sdf-tag]');

	if (root && sample && backdrop) {
		const state = {
			bg: 'checkerboard',
			shape: 'squircle',
			variant: 'clear',
			n: 1.517,
			bezel: 18,
			blur: 20,
			fresnel: 0.75,
			lum: 50,
			dim: 35,
			darkEdge: true,
			dispersion: true,
			concentric: true,
		};

		// Inputs & Outputs
		const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-bench-in]'));
		const outputs = new Map<string, HTMLOutputElement>();
		root.querySelectorAll<HTMLOutputElement>('[data-bench-out]').forEach((output) => {
			outputs.set(output.dataset.benchOut ?? '', output);
		});

		const metricDeflection = root.querySelector<HTMLElement>('[data-bench-metric="deflection"]');
		const metricGlassL = root.querySelector<HTMLElement>('[data-bench-metric="glassL"]');

		function apply() {
			// Update mode badges
			if (modeTag) modeTag.textContent = state.variant === 'clear' ? 'Clear Variant' : 'Regular Variant';
			if (sdfTag) sdfTag.textContent = `n = ${state.n.toFixed(3)}`;

			// Update adaptive luminance
			const { glassL, needsDimming } = calculateAdaptiveLuminance(state.lum);
			if (metricGlassL) metricGlassL.textContent = `${glassL.toFixed(1)}%`;

			const maxDeflection = (state.bezel * (1 - 1 / state.n) * 1.5).toFixed(1);
			if (metricDeflection) metricDeflection.textContent = `${maxDeflection} px`;

			// Sample shape classes & attributes
			sample?.classList.remove(
				'bench-sample--squircle',
				'bench-sample--capsule',
				'bench-sample--circle',
				'bench-sample--navbar',
				'bench-sample--panel',
			);
			sample?.classList.add(`bench-sample--${state.shape}`);
			sample?.setAttribute('data-bench-shape', state.shape);

			const capsuleN = root.querySelector<HTMLElement>('[data-bench-capsule-n]');
			if (capsuleN) capsuleN.textContent = `n = ${state.n.toFixed(3)}`;
			const circleVal = root.querySelector<HTMLElement>('[data-bench-circle-val]');
			if (circleVal) circleVal.textContent = state.n.toFixed(3);

			// Concentric geometry
			sample?.style.setProperty('--parent-radius', state.shape === 'capsule' || state.shape === 'navbar' ? '9999px' : state.shape === 'circle' ? '50%' : '24px');
			sample?.style.setProperty('--glass-edge-dark', state.darkEdge ? 'rgba(0, 0, 0, 0.45)' : 'rgba(255, 255, 255, 0.1)');

			// Material Variant calibration: Clear vs Regular
			const isClear = state.variant === 'clear';
			const isLight = document.documentElement.dataset.theme === 'light';
			sample?.setAttribute('data-glass', isClear ? 'interactive clear' : 'interactive regular');
			sample?.setAttribute('data-bench-variant', state.variant);
			sample?.classList.toggle('bench-sample--clear', isClear);
			sample?.classList.toggle('bench-sample--regular', !isClear);

			if (isClear) {
				// Clear variant: Crystal-clear ultra-translucent with high saturation & active dimming
				const dimFactor = state.dim / 100;
				if (isLight) {
					sample?.style.setProperty('--glass-sample-bg', `rgba(255, 255, 255, ${(0.3 + dimFactor * 0.18).toFixed(3)})`);
					sample?.style.setProperty('--glass-sample-border', 'rgba(30, 90, 160, 0.55)');
				} else {
					sample?.style.setProperty('--glass-sample-bg', `rgba(10, 24, 46, ${(0.12 + dimFactor * 0.28).toFixed(3)})`);
					sample?.style.setProperty('--glass-sample-border', 'rgba(255, 255, 255, 0.42)');
				}
				sample?.style.setProperty('--glass-blur', `${Math.max(6, Math.round(state.blur * 0.4))}px`);
				sample?.style.setProperty('--glass-saturate', '220%');
				sample?.style.setProperty('--glass-brightness', '1.08');
				sample?.style.setProperty('--glass-fresnel-top', `rgba(255, 255, 255, ${Math.min(1, state.fresnel * 1.3)})`);
			} else {
				// Regular variant: Denser calibrated milky diffusion layer
				if (isLight) {
					sample?.style.setProperty('--glass-sample-bg', 'rgba(255, 255, 255, 0.85)');
					sample?.style.setProperty('--glass-sample-border', 'rgba(30, 90, 160, 0.35)');
				} else {
					sample?.style.setProperty('--glass-sample-bg', 'rgba(18, 28, 48, 0.65)');
					sample?.style.setProperty('--glass-sample-border', 'rgba(255, 255, 255, 0.22)');
				}
				sample?.style.setProperty('--glass-blur', `${state.blur}px`);
				sample?.style.setProperty('--glass-saturate', '135%');
				sample?.style.setProperty('--glass-brightness', '1.0');
				sample?.style.setProperty('--glass-fresnel-top', `rgba(255, 255, 255, ${state.fresnel})`);
			}

			// Generate optical displacement map for the current geometry
			const rect = sample?.getBoundingClientRect() ?? { width: 320, height: 180 };
			const mapDataUrl = generateRefractionMap({
				width: Math.round(rect.width || 320),
				height: Math.round(rect.height || 180),
				radius: state.shape === 'capsule' ? 32 : state.shape === 'circle' ? 90 : 24,
				bezelWidth: state.bezel,
				refractiveIndex: state.n,
				dispersion: state.dispersion,
			});

			if (codeBlock) {
				codeBlock.textContent = [
					`/* Apple Liquid Glass 2027 Calibration */`,
					`--glass-refraction-index: ${state.n.toFixed(3)}; /* n ≈ 1.5168 */`,
					`--glass-bezel-lensing: ${state.bezel}px; /* 4th-power convex squircle */`,
					`--glass-diffusion-blur: ${state.blur}px;`,
					`--glass-fresnel-rim: ${state.fresnel.toFixed(2)}; /* Schlick grazing */`,
					`--glass-dark-edge: ${state.darkEdge ? 'active (2027 refinement)' : 'flat'};`,
					`--glass-adaptive-luminance: ${glassL.toFixed(1)}% (L_glass = 0.58 * L_bg + 34);`,
					`--glass-clear-dimming: ${needsDimming ? `${state.dim}% dimming active` : 'none'};`,
				].join('\n');
			}
		}

		// Input events
		inputs.forEach((input) => {
			const key = input.dataset.benchIn ?? '';
			input.addEventListener('input', () => {
				const val = parseFloat(input.value);
				(state as any)[key] = val;
				const output = outputs.get(key);
				if (output) {
					if (key === 'n') output.textContent = val.toFixed(3);
					else if (key === 'bezel' || key === 'blur') output.textContent = `${val}px`;
					else if (key === 'lum' || key === 'dim') output.textContent = `${val}%`;
					else output.textContent = val.toFixed(2);
				}
				apply();
			});
		});

		// Backdrop switcher buttons
		root.querySelectorAll<HTMLButtonElement>('[data-bench-set-bg]').forEach((btn) => {
			btn.addEventListener('click', () => {
				root.querySelectorAll('[data-bench-set-bg]').forEach((b) => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				const bg = btn.dataset.benchSetBg ?? 'checkerboard';
				state.bg = bg;
				backdrop.dataset.benchBackdrop = bg;
			});
		});

		// Shape switcher buttons
		root.querySelectorAll<HTMLButtonElement>('[data-bench-set-shape]').forEach((btn) => {
			btn.addEventListener('click', () => {
				root.querySelectorAll('[data-bench-set-shape]').forEach((b) => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				state.shape = btn.dataset.benchSetShape ?? 'squircle';
				apply();
			});
		});

		// Variant switcher buttons
		root.querySelectorAll<HTMLButtonElement>('[data-bench-set-variant]').forEach((btn) => {
			btn.addEventListener('click', () => {
				root.querySelectorAll('[data-bench-set-variant]').forEach((b) => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				state.variant = btn.dataset.benchSetVariant ?? 'clear';
				apply();
			});
		});

		// Toggles
		root.querySelectorAll<HTMLInputElement>('[data-bench-toggle]').forEach((toggle) => {
			toggle.addEventListener('change', () => {
				const key = toggle.dataset.benchToggle ?? '';
				(state as any)[key] = toggle.checked;
				apply();
			});
		});

		// Copy snippet
		root.querySelector('[data-bench-copy]')?.addEventListener('click', async (e) => {
			const btn = e.currentTarget as HTMLButtonElement;
			const orig = btn.textContent ?? 'Copy';
			try {
				await navigator.clipboard.writeText(codeBlock?.textContent ?? '');
				btn.textContent = 'Copied';
			} catch {
				btn.textContent = 'Select to copy';
			}
			setTimeout(() => {
				btn.textContent = orig;
			}, 1800);
		});

		// Motion Canvas animation loop for the "motion" calibration scene
		if (canvas) {
			const ctx = canvas.getContext('2d');
			let animFrame = 0;
			let angle = 0;

			function drawMotion() {
				if (!ctx || backdrop?.dataset.benchBackdrop !== 'motion') {
					animFrame = requestAnimationFrame(drawMotion);
					return;
				}
				const w = (canvas.width = canvas.clientWidth);
				const h = (canvas.height = canvas.clientHeight);

				ctx.fillStyle = '#060d1f';
				ctx.fillRect(0, 0, w, h);

				angle += 0.02;
				for (let i = 0; i < 6; i++) {
					const r = 40 + i * 25;
					const x = w / 2 + Math.cos(angle + i * 0.8) * (w * 0.28);
					const y = h / 2 + Math.sin(angle * 1.2 + i * 0.9) * (h * 0.25);

					const grad = ctx.createRadialGradient(x, y, 4, x, y, r);
					grad.addColorStop(0, `hsla(${(angle * 30 + i * 50) % 360}, 90%, 65%, 0.8)`);
					grad.addColorStop(1, 'transparent');

					ctx.fillStyle = grad;
					ctx.beginPath();
					ctx.arc(x, y, r, 0, Math.PI * 2);
					ctx.fill();
				}

				animFrame = requestAnimationFrame(drawMotion);
			}

			animFrame = requestAnimationFrame(drawMotion);
		}

		// Smooth Fluid Hover Travel & 3D Micro-Flex Physics
		const stage = root.querySelector<HTMLElement>('.bench-stage');
		let targetTiltX = 0;
		let targetTiltY = 0;
		let targetSpecX = 50;
		let targetSpecY = 35;
		let targetLiftZ = 0;

		let curTiltX = 0;
		let curTiltY = 0;
		let curSpecX = 50;
		let curSpecY = 35;
		let curLiftZ = 0;

		let hoverAnimId = 0;
		let isBenchActive = true;

		const updateHoverTravel = () => {
			if (!isBenchActive) return;
			const damping = 0.12;
			curTiltX += (targetTiltX - curTiltX) * damping;
			curTiltY += (targetTiltY - curTiltY) * damping;
			curSpecX += (targetSpecX - curSpecX) * damping;
			curSpecY += (targetSpecY - curSpecY) * damping;
			curLiftZ += (targetLiftZ - curLiftZ) * damping;

			if (sample) {
				sample.style.transform = `perspective(850px) rotateX(${curTiltX.toFixed(2)}deg) rotateY(${curTiltY.toFixed(2)}deg) translateZ(${curLiftZ.toFixed(1)}px)`;
				sample.style.setProperty('--mouse-x', `${curSpecX.toFixed(1)}%`);
				sample.style.setProperty('--mouse-y', `${curSpecY.toFixed(1)}%`);
				sample.style.setProperty('--glass-spec-x', `${curSpecX.toFixed(1)}%`);
				sample.style.setProperty('--glass-spec-y', `${curSpecY.toFixed(1)}%`);
			}

			hoverAnimId = requestAnimationFrame(updateHoverTravel);
		};

		hoverAnimId = requestAnimationFrame(updateHoverTravel);

		if (stage && sample) {
			stage.addEventListener('pointermove', (e) => {
				const rect = sample.getBoundingClientRect();
				const relX = (e.clientX - rect.left) / rect.width;
				const relY = (e.clientY - rect.top) / rect.height;

				const nx = Math.max(-0.25, Math.min(1.25, relX));
				const ny = Math.max(-0.25, Math.min(1.25, relY));

				targetTiltX = (0.5 - ny) * 14;
				targetTiltY = (nx - 0.5) * 14;
				targetSpecX = nx * 100;
				targetSpecY = ny * 100;
				targetLiftZ = 12;
			});

			stage.addEventListener('pointerleave', () => {
				targetTiltX = 0;
				targetTiltY = 0;
				targetSpecX = 50;
				targetSpecY = 35;
				targetLiftZ = 0;
			});
		}

		// Also observe theme changes so sample colors update in real time
		const themeObserver = new MutationObserver(() => {
			apply();
		});
		themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

		// Observer to pause animation loop when offscreen
		const obs = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				isBenchActive = entry.isIntersecting;
				if (entry.isIntersecting) {
					cancelAnimationFrame(hoverAnimId);
					hoverAnimId = requestAnimationFrame(updateHoverTravel);
				}
			}
		});
		obs.observe(root);

		apply();
	}
