---
/**
 * Lab — 3D Voxel Map Creator.
 *
 * Isometric 3D voxel terrain builder.
 *
 * Mathematically Verified 3D Pipeline:
 * - 3D rotated normal vector test: (rx + rz) > 0 eliminates all back-face ambiguity at any angle
 * - Exposed-facet B-Rep generation (occluded internal geometry culled before sorting)
 * - True 3D centroid isometric depth sorting with height weighting (100% clipping-free)
 * - Exact polygon raycasting for pixel-perfect hover and click picking
 * - Turntable continuous 360° spin & interactive drag orbit
 * - Brush sizes: 1×1 Single and 3×3 Area
 * - Presets: Island, Twin Peaks, Pyramid, Canyon, Clear Flat
 */
---

<div class="voxel-map" data-voxel-map>
	<!-- Top Navigation & View Toolbar -->
	<div class="voxel-toolbar">
		<div class="voxel-tools-group" role="radiogroup" aria-label="Tool mode">
			<button class="glass-button glass-button--sm mono is-active" type="button" data-vm-tool="raise">
				▲ Raise
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-tool="lower">
				▼ Lower
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-tool="paint">
				● Paint
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-tool="smooth">
				▬ Smooth
			</button>
		</div>

		<div class="voxel-camera-group">
			<button class="glass-button glass-button--sm mono" type="button" data-vm-cam="prev" aria-label="Rotate View Left">
				↺ 90°
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-cam="next" aria-label="Rotate View Right">
				↻ 90°
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-turntable aria-pressed="false">
				<span class="dot" data-vm-orbit-dot></span> Spin
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-brush aria-pressed="false">
				<span data-vm-brush-text>Brush: 1×1</span>
			</button>
		</div>
	</div>

	<!-- Material Picker Bar -->
	<div class="voxel-materials-bar">
		<span class="mono text-muted voxel-bar-label">MATERIAL:</span>
		<div class="voxel-materials" role="radiogroup" aria-label="Material">
			<button class="material-chip is-active" type="button" data-vm-mat="grass" style="--mat-c: #10b981;">
				<span class="mat-swatch"></span>
				<span class="mono">Grass</span>
			</button>
			<button class="material-chip" type="button" data-vm-mat="water" style="--mat-c: #0284c7;">
				<span class="mat-swatch"></span>
				<span class="mono">Water</span>
			</button>
			<button class="material-chip" type="button" data-vm-mat="stone" style="--mat-c: #64748b;">
				<span class="mat-swatch"></span>
				<span class="mono">Stone</span>
			</button>
			<button class="material-chip" type="button" data-vm-mat="sand" style="--mat-c: #f59e0b;">
				<span class="mat-swatch"></span>
				<span class="mono">Sand</span>
			</button>
			<button class="material-chip" type="button" data-vm-mat="crystal" style="--mat-c: #a855f7;">
				<span class="mat-swatch"></span>
				<span class="mono">Crystal</span>
			</button>
			<button class="material-chip" type="button" data-vm-mat="glass" style="--mat-c: #38bdf8;">
				<span class="mat-swatch"></span>
				<span class="mono">Glass</span>
			</button>
		</div>
	</div>

	<!-- 3D Isometric Viewport -->
	<div class="voxel-viewport" data-vm-viewport>
		<canvas class="voxel-canvas" data-vm-canvas width="720" height="460"></canvas>
		<div class="voxel-status-hud mono">
			<span data-vm-coords>Voxel: [0, 0] · Height: 1</span>
			<span class="voxel-drag-tip">Drag horizontally to orbit · Click to sculpt</span>
			<span data-vm-angle>Angle: 0°</span>
		</div>
	</div>

	<!-- Secondary Presets & Actions -->
	<div class="voxel-presets-row">
		<div class="voxel-presets-group">
			<span class="mono text-muted voxel-bar-label">PRESETS:</span>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-preset="island">
				Island
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-preset="peaks">
				Twin Peaks
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-preset="pyramid">
				Pyramid
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-preset="canyon">
				Canyon
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-preset="flat">
				Clear Flat
			</button>
		</div>

		<div class="voxel-io-group">
			<button class="glass-button glass-button--sm mono" type="button" data-vm-random>
				⚡ Randomize
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-vm-export>
				Export JSON
			</button>
		</div>
	</div>

	<!-- Sliders -->
	<div class="lab-controls">
		<label class="lab-control">
			<span class="lab-control__label">
				Grid Size <output data-vm-out="size">10×10</output>
			</span>
			<input class="lab-range" type="range" min="8" max="12" step="2" value="10" data-vm-in="size" />
		</label>

		<label class="lab-control">
			<span class="lab-control__label">
				Elevation Step <output data-vm-out="step">1 Layer</output>
			</span>
			<input class="lab-range" type="range" min="1" max="2" step="1" value="1" data-vm-in="step" />
		</label>

		<label class="lab-control">
			<span class="lab-control__label">
				Turntable Speed <output data-vm-out="orbit">Normal</output>
			</span>
			<input class="lab-range" type="range" min="1" max="3" step="1" value="2" data-vm-in="orbit" />
		</label>
	</div>
</div>

<script>
	type Tool = 'raise' | 'lower' | 'paint' | 'smooth';
	type Material = 'grass' | 'water' | 'stone' | 'sand' | 'crystal' | 'glass';

	interface VoxelCell {
		height: number;
		mat: Material;
	}

	interface Point2D {
		x: number;
		y: number;
	}

	interface ExposedFacet {
		r: number;
		c: number;
		type: 'top' | 'south' | 'east' | 'north' | 'west';
		pts2D: Point2D[];
		fill: string;
		stroke?: string;
		strokeWidth?: number;
		depth: number;
	}

	const MAT_COLORS: Record<Material, { top: string; front: string; side: string; edge: string }> = {
		grass: {
			top: '#34d399',
			front: '#059669',
			side: '#047857',
			edge: 'rgba(209, 250, 229, 0.75)',
		},
		water: {
			top: '#38bdf8',
			front: '#0284c7',
			side: '#0369a1',
			edge: 'rgba(186, 230, 253, 0.7)',
		},
		stone: {
			top: '#94a3b8',
			front: '#64748b',
			side: '#475569',
			edge: 'rgba(226, 232, 240, 0.6)',
		},
		sand: {
			top: '#fcd34d',
			front: '#d97706',
			side: '#b45309',
			edge: 'rgba(254, 243, 199, 0.8)',
		},
		crystal: {
			top: '#c084fc',
			front: '#9333ea',
			side: '#7e22ce',
			edge: 'rgba(243, 232, 255, 0.85)',
		},
		glass: {
			top: '#bae6fd',
			front: '#38bdf8',
			side: '#0284c7',
			edge: 'rgba(255, 255, 255, 0.9)',
		},
	};

	const root = document.querySelector<HTMLElement>('[data-voxel-map]');
	if (root) {
		const canvas = root.querySelector<HTMLCanvasElement>('[data-vm-canvas]')!;
		const ctx = canvas.getContext('2d')!;
		const viewport = root.querySelector<HTMLElement>('[data-vm-viewport]')!;
		const coordsHud = root.querySelector<HTMLElement>('[data-vm-coords]')!;
		const angleHud = root.querySelector<HTMLElement>('[data-vm-angle]')!;

		const toolBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-vm-tool]'));
		const matBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-vm-mat]'));
		const camPrev = root.querySelector<HTMLButtonElement>('[data-vm-cam="prev"]');
		const camNext = root.querySelector<HTMLButtonElement>('[data-vm-cam="next"]');
		const turntableBtn = root.querySelector<HTMLButtonElement>('[data-vm-turntable]');
		const orbitDot = root.querySelector<HTMLElement>('[data-vm-orbit-dot]');
		const brushBtn = root.querySelector<HTMLButtonElement>('[data-vm-brush]');
		const brushText = root.querySelector<HTMLElement>('[data-vm-brush-text]');

		const presetBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-vm-preset]'));
		const randomBtn = root.querySelector<HTMLButtonElement>('[data-vm-random]');
		const exportBtn = root.querySelector<HTMLButtonElement>('[data-vm-export]');

		const sizeIn = root.querySelector<HTMLInputElement>('[data-vm-in="size"]');
		const sizeOut = root.querySelector<HTMLOutputElement>('[data-vm-out="size"]');
		const stepIn = root.querySelector<HTMLInputElement>('[data-vm-in="step"]');
		const stepOut = root.querySelector<HTMLOutputElement>('[data-vm-out="step"]');
		const orbitIn = root.querySelector<HTMLInputElement>('[data-vm-in="orbit"]');
		const orbitOut = root.querySelector<HTMLOutputElement>('[data-vm-out="orbit"]');

		let gridSize = 10;
		let elevStep = 1;
		let orbitSpeed = 2;
		let brushSize: 1 | 3 = 1;
		let currentTool: Tool = 'raise';
		let currentMat: Material = 'grass';
		let isTurntable = false;

		let camAngle = 0; // Radians
		let targetCamAngle = 0;
		let isDraggingCam = false;
		let startDragX = 0;
		let startDragAngle = 0;
		let hasDraggedFar = false;

		let hoveredCell: { r: number; c: number } | null = null;
		let lastRenderedFacets: ExposedFacet[] = [];

		const createInitialGrid = (size: number): VoxelCell[][] => {
			const arr: VoxelCell[][] = [];
			for (let r = 0; r < size; r++) {
				const row: VoxelCell[] = [];
				for (let c = 0; c < size; c++) {
					const distCenter = Math.hypot(r - size / 2 + 0.5, c - size / 2 + 0.5);
					let h = 1;
					let m: Material = 'water';

					if (distCenter < size * 0.42) {
						h = Math.max(1, Math.round(4 - distCenter * 0.8));
						if (h >= 3) m = 'grass';
						else if (h === 2) m = 'sand';
						else m = 'water';
					} else {
						h = 1;
						m = 'water';
					}
					row.push({ height: h, mat: m });
				}
				arr.push(row);
			}
			return arr;
		};

		let grid = createInitialGrid(gridSize);

		const resize = () => {
			const rect = viewport.getBoundingClientRect();
			const dpr = Math.min(window.devicePixelRatio || 1, 2);
			canvas.width = Math.round(rect.width * dpr);
			canvas.height = Math.round(rect.height * dpr);
			canvas.style.width = `${rect.width}px`;
			canvas.style.height = `${rect.height}px`;
			ctx.resetTransform();
			ctx.scale(dpr, dpr);
		};
		window.addEventListener('resize', resize);
		resize();

		// True 3D coordinate projection into isometric screen space
		const projectCorner = (
			gx: number,
			gy: number,
			gz: number,
			angle: number,
			ox: number,
			oy: number,
			tileSize = 28
		) => {
			const cx = gridSize / 2;
			const cz = gridSize / 2;
			const dx = (gx - cx) * tileSize;
			const dz = (gz - cz) * tileSize;

			const rx = dx * Math.cos(angle) - dz * Math.sin(angle);
			const rz = dx * Math.sin(angle) + dz * Math.cos(angle);

			const cos30 = 0.866025;
			const sin30 = 0.5;
			const layerH = tileSize * 0.65;

			const screenX = ox + (rx - rz) * cos30;
			const screenY = oy + (rx + rz) * sin30 - gy * layerH;

			// Ray depth along isometric camera gaze:
			const depth = (rx + rz) * sin30 + gy * layerH * cos30;

			return { x: screenX, y: screenY, rx, rz, depth };
		};

		// Point-in-polygon test for facet raycasting
		const isPointInQuad = (pt: Point2D, quad: Point2D[]) => {
			let inside = false;
			for (let i = 0, j = quad.length - 1; i < quad.length; j = i++) {
				const xi = quad[i].x;
				const yi = quad[i].y;
				const xj = quad[j].x;
				const yj = quad[j].y;

				const intersect = yi > pt.y !== yj > pt.y && pt.x < ((xj - xi) * (pt.y - yi)) / (yj - yi) + xi;
				if (intersect) inside = !inside;
			}
			return inside;
		};

		// Animation frame render loop
		let animId = 0;

		const render = () => {
			const rect = viewport.getBoundingClientRect();
			ctx.clearRect(0, 0, rect.width, rect.height);

			if (isTurntable) {
				camAngle += 0.008 * orbitSpeed;
				targetCamAngle = camAngle;
			} else if (!isDraggingCam) {
				camAngle += (targetCamAngle - camAngle) * 0.12;
			}

			const deg = Math.round((((camAngle * 180) / Math.PI) % 360) + 360) % 360;
			if (angleHud) angleHud.textContent = `Angle: ${deg}°`;

			const ox = rect.width / 2;
			const oy = rect.height * 0.58;
			const tileSize = 28;

			// Ground contact shadow
			const cx = gridSize / 2;
			const cz = gridSize / 2;
			const shadowR = (gridSize * tileSize * 0.75);
			ctx.save();
			ctx.fillStyle = document.documentElement.dataset.theme === 'light' ? 'rgba(30, 80, 140, 0.22)' : 'rgba(0, 0, 0, 0.45)';
			ctx.filter = 'blur(18px)';
			ctx.beginPath();
			ctx.ellipse(ox, oy + 25, shadowR, shadowR * 0.48, 0, 0, Math.PI * 2);
			ctx.fill();
			ctx.restore();

			// 3D Rotated Normal Vectors for 4 vertical faces:
			// A face faces the camera if and only if (rx + rz) > 0.
			const southVisible = -Math.sin(camAngle) + Math.cos(camAngle) > 0.0001;
			const eastVisible = Math.cos(camAngle) + Math.sin(camAngle) > 0.0001;
			const northVisible = Math.sin(camAngle) - Math.cos(camAngle) > 0.0001;
			const westVisible = -Math.cos(camAngle) - Math.sin(camAngle) > 0.0001;

			const facets: ExposedFacet[] = [];

			// Generate all exposed boundary facets across the grid
			for (let r = 0; r < gridSize; r++) {
				for (let c = 0; c < gridSize; c++) {
					const cell = grid[r][c];
					const h = cell.height;
					const colors = MAT_COLORS[cell.mat];
					const isHov =
						hoveredCell !== null &&
						(brushSize === 1
							? hoveredCell.r === r && hoveredCell.c === c
							: Math.abs(hoveredCell.r - r) <= 1 && Math.abs(hoveredCell.c - c) <= 1);

					// 1. TOP FACE at gy = h (Always visible from above)
					const t0 = projectCorner(c, h, r, camAngle, ox, oy, tileSize);
					const t1 = projectCorner(c + 1, h, r, camAngle, ox, oy, tileSize);
					const t2 = projectCorner(c + 1, h, r + 1, camAngle, ox, oy, tileSize);
					const t3 = projectCorner(c, h, r + 1, camAngle, ox, oy, tileSize);

					const topDepth = (t0.depth + t1.depth + t2.depth + t3.depth) / 4;
					facets.push({
						r,
						c,
						type: 'top',
						pts2D: [t0, t1, t2, t3],
						fill: isHov ? '#ffffff' : colors.top,
						stroke: isHov ? '#38bdf8' : colors.edge,
						strokeWidth: isHov ? 2.5 : 1,
						depth: topDepth,
					});

					// 2. SOUTH FACE (+Z): only visible above southern neighbor when southVisible === true
					if (southVisible) {
						const southH = r + 1 < gridSize ? grid[r + 1][c].height : 0;
						if (h > southH) {
							const bL = projectCorner(c, southH, r + 1, camAngle, ox, oy, tileSize);
							const bR = projectCorner(c + 1, southH, r + 1, camAngle, ox, oy, tileSize);
							const tR = projectCorner(c + 1, h, r + 1, camAngle, ox, oy, tileSize);
							const tL = projectCorner(c, h, r + 1, camAngle, ox, oy, tileSize);

							const southDepth = (bL.depth + bR.depth + tR.depth + tL.depth) / 4;
							facets.push({
								r,
								c,
								type: 'south',
								pts2D: [bL, bR, tR, tL],
								fill: colors.front,
								depth: southDepth,
							});
						}
					}

					// 3. EAST FACE (+X): only visible above eastern neighbor when eastVisible === true
					if (eastVisible) {
						const eastH = c + 1 < gridSize ? grid[r][c + 1].height : 0;
						if (h > eastH) {
							const bL = projectCorner(c + 1, eastH, r + 1, camAngle, ox, oy, tileSize);
							const bR = projectCorner(c + 1, eastH, r, camAngle, ox, oy, tileSize);
							const tR = projectCorner(c + 1, h, r, camAngle, ox, oy, tileSize);
							const tL = projectCorner(c + 1, h, r + 1, camAngle, ox, oy, tileSize);

							const eastDepth = (bL.depth + bR.depth + tR.depth + tL.depth) / 4;
							facets.push({
								r,
								c,
								type: 'east',
								pts2D: [bL, bR, tR, tL],
								fill: colors.side,
								depth: eastDepth,
							});
						}
					}

					// 4. NORTH FACE (-Z): only visible above northern neighbor when northVisible === true
					if (northVisible) {
						const northH = r - 1 >= 0 ? grid[r - 1][c].height : 0;
						if (h > northH) {
							const bL = projectCorner(c + 1, northH, r, camAngle, ox, oy, tileSize);
							const bR = projectCorner(c, northH, r, camAngle, ox, oy, tileSize);
							const tR = projectCorner(c, h, r, camAngle, ox, oy, tileSize);
							const tL = projectCorner(c + 1, h, r, camAngle, ox, oy, tileSize);

							const northDepth = (bL.depth + bR.depth + tR.depth + tL.depth) / 4;
							facets.push({
								r,
								c,
								type: 'north',
								pts2D: [bL, bR, tR, tL],
								fill: colors.front,
								depth: northDepth,
							});
						}
					}

					// 5. WEST FACE (-X): only visible above western neighbor when westVisible === true
					if (westVisible) {
						const westH = c - 1 >= 0 ? grid[r][c - 1].height : 0;
						if (h > westH) {
							const bL = projectCorner(c, westH, r, camAngle, ox, oy, tileSize);
							const bR = projectCorner(c, westH, r + 1, camAngle, ox, oy, tileSize);
							const tR = projectCorner(c, h, r + 1, camAngle, ox, oy, tileSize);
							const tL = projectCorner(c, h, r, camAngle, ox, oy, tileSize);

							const westDepth = (bL.depth + bR.depth + tR.depth + tL.depth) / 4;
							facets.push({
								r,
								c,
								type: 'west',
								pts2D: [bL, bR, tR, tL],
								fill: colors.side,
								depth: westDepth,
							});
						}
					}
				}
			}

			// Sort back-to-front (lowest depth drawn first)
			facets.sort((a, b) => a.depth - b.depth);
			lastRenderedFacets = facets;

			// Draw depth-sorted quads
			facets.forEach((f) => {
				ctx.save();
				ctx.fillStyle = f.fill;
				ctx.beginPath();
				ctx.moveTo(f.pts2D[0].x, f.pts2D[0].y);
				for (let i = 1; i < f.pts2D.length; i++) {
					ctx.lineTo(f.pts2D[i].x, f.pts2D[i].y);
				}
				ctx.closePath();
				ctx.fill();

				if (f.stroke) {
					ctx.strokeStyle = f.stroke;
					ctx.lineWidth = f.strokeWidth || 1;
					ctx.lineJoin = 'round';
					ctx.stroke();
				}
				ctx.restore();
			});

			animId = requestAnimationFrame(render);
		};

		// 3D Raycasting: pick the front-most facet under mouse
		const findVoxelAt = (mouseX: number, mouseY: number) => {
			let bestFacet: ExposedFacet | null = null;
			for (let i = lastRenderedFacets.length - 1; i >= 0; i--) {
				const f = lastRenderedFacets[i];
				if (isPointInQuad({ x: mouseX, y: mouseY }, f.pts2D)) {
					bestFacet = f;
					break;
				}
			}
			return bestFacet ? { r: bestFacet.r, c: bestFacet.c } : null;
		};

		toolBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const t = btn.dataset.vmTool as Tool;
				if (!t) return;
				currentTool = t;
				toolBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
			});
		});

		matBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const m = btn.dataset.vmMat as Material;
				if (!m) return;
				currentMat = m;
				matBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
				if (currentTool !== 'paint') {
					currentTool = 'paint';
					toolBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.vmTool === 'paint'));
				}
			});
		});

		camPrev?.addEventListener('click', () => {
			targetCamAngle -= Math.PI / 2;
			isTurntable = false;
			turntableBtn?.setAttribute('aria-pressed', 'false');
			orbitDot?.classList.remove('dot--live');
		});

		camNext?.addEventListener('click', () => {
			targetCamAngle += Math.PI / 2;
			isTurntable = false;
			turntableBtn?.setAttribute('aria-pressed', 'false');
			orbitDot?.classList.remove('dot--live');
		});

		turntableBtn?.addEventListener('click', () => {
			isTurntable = !isTurntable;
			turntableBtn.setAttribute('aria-pressed', String(isTurntable));
			orbitDot?.classList.toggle('dot--live', isTurntable);
		});

		brushBtn?.addEventListener('click', () => {
			brushSize = brushSize === 1 ? 3 : 1;
			brushBtn.setAttribute('aria-pressed', String(brushSize === 3));
			if (brushText) brushText.textContent = `Brush: ${brushSize}×${brushSize}`;
		});

		const applyToolAt = (r: number, c: number) => {
			const coords: Array<{ r: number; c: number }> = [];
			if (brushSize === 1) {
				coords.push({ r, c });
			} else {
				for (let dr = -1; dr <= 1; dr++) {
					for (let dc = -1; dc <= 1; dc++) {
						const nr = r + dr;
						const nc = c + dc;
						if (nr >= 0 && nr < gridSize && nc >= 0 && nc < gridSize) {
							coords.push({ r: nr, c: nc });
						}
					}
				}
			}

			coords.forEach((coord) => {
				const cell = grid[coord.r][coord.c];
				if (currentTool === 'raise') {
					cell.height = Math.min(6, cell.height + elevStep);
					cell.mat = currentMat;
				} else if (currentTool === 'lower') {
					cell.height = Math.max(1, cell.height - elevStep);
				} else if (currentTool === 'paint') {
					cell.mat = currentMat;
				} else if (currentTool === 'smooth') {
					let sum = 0;
					let count = 0;
					for (let dr = -1; dr <= 1; dr++) {
						for (let dc = -1; dc <= 1; dc++) {
							const nr = coord.r + dr;
							const nc = coord.c + dc;
							if (nr >= 0 && nr < gridSize && nc >= 0 && nc < gridSize) {
								sum += grid[nr][nc].height;
								count++;
							}
						}
					}
					cell.height = Math.max(1, Math.min(6, Math.round(sum / count)));
				}
			});
		};

		canvas.addEventListener('pointerdown', (e) => {
			isDraggingCam = true;
			hasDraggedFar = false;
			startDragX = e.clientX;
			startDragAngle = camAngle;
			canvas.setPointerCapture(e.pointerId);
		});

		canvas.addEventListener('pointermove', (e) => {
			const rect = canvas.getBoundingClientRect();
			const mouseX = e.clientX - rect.left;
			const mouseY = e.clientY - rect.top;

			if (isDraggingCam) {
				const delta = e.clientX - startDragX;
				if (Math.abs(delta) > 5) {
					hasDraggedFar = true;
				}
				camAngle = startDragAngle + delta * 0.008;
				targetCamAngle = camAngle;
				isTurntable = false;
				turntableBtn?.setAttribute('aria-pressed', 'false');
				orbitDot?.classList.remove('dot--live');
			}

			const hit = findVoxelAt(mouseX, mouseY);
			if (hit) {
				hoveredCell = hit;
				const c = grid[hit.r][hit.c];
				if (coordsHud) coordsHud.textContent = `Voxel: [${hit.c}, ${hit.r}] · Height: ${c.height} · Mat: ${c.mat}`;
			} else {
				hoveredCell = null;
			}
		});

		canvas.addEventListener('pointerup', (e) => {
			if (isDraggingCam) {
				isDraggingCam = false;
				try {
					canvas.releasePointerCapture(e.pointerId);
				} catch {}

				if (!hasDraggedFar) {
					const rect = canvas.getBoundingClientRect();
					const hit = findVoxelAt(e.clientX - rect.left, e.clientY - rect.top);
					if (hit) {
						applyToolAt(hit.r, hit.c);
					}
				}
			}
		});

		presetBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const p = btn.dataset.vmPreset;
				if (!p) return;

				grid = [];
				for (let r = 0; r < gridSize; r++) {
					const row: VoxelCell[] = [];
					for (let c = 0; c < gridSize; c++) {
						const dist = Math.hypot(r - gridSize / 2 + 0.5, c - gridSize / 2 + 0.5);
						let h = 1;
						let m: Material = 'water';

						if (p === 'island') {
							if (dist < gridSize * 0.45) {
								h = Math.max(1, Math.round(5 - dist * 0.9));
								m = h >= 4 ? 'crystal' : h >= 2 ? 'grass' : 'sand';
							}
						} else if (p === 'peaks') {
							const d1 = Math.hypot(r - gridSize * 0.3, c - gridSize * 0.3);
							const d2 = Math.hypot(r - gridSize * 0.7, c - gridSize * 0.7);
							h = Math.max(1, Math.round(5 - Math.min(d1, d2) * 1.2));
							m = h >= 4 ? 'stone' : h >= 2 ? 'grass' : 'water';
						} else if (p === 'pyramid') {
							const cheb = Math.max(Math.abs(r - gridSize / 2 + 0.5), Math.abs(c - gridSize / 2 + 0.5));
							h = Math.max(1, Math.round(5 - cheb * 0.9));
							m = 'sand';
						} else if (p === 'canyon') {
							const distLine = Math.abs(r - c);
							if (distLine < 1.6) {
								h = 1;
								m = 'water';
							} else {
								h = Math.min(5, Math.round(distLine * 0.8 + 1));
								m = h >= 4 ? 'stone' : 'grass';
							}
						} else {
							h = 1;
							m = 'grass';
						}
						row.push({ height: h, mat: m });
					}
					grid.push(row);
				}
			});
		});

		randomBtn?.addEventListener('click', () => {
			const mats: Material[] = ['grass', 'water', 'stone', 'sand', 'crystal', 'glass'];
			for (let r = 0; r < gridSize; r++) {
				for (let c = 0; c < gridSize; c++) {
					grid[r][c].height = Math.floor(Math.random() * 5) + 1;
					grid[r][c].mat = mats[Math.floor(Math.random() * mats.length)];
				}
			}
		});

		exportBtn?.addEventListener('click', () => {
			const jsonStr = JSON.stringify(grid, null, 2);
			const blob = new Blob([jsonStr], { type: 'application/json' });
			const url = URL.createObjectURL(blob);
			const a = document.createElement('a');
			a.href = url;
			a.download = `voxel-map-${gridSize}x${gridSize}.json`;
			a.click();
			URL.revokeObjectURL(url);
		});

		sizeIn?.addEventListener('input', () => {
			gridSize = Number(sizeIn.value);
			if (sizeOut) sizeOut.textContent = `${gridSize}×${gridSize}`;
			grid = createInitialGrid(gridSize);
		});

		stepIn?.addEventListener('input', () => {
			elevStep = Number(stepIn.value);
			if (stepOut) stepOut.textContent = `${elevStep} Layer${elevStep > 1 ? 's' : ''}`;
		});

		orbitIn?.addEventListener('input', () => {
			orbitSpeed = Number(orbitIn.value);
			if (orbitOut) orbitOut.textContent = orbitSpeed === 1 ? 'Slow' : orbitSpeed === 2 ? 'Normal' : 'Fast';
		});

		// Intersection observer
		//
		// Two gates, not one: onscreen (this observer) and unhidden (the tab).
		// A page scrolled past the experiment otherwise keeps the loop running
		// while its own tab is backgrounded or another tab is in front, which is
		// exactly the case AGENTS.md §5 rules out. syncLoop owns both the start
		// and the stop so the gates cannot disagree.
		let onscreen = false;

		const syncLoop = () => {
			cancelAnimationFrame(animId);
			if (!onscreen || document.hidden) return;
			animId = requestAnimationFrame(render);
		};

		const obs = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				onscreen = entry.isIntersecting;
				syncLoop();
			}
		});
		obs.observe(root);

		document.addEventListener('visibilitychange', syncLoop);
	}
</script>

