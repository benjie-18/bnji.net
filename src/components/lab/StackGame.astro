---
/**
 * Lab — Isometric Stack Game.
 *
 * 3D isometric block stacking game styled with bnji.net's glass tokens.
 *
 * Features:
 * - 5 distinct theme palettes: Aero Sky, Aurora Neon, Sunset Quartz, Cyber Magenta, Monochrome Crystal
 * - CSS-sized, DPR-aware canvas with stable world-space movement
 * - Sliced debris starts beside the kept overlap on either movement axis
 * - Reserved combo slot (visibility + is-live) keeps the header from jumping
 * - Adjustable Layer Thickness and Camera Zoom controls
 * - Spark burst particle explosions on perfect placements
 * - Alternating X/Z movement axes with combo multiplier (≤3.5px snap): the
 *   n-th consecutive perfect drop is worth n points, and the best streak of
 *   the run is recorded so the game-over screen can report it
 * - Web Audio synth feedback for placements, chops, combos, and game over
 */
---

<div class="stack-game" data-stack-game>
	<!-- Scoreboard Header -->
	<div class="stack-header">
		<div class="stack-score-group">
			<span class="mono text-muted stack-label">SCORE</span>
			<span class="stack-score-val mono" data-sg-score>0</span>
		</div>

		<div class="stack-combo mono" data-sg-combo aria-hidden="true">
			<span class="stack-combo-badge">COMBO ×<span data-sg-combo-count>1</span></span>
		</div>

		<div class="stack-high-group">
			<span class="mono text-faint stack-label">BEST</span>
			<span class="mono text-muted" data-sg-best>0</span>
		</div>
	</div>

	<!-- Interactive Game Canvas Viewport -->
	<div class="stack-viewport">
		<canvas class="stack-canvas" data-sg-canvas width="640" height="520"></canvas>

		<!-- Overlay Messages -->
		<div class="stack-overlay" data-sg-overlay>
			<div class="stack-overlay-card">
				<h3 class="stack-overlay-title mono" data-sg-title>ISO STACK</h3>
				<p class="stack-overlay-desc" data-sg-desc>Tap or press Space to drop layers. Align blocks cleanly to maintain tower surface.</p>
				<button class="glass-button glass-button--primary mono" type="button" data-sg-start>
					Start Game
				</button>
			</div>
		</div>

		<!-- In-game controls HUD -->
		<div class="stack-hud">
			<button class="glass-button glass-button--sm mono" type="button" data-sg-restart aria-label="Restart Stack Game">
				↺ Reset
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-sg-audio aria-pressed="true">
				<span class="dot dot--live" data-sg-audio-dot></span> Sound
			</button>
		</div>
	</div>

	<!-- Customization Controls & Sliders -->
	<div class="lab-controls">
		<label class="lab-control">
			<span class="lab-control__label">
				Theme Palette <output data-sg-out="theme">Aero Sky</output>
			</span>
			<input class="lab-range" type="range" min="0" max="4" step="1" value="0" data-sg-in="theme" />
		</label>

		<label class="lab-control">
			<span class="lab-control__label">
				Layer Thickness <output data-sg-out="thickness">18px (Standard)</output>
			</span>
			<input class="lab-range" type="range" min="12" max="28" step="4" value="18" data-sg-in="thickness" />
		</label>

		<label class="lab-control">
			<span class="lab-control__label">
				Camera View Zoom <output data-sg-out="zoom">1.0×</output>
			</span>
			<input class="lab-range" type="range" min="0.7" max="1.3" step="0.1" value="1.0" data-sg-in="zoom" />
		</label>

		<label class="lab-control">
			<span class="lab-control__label">
				Movement Speed <output data-sg-out="speed">Normal</output>
			</span>
			<input class="lab-range" type="range" min="1" max="3" step="1" value="2" data-sg-in="speed" />
		</label>
	</div>
</div>

<script>
	interface Layer {
		x: number;
		z: number;
		w: number;
		d: number;
		y: number;
		colorIndex: number;
	}

	interface Debris {
		x: number;
		z: number;
		w: number;
		d: number;
		y: number;
		vy: number;
		vx: number;
		vz: number;
		opacity: number;
		colorIndex: number;
	}

	interface Spark {
		x: number;
		y: number;
		vx: number;
		vy: number;
		life: number;
		maxLife: number;
		size: number;
		color: string;
	}

	const THEMES = [
		{ name: 'Aero Sky', baseHue: 195, step: 10, sat: 85, light: 55 },
		{ name: 'Aurora Neon', baseHue: 150, step: 14, sat: 88, light: 52 },
		{ name: 'Sunset Quartz', baseHue: 335, step: 12, sat: 85, light: 58 },
		{ name: 'Cyber Magenta', baseHue: 280, step: 15, sat: 92, light: 56 },
		{ name: 'Monochrome Crystal', baseHue: 210, step: 0, sat: 10, light: 62 },
	];

	const root = document.querySelector<HTMLElement>('[data-stack-game]');
	if (root) {
		const canvas = root.querySelector<HTMLCanvasElement>('[data-sg-canvas]')!;
		const ctx = canvas.getContext('2d')!;
		const lifecycle = new AbortController();
		const { signal } = lifecycle;
		const scoreEl = root.querySelector<HTMLElement>('[data-sg-score]')!;
		const bestEl = root.querySelector<HTMLElement>('[data-sg-best]')!;
		const comboEl = root.querySelector<HTMLElement>('[data-sg-combo]')!;
		const comboCountEl = root.querySelector<HTMLElement>('[data-sg-combo-count]')!;
		const setComboLive = (live: boolean) => {
			comboEl.classList.toggle('is-live', live);
			comboEl.setAttribute('aria-hidden', String(!live));
		};
		const overlay = root.querySelector<HTMLElement>('[data-sg-overlay]')!;
		const overlayTitle = root.querySelector<HTMLElement>('[data-sg-title]')!;
		const overlayDesc = root.querySelector<HTMLElement>('[data-sg-desc]')!;
		const startBtn = root.querySelector<HTMLButtonElement>('[data-sg-start]')!;
		const restartBtn = root.querySelector<HTMLButtonElement>('[data-sg-restart]')!;
		const audioBtn = root.querySelector<HTMLButtonElement>('[data-sg-audio]')!;
		const audioDot = root.querySelector<HTMLElement>('[data-sg-audio-dot]')!;

		const themeIn = root.querySelector<HTMLInputElement>('[data-sg-in="theme"]');
		const themeOut = root.querySelector<HTMLOutputElement>('[data-sg-out="theme"]');
		const thicknessIn = root.querySelector<HTMLInputElement>('[data-sg-in="thickness"]');
		const thicknessOut = root.querySelector<HTMLOutputElement>('[data-sg-out="thickness"]');
		const zoomIn = root.querySelector<HTMLInputElement>('[data-sg-in="zoom"]');
		const zoomOut = root.querySelector<HTMLOutputElement>('[data-sg-out="zoom"]');
		const speedIn = root.querySelector<HTMLInputElement>('[data-sg-in="speed"]');
		const speedOut = root.querySelector<HTMLOutputElement>('[data-sg-out="speed"]');

		const STORAGE_KEY = 'bnji-stack-best';
		let bestScore = Number(localStorage.getItem(STORAGE_KEY) || 0);
		bestEl.textContent = String(bestScore);

		// Audio Synthesizer
		let audioEnabled = true;
		let audioCtx: AudioContext | null = null;
		const playTone = (freq: number, type: OscillatorType = 'sine', dur = 0.22) => {
			if (!audioEnabled) return;
			try {
				if (!audioCtx) {
					const AudioClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
					audioCtx = new AudioClass();
				}
				if (audioCtx.state === 'suspended') audioCtx.resume();
				const now = audioCtx.currentTime;
				const osc = audioCtx.createOscillator();
				const gain = audioCtx.createGain();
				osc.type = type;
				osc.frequency.setValueAtTime(freq, now);
				gain.gain.setValueAtTime(0.14, now);
				gain.gain.exponentialRampToValueAtTime(0.0001, now + dur);
				osc.connect(gain);
				gain.connect(audioCtx.destination);
				osc.start(now);
				osc.stop(now + dur);
			} catch {
				// AudioContext unavailable
			}
		};

		// Draw in CSS pixels, not backing-store pixels: changing DPR must make
		// the image sharper without changing block sizes, travel or spark speed.
		let canvasWidth = 640;
		let canvasHeight = 520;
		const fitCanvas = () => {
			const rect = canvas.getBoundingClientRect();
			canvasWidth = Math.max(1, rect.width || canvas.clientWidth || 640);
			canvasHeight = Math.max(1, rect.height || canvasWidth * (520 / 640));
			const dpr = Math.max(1, Math.min(2, window.devicePixelRatio || 1));
			const width = Math.round(canvasWidth * dpr);
			const height = Math.round(canvasHeight * dpr);
			if (canvas.width !== width) canvas.width = width;
			if (canvas.height !== height) canvas.height = height;
			// Setting either dimension clears the transform. setTransform also
			// avoids accumulating scale across repeated fits at the same size.
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
		};

		// Configs
		let layerHeight = 18;
		const BASE_SIZE = 140;
		let speedMultiplier = 1.0;
		let snapThreshold = 3.5;
		let themeIdx = 0;
		let viewZoom = 1.0;

		// Game State
		let isPlaying = false;
		let isGameOver = false;
		let score = 0;
		let combo = 0;
		// The fatal drop always resets `combo` to 0, so the run's best streak
		// must be recorded as it happens or the game-over screen could only
		// ever report 0.
		let bestCombo = 0;
		let cameraY = 0;
		let targetCameraY = 0;

		let stack: Layer[] = [];
		let debris: Debris[] = [];
		let sparks: Spark[] = [];

		// Active block
		let activeAxis: 'x' | 'z' = 'x';
		let activePos = 0;
		let activeDir = 1;
		let activeW = BASE_SIZE;
		let activeD = BASE_SIZE;
		let activeY = 0;

		const isLight = () => document.documentElement.dataset.theme === 'light';

		// Color generator
		const getColors = (idx: number) => {
			const th = THEMES[themeIdx];
			let h = (th.baseHue + idx * th.step) % 360;
			let s = th.sat;
			let l = isLight() ? th.light + 10 : th.light;

			if (themeIdx === 4) {
				// Monochrome crystal: shade variation
				l = isLight() ? 70 + (idx % 4) * 5 : 45 + (idx % 4) * 6;
				s = 5;
			}

			return {
				top: `hsl(${h}, ${s}%, ${l + 14}%)`,
				left: `hsl(${h}, ${Math.max(0, s - 12)}%, ${l - 12}%)`,
				right: `hsl(${h}, ${Math.max(0, s - 8)}%, ${l - 4}%)`,
				edge: `hsla(${h}, 100%, 94%, 0.85)`,
			};
		};

		const initGame = () => {
			stack = [
				{
					x: 0,
					z: 0,
					w: BASE_SIZE,
					d: BASE_SIZE,
					y: 0,
					colorIndex: 0,
				},
			];
			debris = [];
			sparks = [];
			score = 0;
			combo = 0;
			bestCombo = 0;
			cameraY = 0;
			targetCameraY = 0;
			scoreEl.textContent = '0';
			setComboLive(false);
			isGameOver = false;

			spawnBlock();
		};

		const spawnBlock = () => {
			const prev = stack[stack.length - 1];
			activeAxis = activeAxis === 'x' ? 'z' : 'x';
			activeW = prev.w;
			activeD = prev.d;
			activeY = stack.length * layerHeight;
			activeDir = 1;
			activePos = -170;
			targetCameraY = activeY;
		};

		const spawnSparks = (screenX: number, screenY: number, count = 16) => {
			for (let i = 0; i < count; i++) {
				const angle = Math.random() * Math.PI * 2;
				const spd = 2 + Math.random() * 5;
				sparks.push({
					x: screenX,
					y: screenY,
					vx: Math.cos(angle) * spd,
					vy: Math.sin(angle) * spd - 1.5,
					life: 0,
					maxLife: 0.5 + Math.random() * 0.4,
					size: 2 + Math.random() * 3,
					color: isLight() ? '#0284c7' : '#38bdf8',
				});
			}
		};

		const dropBlock = () => {
			if (!isPlaying || isGameOver) return;

			const prev = stack[stack.length - 1];
			let curX = activeAxis === 'x' ? activePos : prev.x;
			let curZ = activeAxis === 'z' ? activePos : prev.z;
			let diff = activeAxis === 'x' ? curX - prev.x : curZ - prev.z;

			const ox = canvasWidth / 2;
			const oy = canvasHeight * 0.74;

			// Points for this placement: 1 for a normal drop, or the live combo
			// for a perfect one (the n-th consecutive perfect drop is worth n).
			let points = 1;

			// Snap check for perfect alignment
			if (Math.abs(diff) <= snapThreshold) {
				diff = 0;
				if (activeAxis === 'x') curX = prev.x;
				else curZ = prev.z;
				combo++;
				if (combo > bestCombo) bestCombo = combo;
				points = combo;
				comboCountEl.textContent = String(combo);
				setComboLive(true);
				playTone(480 + combo * 55, 'triangle', 0.35);

				// Trigger celebration sparks at top center of placed layer
				const pt = projectIso(curX, activeY + layerHeight, curZ, ox, oy);
				spawnSparks(pt.x, pt.y);
			} else {
				combo = 0;
				setComboLive(false);
				playTone(300 + (stack.length % 8) * 28, 'sine', 0.18);
			}

			let newW = prev.w;
			let newD = prev.d;

			if (activeAxis === 'x') {
				const overhang = Math.abs(diff);
				if (overhang >= prev.w) {
					endGame();
					return;
				}

				newW = prev.w - overhang;
				if (overhang > 0) {
					// Coordinates are CENTRES. The cut starts at the previous
					// slab's edge, with its centre half an overhang beyond it.
					const slicedX = prev.x + Math.sign(diff) * (prev.w + overhang) / 2;
					debris.push({
						x: slicedX,
						z: curZ,
						w: overhang,
						d: prev.d,
						y: activeY,
						vy: 0,
						vx: diff > 0 ? 1.4 : -1.4,
						vz: 0,
						opacity: 1,
						colorIndex: stack.length,
					});
				}

				curX = prev.x + diff / 2;
			} else {
				const overhang = Math.abs(diff);
				if (overhang >= prev.d) {
					endGame();
					return;
				}

				newD = prev.d - overhang;
				if (overhang > 0) {
					const slicedZ = prev.z + Math.sign(diff) * (prev.d + overhang) / 2;
					debris.push({
						x: curX,
						z: slicedZ,
						w: prev.w,
						d: overhang,
						y: activeY,
						vy: 0,
						vx: 0,
						vz: diff > 0 ? 1.4 : -1.4,
						opacity: 1,
						colorIndex: stack.length,
					});
				}

				curZ = prev.z + diff / 2;
			}

			stack.push({
				x: curX,
				z: curZ,
				w: newW,
				d: newD,
				y: activeY,
				colorIndex: stack.length,
			});

			score += points;
			scoreEl.textContent = String(score);
			if (score > bestScore) {
				bestScore = score;
				bestEl.textContent = String(bestScore);
				localStorage.setItem(STORAGE_KEY, String(bestScore));
			}

			spawnBlock();
		};

		const endGame = () => {
			isGameOver = true;
			isPlaying = false;
			playTone(160, 'sawtooth', 0.5);

			overlayTitle.textContent = 'GAME OVER';
			// The fatal drop always missed, so `combo` is 0 here by
			// construction — the screen must report the recorded best. The
			// layer count comes from the stack, since `score` is now a
			// combo-multiplied total rather than a layer count.
			overlayDesc.textContent = `Stacked ${stack.length - 1} crystal layers! Best combo: ${bestCombo}.`;
			startBtn.textContent = 'Play Again';
			overlay.removeAttribute('hidden');
		};

		// 3D Isometric projection with scale/zoom
		const projectIso = (x: number, y: number, z: number, originX: number, originY: number) => {
			const cos30 = 0.866025;
			const sin30 = 0.5;

			const screenX = originX + (x - z) * cos30 * viewZoom;
			const screenY = originY + (x + z) * sin30 * viewZoom - (y - cameraY) * viewZoom;
			return { x: screenX, y: screenY, depth: x + z };
		};

		const drawIsoBox = (
			x: number,
			y: number,
			z: number,
			w: number,
			d: number,
			h: number,
			colorIdx: number,
			opacity = 1
		) => {
			if (w <= 0 || d <= 0) return;
			const ox = canvasWidth / 2;
			const oy = canvasHeight * 0.74;
			const colors = getColors(colorIdx);

			const p0 = projectIso(x - w / 2, y, z - d / 2, ox, oy);
			const p1 = projectIso(x + w / 2, y, z - d / 2, ox, oy);
			const p2 = projectIso(x + w / 2, y, z + d / 2, ox, oy);
			const p3 = projectIso(x - w / 2, y, z + d / 2, ox, oy);

			const p4 = projectIso(x - w / 2, y + h, z - d / 2, ox, oy);
			const p5 = projectIso(x + w / 2, y + h, z - d / 2, ox, oy);
			const p6 = projectIso(x + w / 2, y + h, z + d / 2, ox, oy);
			const p7 = projectIso(x - w / 2, y + h, z + d / 2, ox, oy);

			ctx.save();
			ctx.globalAlpha = Math.max(0, Math.min(1, opacity));

			// Left Face
			ctx.fillStyle = colors.left;
			ctx.beginPath();
			ctx.moveTo(p3.x, p3.y);
			ctx.lineTo(p2.x, p2.y);
			ctx.lineTo(p6.x, p6.y);
			ctx.lineTo(p7.x, p7.y);
			ctx.closePath();
			ctx.fill();

			// Right Face
			ctx.fillStyle = colors.right;
			ctx.beginPath();
			ctx.moveTo(p2.x, p2.y);
			ctx.lineTo(p1.x, p1.y);
			ctx.lineTo(p5.x, p5.y);
			ctx.lineTo(p6.x, p6.y);
			ctx.closePath();
			ctx.fill();

			// Top Face
			ctx.fillStyle = colors.top;
			ctx.beginPath();
			ctx.moveTo(p4.x, p4.y);
			ctx.lineTo(p5.x, p5.y);
			ctx.lineTo(p6.x, p6.y);
			ctx.lineTo(p7.x, p7.y);
			ctx.closePath();
			ctx.fill();

			// Specular top rim
			ctx.strokeStyle = colors.edge;
			ctx.lineWidth = 1;
			ctx.stroke();

			ctx.restore();
		};

		// Animation frame render loop
		let animId = 0;
		let lastTime = performance.now();

		const render = (now: number) => {
			const dt = Math.min((now - lastTime) / 1000, 0.1);
			lastTime = now;

			// Smooth camera tracking
			cameraY += (targetCameraY - cameraY) * 0.08;

			// Active block movement
			if (isPlaying && !isGameOver) {
				const speed = 155 * speedMultiplier;
				activePos += activeDir * speed * dt;
				if (activePos > 170) {
					activePos = 170;
					activeDir = -1;
				} else if (activePos < -170) {
					activePos = -170;
					activeDir = 1;
				}
			}

			// Update falling debris
			for (let i = debris.length - 1; i >= 0; i--) {
				const d = debris[i];
				d.vy -= 900 * dt;
				d.y += d.vy * dt;
				d.x += d.vx;
				d.z += d.vz;
				d.opacity -= 0.65 * dt;
				if (d.opacity <= 0 || d.y < -250) {
					debris.splice(i, 1);
				}
			}

			// Update sparks
			for (let i = sparks.length - 1; i >= 0; i--) {
				const s = sparks[i];
				s.life += dt;
				if (s.life >= s.maxLife) {
					sparks.splice(i, 1);
					continue;
				}
				s.x += s.vx;
				s.y += s.vy;
				s.vy += 2.5 * dt * 60;
			}

			ctx.clearRect(0, 0, canvasWidth, canvasHeight);

			// Draw ground contact shadow
			const ox = canvasWidth / 2;
			const oy = canvasHeight * 0.74;
			const shadowCenter = projectIso(0, 0, 0, ox, oy);
			ctx.save();
			const shadowGrad = ctx.createRadialGradient(
				shadowCenter.x,
				shadowCenter.y,
				10,
				shadowCenter.x,
				shadowCenter.y,
				150 * viewZoom
			);
			shadowGrad.addColorStop(0, isLight() ? 'rgba(30, 80, 140, 0.35)' : 'rgba(0, 0, 0, 0.55)');
			shadowGrad.addColorStop(1, 'transparent');
			ctx.fillStyle = shadowGrad;
			ctx.beginPath();
			ctx.ellipse(shadowCenter.x, shadowCenter.y, 150 * viewZoom, 70 * viewZoom, 0, 0, Math.PI * 2);
			ctx.fill();
			ctx.restore();

			// Render stack layers
			stack.forEach((layer) => {
				drawIsoBox(layer.x, layer.y, layer.z, layer.w, layer.d, layerHeight, layer.colorIndex);
			});

			// Render falling debris pieces
			debris.forEach((d) => {
				drawIsoBox(d.x, d.y, d.z, d.w, d.d, layerHeight, d.colorIndex, d.opacity);
			});

			// Render active moving block
			if (isPlaying && !isGameOver) {
				const prev = stack[stack.length - 1];
				const curX = activeAxis === 'x' ? activePos : prev.x;
				const curZ = activeAxis === 'z' ? activePos : prev.z;
				drawIsoBox(curX, activeY, curZ, activeW, activeD, layerHeight, stack.length);
			}

			// Render celebration sparks
			sparks.forEach((s) => {
				const alpha = 1 - s.life / s.maxLife;
				ctx.save();
				ctx.globalAlpha = alpha;
				ctx.fillStyle = s.color;
				ctx.beginPath();
				ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
				ctx.fill();
				ctx.restore();
			});

			animId = requestAnimationFrame(render);
		};

		// Event handlers
		const handleAction = () => {
			if (!isPlaying) {
				overlay.setAttribute('hidden', '');
				isPlaying = true;
				initGame();
			} else {
				dropBlock();
			}
		};

		canvas.addEventListener('pointerdown', (e) => {
			e.preventDefault();
			handleAction();
		}, { signal });

		window.addEventListener('keydown', (e) => {
			if (!root.contains(document.activeElement) && e.target !== document.body) return;
			if (e.code === 'Space') {
				e.preventDefault();
				handleAction();
			}
		}, { signal });

		startBtn.addEventListener('click', () => {
			overlay.setAttribute('hidden', '');
			isPlaying = true;
			initGame();
		}, { signal });

		restartBtn.addEventListener('click', () => {
			overlay.removeAttribute('hidden');
			overlayTitle.textContent = 'ISO STACK';
			overlayDesc.textContent = 'Drop alternating blocks cleanly to construct the tallest glass tower.';
			startBtn.textContent = 'Start Game';
			isPlaying = false;
			initGame();
		}, { signal });

		audioBtn.addEventListener('click', () => {
			audioEnabled = !audioEnabled;
			audioBtn.setAttribute('aria-pressed', String(audioEnabled));
			audioDot.classList.toggle('dot--live', audioEnabled);
		}, { signal });

		// Controls
		themeIn?.addEventListener('input', () => {
			themeIdx = Number(themeIn.value);
			if (themeOut) themeOut.textContent = THEMES[themeIdx].name;
		}, { signal });

		thicknessIn?.addEventListener('input', () => {
			layerHeight = Number(thicknessIn.value);
			if (thicknessOut) thicknessOut.textContent = `${layerHeight}px (${layerHeight <= 14 ? 'Slim' : layerHeight >= 24 ? 'Thick' : 'Standard'})`;
		}, { signal });

		zoomIn?.addEventListener('input', () => {
			viewZoom = Number(zoomIn.value);
			if (zoomOut) zoomOut.textContent = `${viewZoom.toFixed(1)}×`;
		}, { signal });

		speedIn?.addEventListener('input', () => {
			const val = Number(speedIn.value);
			speedMultiplier = val === 1 ? 0.75 : val === 2 ? 1.0 : 1.5;
			if (speedOut) speedOut.textContent = val === 1 ? 'Relaxed' : val === 2 ? 'Normal' : 'Hyper';
		}, { signal });

		// Intersection observer
		//
		// Two gates, not one: onscreen (this observer) and unhidden (the tab).
		// A page scrolled past the experiment otherwise keeps the loop running
		// while its own tab is backgrounded or another tab is in front, which is
		// exactly the case AGENTS.md §5 rules out. syncLoop owns both the start
		// and the stop so the gates cannot disagree.
		let onscreen = false;
		let destroyed = false;

		const syncLoop = () => {
			cancelAnimationFrame(animId);
			if (destroyed || !onscreen || document.hidden) return;
			fitCanvas();
			lastTime = performance.now();
			animId = requestAnimationFrame(render);
		};

		const obs = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				onscreen = entry.isIntersecting;
				syncLoop();
			}
		});
		obs.observe(root);

		window.addEventListener('resize', fitCanvas, { signal });
		let resizeObserver: ResizeObserver | undefined;
		if (typeof ResizeObserver !== 'undefined') {
			resizeObserver = new ResizeObserver(fitCanvas);
			resizeObserver.observe(canvas);
		}

		const destroy = () => {
			destroyed = true;
			cancelAnimationFrame(animId);
			obs.disconnect();
			resizeObserver?.disconnect();
			lifecycle.abort();
			if (audioCtx) { void audioCtx.close().catch(() => undefined); audioCtx = null; }
		};
		document.addEventListener('astro:before-swap', destroy, { once: true, signal });
		document.addEventListener('visibilitychange', syncLoop, { signal });
		fitCanvas();
		initGame();
	}
</script>

