---
/**
 * Lab — Memory Pairs. Flip-and-match memory game with liquid glass styling,
 * customizable themes (Kaomoji, Cyber, Oceanic, Kawaii, Retro), custom pair sizes (4-12 pairs),
 * high-performance hardware-accelerated 3D card flips, and clean settings separation.
 *
 * DOM-only, accessible via keyboard and screen readers, self-contained Web Audio synthesis.
 */
const INITIAL_GLYPHS = ['◆', '●', '▲', '■', '★', '☾', '✚', '⬟'];
const initialDeck = [...INITIAL_GLYPHS, ...INITIAL_GLYPHS]
	.map((glyph, i) => ({ glyph, key: `${glyph}-${i}`, sort: Math.random() }))
	.sort((a, b) => a.sort - b.sort)
	.map((card) => card.glyph);
---

<div class="memory" data-memory data-glass-variant="clear">
	<!-- Concentric Liquid Glass Backdrop & Calibration Pattern -->
	<div class="memory__backdrop" aria-hidden="true">
		<div class="memory__grid-mesh"></div>
	</div>

	<!-- Top Toolbar: HUD, Presets, Settings Gear Button -->
	<div class="memory__toolbar" data-glass="quiet">
		<div class="memory__hud mono">
			<div class="memory__hud-item">
				<span class="hud-label">MOVES</span>
				<b data-mem-moves>0</b>
			</div>
			<div class="memory__hud-item">
				<span class="hud-label">PAIRS</span>
				<b data-mem-pairs>0 / 8</b>
			</div>
			<div class="memory__hud-item">
				<span class="hud-label">BEST</span>
				<b data-mem-best>—</b>
			</div>
		</div>

		<div class="memory__quick-actions">
			<button class="memory__tool-btn mono" type="button" data-mem-preset="6">
				6 Pairs
			</button>
			<button class="memory__tool-btn mono is-active" type="button" data-mem-preset="8">
				8 Pairs
			</button>
			<button class="memory__tool-btn mono" type="button" data-mem-preset="12">
				12 Pairs
			</button>
			<button class="memory__tool-btn mono" type="button" data-mem-preset="custom" title="Toggle custom game mode">
				Custom
			</button>

			<!-- Small dedicated gear icon to configure settings -->
			<button
				class="memory__gear-btn"
				type="button"
				data-mem-settings-toggle
				aria-expanded="false"
				aria-label="Settings"
				title="Settings"
			>
				<svg class="memory__gear-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M12 15.4a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8Z" stroke="currentColor" stroke-width="1.8"></path>
					<path d="M19.4 14.4a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.86 2.86l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V21a2 2 0 1 1-4 0v-.11a1.7 1.7 0 0 0-1.11-1.56 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.86-2.86l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.56-1.03H3a2 2 0 1 1 0-4h.11a1.7 1.7 0 0 0 1.56-1.11 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.86-2.86l.06.06a1.7 1.7 0 0 0 1.87.34H9a1.7 1.7 0 0 0 1-1.56V3a2 2 0 1 1 4 0v.11a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.86 2.86l-.06.06a1.7 1.7 0 0 0-.34 1.87V9a1.7 1.7 0 0 0 1.56 1H21a2 2 0 1 1 0 4h-.11a1.7 1.7 0 0 0-1.49 1.4Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</button>

			<button class="memory__reset-btn mono" type="button" data-mem-reset title="Restart current game">
				↻ Reset
			</button>
		</div>
	</div>

	<!-- Collapsible Liquid Glass Settings Panel -->
	<div class="memory__settings-drawer" data-glass="quiet" data-mem-settings-drawer hidden>
		<div class="memory__settings-grid">
			<!-- Theme Selector -->
			<div class="setting-group">
				<label class="setting-label mono" for="mem-theme-select">CARD THEME</label>
				<select id="mem-theme-select" class="setting-select mono" data-mem-setting="theme">
					<option value="retro" selected>Retro Glyphs (◆ ● ▲ ★)</option>
					<option value="kaomoji">Liquid Aero (Kaomoji)</option>
					<option value="oceanic">Oceanic Crystal (🫧 🐬 🌊)</option>
					<option value="cyber">Cyber Synth (⚡ 💾 💎)</option>
					<option value="kawaii">Kawaii Animals (🐱 🦊 🐼)</option>
				</select>
			</div>

			<!-- Pairs Count Slider -->
			<div class="setting-group">
				<div class="setting-header mono">
					<label class="setting-label" for="mem-pairs-slider">CUSTOM PAIRS COUNT</label>
					<span class="setting-val" data-mem-val="pairs">8 Pairs (16 Cards)</span>
				</div>
				<input
					id="mem-pairs-slider"
					class="setting-slider"
					type="range"
					min="4"
					max="12"
					step="1"
					value="8"
					data-mem-setting="pairs"
				/>
			</div>

			<!-- Card Back Emblem -->
			<div class="setting-group">
				<label class="setting-label mono" for="mem-back-select">CARD BACK</label>
				<select id="mem-back-select" class="setting-select mono" data-mem-setting="back">
					<option value="?" selected>? (Classic Mystery)</option>
					<option value="✦">✦ (Prism Star)</option>
					<option value="🫧">🫧 (Liquid Bubble)</option>
					<option value="◈">◈ (Rhombus Gem)</option>
				</select>
			</div>

			<!-- Glass Finish -->
			<div class="setting-group">
				<label class="setting-label mono" for="mem-glass-select">GLASS FINISH</label>
				<select id="mem-glass-select" class="setting-select mono" data-mem-setting="glass">
					<option value="clear" selected>Crystal Clear (Refractive)</option>
					<option value="frosted">Frosted Milk (Diffused)</option>
					<option value="prism">Prism Aurora (Iridescent)</option>
				</select>
			</div>

			<!-- Sound FX Toggle -->
			<div class="setting-group setting-group--toggle">
				<span class="setting-label mono">AUDIO FX</span>
				<button class="memory__audio-toggle mono is-active" type="button" data-mem-audio-toggle aria-pressed="true">
					<span class="dot dot--live" aria-hidden="true"></span>
					<span data-mem-audio-label>Sound: On</span>
				</button>
			</div>
		</div>
	</div>

	<!-- Memory Cards Board Container -->
	<div class="memory__board-frame">
		<div
			class="memory__grid"
			role="group"
			aria-label="Memory pairs board"
			data-mem-grid
			style="--mem-cols: 4;"
		>
			{
				initialDeck.map((glyph, index) => (
					<button
						class="memory__card"
						type="button"
						data-mem-card={glyph}
						data-index={index}
						aria-label={`Card ${index + 1}, face down`}
					>
						<span class="memory__card-inner">
							<span class="memory__face memory__face--back" aria-hidden="true">?</span>
							<span class="memory__face memory__face--front" aria-hidden="true">{glyph}</span>
						</span>
					</button>
				))
			}
		</div>
	</div>

	<!-- Status / Win Banner -->
	<div class="memory__status-bar mono" data-mem-status role="status" aria-live="polite">
		Flip two cards to find matching pairs.
	</div>
</div>

<script>
	const host =
		(document.currentScript?.closest?.('[data-memory]') as HTMLElement | null) ??
		document.querySelector<HTMLElement>('[data-memory]');

	if (host) {
		const grid = host.querySelector<HTMLElement>('[data-mem-grid]');
		const movesEl = host.querySelector<HTMLElement>('[data-mem-moves]');
		const pairsEl = host.querySelector<HTMLElement>('[data-mem-pairs]');
		const bestEl = host.querySelector<HTMLElement>('[data-mem-best]');
		const statusEl = host.querySelector<HTMLElement>('[data-mem-status]');
		const resetBtn = host.querySelector<HTMLButtonElement>('[data-mem-reset]');
		const settingsToggle = host.querySelector<HTMLButtonElement>('[data-mem-settings-toggle]');
		const settingsDrawer = host.querySelector<HTMLElement>('[data-mem-settings-drawer]');
		const presetBtns = Array.from(host.querySelectorAll<HTMLButtonElement>('[data-mem-preset]'));

		const themeSelect = host.querySelector<HTMLSelectElement>('[data-mem-setting="theme"]');
		const pairsSlider = host.querySelector<HTMLInputElement>('[data-mem-setting="pairs"]');
		const pairsValText = host.querySelector<HTMLElement>('[data-mem-val="pairs"]');
		const backSelect = host.querySelector<HTMLSelectElement>('[data-mem-setting="back"]');
		const glassSelect = host.querySelector<HTMLSelectElement>('[data-mem-setting="glass"]');
		const audioToggle = host.querySelector<HTMLButtonElement>('[data-mem-audio-toggle]');
		const audioLabel = host.querySelector<HTMLElement>('[data-mem-audio-label]');

		if (grid && movesEl && pairsEl && bestEl && statusEl && resetBtn) {
			// Sound synthesis
			let soundEnabled = true;
			let audioCtx: AudioContext | null = null;
			const getAudioCtx = () => {
				if (!audioCtx) {
					const AudioContextClass =
						window.AudioContext ||
						(window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
					if (AudioContextClass) audioCtx = new AudioContextClass();
				}
				if (audioCtx && audioCtx.state === 'suspended') {
					audioCtx.resume();
				}
				return audioCtx;
			};

			const playFlipSound = () => {
				if (!soundEnabled) return;
				try {
					const ctx = getAudioCtx();
					if (!ctx) return;
					const t = ctx.currentTime;
					const osc = ctx.createOscillator();
					const gain = ctx.createGain();
					osc.type = 'sine';
					osc.frequency.setValueAtTime(380, t);
					osc.frequency.exponentialRampToValueAtTime(190, t + 0.045);
					gain.gain.setValueAtTime(0.14, t);
					gain.gain.exponentialRampToValueAtTime(0.001, t + 0.05);
					osc.connect(gain);
					gain.connect(ctx.destination);
					osc.start(t);
					osc.stop(t + 0.055);
				} catch {}
			};

			const playMatchSound = () => {
				if (!soundEnabled) return;
				try {
					const ctx = getAudioCtx();
					if (!ctx) return;
					const t = ctx.currentTime;
					[523.25, 659.25].forEach((freq, idx) => {
						const osc = ctx.createOscillator();
						const gain = ctx.createGain();
						osc.type = 'triangle';
						osc.frequency.setValueAtTime(freq, t + idx * 0.08);
						gain.gain.setValueAtTime(0, t + idx * 0.08);
						gain.gain.linearRampToValueAtTime(0.18, t + idx * 0.08 + 0.01);
						gain.gain.exponentialRampToValueAtTime(0.001, t + idx * 0.08 + 0.22);
						osc.connect(gain);
						gain.connect(ctx.destination);
						osc.start(t + idx * 0.08);
						osc.stop(t + idx * 0.08 + 0.25);
					});
				} catch {}
			};

			const playWinSound = () => {
				if (!soundEnabled) return;
				try {
					const ctx = getAudioCtx();
					if (!ctx) return;
					const t = ctx.currentTime;
					const notes = [523.25, 659.25, 783.99, 1046.5];
					notes.forEach((freq, idx) => {
						const osc = ctx.createOscillator();
						const gain = ctx.createGain();
						osc.type = 'sine';
						osc.frequency.setValueAtTime(freq, t + idx * 0.09);
						gain.gain.setValueAtTime(0, t + idx * 0.09);
						gain.gain.linearRampToValueAtTime(0.2, t + idx * 0.09 + 0.01);
						gain.gain.exponentialRampToValueAtTime(0.001, t + idx * 0.09 + 0.35);
						osc.connect(gain);
						gain.connect(ctx.destination);
						osc.start(t + idx * 0.09);
						osc.stop(t + idx * 0.09 + 0.4);
					});
				} catch {}
			};

			// Card Theme Glyphs
			const THEMES: Record<string, string[]> = {
				retro: ['◆', '●', '▲', '■', '★', '☾', '✚', '⬟', '✦', '❖', '◈', '☼'],
				kaomoji: [
					'(・_・)',
					'(^_^)',
					'(>_<)',
					'(*_*)',
					'(o_o)',
					'(^o^)',
					'(;_;)',
					'(=^･ω･^=)',
					'(~_~)',
					'(¬_¬)',
					'(ᵔᴥᵔ)',
					'(^з^)',
				],
				oceanic: ['🫧', '🐬', '🪸', '🐚', '🦀', '🌊', '🐠', '🦪', '🦑', '🐙', '🦈', '🐳'],
				cyber: ['⚡', '💾', '🛰️', '🔋', '📡', '💎', '🛸', '🔮', '🕹️', '📟', '🔌', '💿'],
				kawaii: ['🐱', '🦊', '🐰', '🐼', '🐨', '🐯', '🐸', '🦉', '🦋', '🐢', '🦄', '🐝'],
			};

			let currentTheme = 'retro';
			let pairCount = 8;
			let customPairCount = 10;
			let currentBack = '?';
			let first: HTMLButtonElement | null = null;
			let lock = false;
			let moves = 0;
			let matchedPairs = 0;

			const readBest = (pairs: number): number | null => {
				try {
					const val = sessionStorage.getItem(`bnji-mem-best-${pairs}`);
					return val ? Number(val) : null;
				} catch {
					return null;
				}
			};

			const writeBest = (pairs: number, val: number) => {
				try {
					sessionStorage.setItem(`bnji-mem-best-${pairs}`, String(val));
				} catch {}
			};

			const updateBestDisplay = () => {
				const b = readBest(pairCount);
				bestEl.textContent = b !== null ? String(b) : '—';
			};

			const setFace = (card: HTMLButtonElement, up: boolean, matched: boolean) => {
				card.classList.toggle('memory__card--up', up);
				card.classList.toggle('memory__card--done', matched);
				card.setAttribute(
					'aria-label',
					up
						? `Card showing ${card.dataset.memCard}${matched ? ', matched' : ''}`
						: `Card ${Number(card.dataset.index) + 1}, face down`,
				);
			};

			const finish = () => {
				statusEl.textContent = `★ All ${pairCount} pairs matched in ${moves} moves!`;
				playWinSound();
				const prev = readBest(pairCount);
				if (prev === null || moves < prev) {
					writeBest(pairCount, moves);
					bestEl.textContent = String(moves);
					statusEl.textContent += ' New personal best!';
				}
			};

			// Build and shuffle cards
			const renderBoard = () => {
				first = null;
				lock = false;
				moves = 0;
				matchedPairs = 0;
				movesEl.textContent = '0';
				pairsEl.textContent = `0 / ${pairCount}`;
				statusEl.textContent = 'Find all matching pairs.';
				updateBestDisplay();

				const themePool = THEMES[currentTheme] || THEMES.retro;
				const selectedGlyphs = themePool.slice(0, pairCount);
				const deck = [...selectedGlyphs, ...selectedGlyphs]
					.map((glyph, i) => ({ glyph, key: `${glyph}-${i}`, sort: Math.random() }))
					.sort((a, b) => a.sort - b.sort)
					.map((card) => card.glyph);

				// Compute optimal column count
				let cols = 4;
				const total = deck.length;
				if (total <= 8) cols = 4;
				else if (total <= 12) cols = 4;
				else if (total <= 16) cols = 4;
				else if (total <= 20) cols = 5;
				else cols = 6;

				grid.style.setProperty('--mem-cols', String(cols));
				grid.classList.toggle('is-kaomoji', currentTheme === 'kaomoji');

				// Clear existing cards
				// replaceChildren() rather than innerHTML: it clears the same nodes without
			// handing the string to the HTML parser, and the card faces below are
			// rebuilt as elements rather than parsed from markup.
			grid.replaceChildren();

				deck.forEach((glyph, index) => {
					const card = document.createElement('button');
					card.className = 'memory__card';
					card.type = 'button';
					card.dataset.memCard = glyph;
					card.dataset.index = String(index);
					card.setAttribute('aria-label', `Card ${index + 1}, face down`);

					const inner = document.createElement('span');
					inner.className = 'memory__card-inner';

					const back = document.createElement('span');
					back.className = 'memory__face memory__face--back';
					back.setAttribute('aria-hidden', 'true');
					back.textContent = currentBack;

					const front = document.createElement('span');
					front.className = 'memory__face memory__face--front';
					front.setAttribute('aria-hidden', 'true');
					front.textContent = glyph;

					inner.appendChild(back);
					inner.appendChild(front);
					card.appendChild(inner);

					card.addEventListener('click', () => {
						if (lock || card.classList.contains('memory__card--up')) return;
						playFlipSound();
						setFace(card, true, false);

						if (!first) {
							first = card;
							return;
						}

						moves += 1;
						movesEl.textContent = String(moves);
						const a = first;
						first = null;

						if (a.dataset.memCard === card.dataset.memCard) {
							setFace(a, true, true);
							setFace(card, true, true);
							matchedPairs += 1;
							pairsEl.textContent = `${matchedPairs} / ${pairCount}`;
							playMatchSound();

							if (matchedPairs === pairCount) {
								finish();
							}
						} else {
							lock = true;
							setTimeout(() => {
								setFace(a, false, false);
								setFace(card, false, false);
								lock = false;
							}, 600);
						}
					});

					grid.appendChild(card);
				});
			};

			// Initial setup on static template
			renderBoard();

			// Preset mode toggle buttons
			presetBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					const preset = btn.dataset.memPreset;
					if (!preset) return;
					presetBtns.forEach((b) => b.classList.toggle('is-active', b === btn));

					if (preset === 'custom') {
						pairCount = customPairCount;
						if (pairsSlider) pairsSlider.value = String(pairCount);
						if (pairsValText) pairsValText.textContent = `${pairCount} Pairs (${pairCount * 2} Cards)`;
					} else {
						pairCount = parseInt(preset, 10);
						if (pairsSlider) pairsSlider.value = String(pairCount);
						if (pairsValText) pairsValText.textContent = `${pairCount} Pairs (${pairCount * 2} Cards)`;
					}
					renderBoard();
				});
			});

			// Settings Drawer Toggle via dedicated gear button
			settingsToggle?.addEventListener('click', () => {
				if (!settingsDrawer) return;
				const isOpen = !settingsDrawer.hidden;
				settingsDrawer.hidden = isOpen;
				settingsToggle.setAttribute('aria-expanded', String(!isOpen));
				settingsToggle.classList.toggle('is-open', !isOpen);
			});

			// Settings listeners
			themeSelect?.addEventListener('change', () => {
				currentTheme = themeSelect.value;
				renderBoard();
			});

			pairsSlider?.addEventListener('input', () => {
				pairCount = parseInt(pairsSlider.value, 10);
				customPairCount = pairCount;
				if (pairsValText) {
					pairsValText.textContent = `${pairCount} Pairs (${pairCount * 2} Cards)`;
				}
				// Activate custom preset pill
				presetBtns.forEach((b) =>
					b.classList.toggle('is-active', b.dataset.memPreset === 'custom'),
				);
				renderBoard();
			});

			backSelect?.addEventListener('change', () => {
				currentBack = backSelect.value;
				const backs = grid.querySelectorAll<HTMLElement>('.memory__face--back');
				backs.forEach((b) => (b.textContent = currentBack));
			});

			glassSelect?.addEventListener('change', () => {
				host.dataset.glassVariant = glassSelect.value;
			});

			audioToggle?.addEventListener('click', () => {
				soundEnabled = !soundEnabled;
				audioToggle.setAttribute('aria-pressed', String(soundEnabled));
				audioToggle.classList.toggle('is-active', soundEnabled);
				if (audioLabel) audioLabel.textContent = soundEnabled ? 'Sound: On' : 'Sound: Off';
			});

			resetBtn.addEventListener('click', () => {
				renderBoard();
			});
		}
	}
</script>

<style>
	.memory {
		position: relative;
		display: grid;
		gap: 0.9rem;
		padding: 1.25rem;
		border-radius: var(--radius-lg);
		background: var(--glass-bg-quiet);
		border: 1px solid var(--glass-border);
		box-shadow: var(--glass-shadow-raised);
		overflow: hidden;
		user-select: none;
	}

	/* Concentric subtle optical grid */
	.memory__backdrop {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		opacity: 0.28;
	}
	.memory__grid-mesh {
		inline-size: 100%;
		block-size: 100%;
		background-image:
			linear-gradient(to right, var(--glass-border) 1px, transparent 1px),
			linear-gradient(to bottom, var(--glass-border) 1px, transparent 1px);
		background-size: 24px 24px;
	}

	/* Top Toolbar */
	.memory__toolbar {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		flex-wrap: wrap;
		padding: 0.55rem 0.85rem;
		border-radius: var(--radius-md);
		border: 1px solid var(--glass-border);
		background: var(--glass-bg);
	}

	.memory__hud {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		font-size: var(--text-micro);
		letter-spacing: var(--tracking-mono);
	}
	.memory__hud-item {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}
	.hud-label {
		color: var(--text-dim);
		font-size: 0.65rem;
	}
	.memory__hud b {
		color: var(--text-strong);
		font-size: 0.92rem;
		font-weight: 700;
	}

	.memory__quick-actions {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-wrap: wrap;
	}

	.memory__tool-btn {
		padding: 0.32rem 0.65rem;
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-pill);
		background: var(--glass-bg-quiet);
		color: var(--text-muted);
		font-size: var(--text-micro);
		letter-spacing: var(--tracking-mono);
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
