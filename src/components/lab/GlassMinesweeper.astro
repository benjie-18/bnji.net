---
/**
 * Lab — Glass Minesweeper.
 *
 * Classic Minesweeper reimagined in authentic Apple Liquid Glass aesthetic.
 *
 * Architecture & Dynamic Features:
 * - Adaptive grid engine: dynamically scales down so 16×14 Expert or any custom size always fits without overflowing
 * - Sleek Liquid Glass Settings drawer: custom grid dimensions, mine density, emoji themes, and glass materials
 * - 5 Emoji themes: Liquid Aero, Cyber Synth, Oceanic Crystal, Kawaii Cat, Retro Classic
 * - 3 Glass material finishes: Crystal Clear, Frosted Milk, Prism Aurora
 * - High-contrast Light Mode: deep royal sapphire, jade, ruby, and violet numbers with crisp delimitation
 * - Raised HUD chassis with dark crystal counters and reactive circular liquid lens smiley face
 * - Safe first-click guarantee with auto-cascade clearing
 * - Web Audio harmonic sound generator
 */
---

<div class="glass-minesweeper" data-minesweeper>
	<!-- Status HUD Header -->
	<div class="ms-hud" data-glass="raised">
		<!-- Mine Counter -->
		<div class="ms-counter mono" aria-label="Remaining Mines">
			<span class="ms-counter-label">MINES</span>
			<span class="ms-digits" data-ms-mines>010</span>
		</div>

		<!-- Status / Reset Face -->
		<button class="ms-face-button mono" type="button" data-glass="interactive" data-ms-face aria-label="Reset Minesweeper game">
			<span class="ms-face-emoji" data-ms-face-icon>(◕‿◕)</span>
		</button>

		<!-- Elapsed Timer -->
		<div class="ms-counter mono" aria-label="Elapsed Time">
			<span class="ms-counter-label">TIME</span>
			<span class="ms-digits" data-ms-time>000</span>
		</div>
	</div>

	<!-- Mode & Difficulty Toolbar -->
	<div class="ms-toolbar">
		<div class="ms-difficulties" role="radiogroup" aria-label="Game Difficulty">
			<button class="difficulty-btn mono is-active" type="button" data-ms-diff="easy">
				Beginner (9×9)
			</button>
			<button class="difficulty-btn mono" type="button" data-ms-diff="medium">
				Intermediate (12×12)
			</button>
			<button class="difficulty-btn mono" type="button" data-ms-diff="hard">
				Expert (16×14)
			</button>
			<button class="difficulty-btn mono" type="button" data-ms-diff="custom">
				Custom
			</button>
		</div>

		<div class="ms-tools">
			<button class="glass-button glass-button--sm mono" type="button" data-ms-flag-toggle aria-pressed="false">
				<span data-ms-flag-label>Mode: ⛏ Dig</span>
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-ms-audio aria-pressed="true">
				<span class="dot dot--live" data-ms-audio-dot></span> Sound
			</button>
			<button class="glass-button glass-button--sm mono" type="button" data-ms-settings-toggle aria-expanded="false" aria-label="Toggle game settings">
				⚙ Settings
			</button>
		</div>
	</div>

	<!-- Collapsible Liquid Glass Settings Drawer -->
	<div class="ms-settings-drawer" data-ms-settings-drawer hidden>
		<div class="ms-settings-panel" data-glass="quiet">
			<div class="ms-settings-header">
				<span class="mono text-muted ms-settings-title">CUSTOM CONFIGURATION & THEMES</span>
				<button class="glass-button glass-button--sm mono" type="button" data-ms-settings-close>Close ✕</button>
			</div>

			<div class="ms-settings-grid">
				<label class="lab-control">
					<span class="lab-control__label">
						Columns <output data-ms-out="cols">9 Cols</output>
					</span>
					<input class="lab-range" type="range" min="8" max="20" step="1" value="9" data-ms-in="cols" />
				</label>

				<label class="lab-control">
					<span class="lab-control__label">
						Rows <output data-ms-out="rows">9 Rows</output>
					</span>
					<input class="lab-range" type="range" min="8" max="16" step="1" value="9" data-ms-in="rows" />
				</label>

				<label class="lab-control">
					<span class="lab-control__label">
						Mines <output data-ms-out="mines">10 Mines (12%)</output>
					</span>
					<input class="lab-range" type="range" min="5" max="45" step="1" value="10" data-ms-in="mines" />
				</label>

				<label class="lab-control">
					<span class="lab-control__label">
						Emoji Theme <output data-ms-out="theme">Liquid Aero</output>
					</span>
					<select class="lab-select mono" data-ms-in="theme">
						<option value="aero" selected>Liquid Aero (Kaomoji)</option>
						<option value="cyber">Cyber Synth (Robot & EMP)</option>
						<option value="ocean">Oceanic Crystal (Bubbles & Torpedo)</option>
						<option value="kawaii">Kawaii Cat (Kitten & Paw)</option>
						<option value="retro">Retro Classic (Smiley & Mine)</option>
					</select>
				</label>

				<label class="lab-control">
					<span class="lab-control__label">
						Glass Material <output data-ms-out="glass">Crystal Clear</output>
					</span>
					<select class="lab-select mono" data-ms-in="glass">
						<option value="clear" selected>Crystal Clear (Translucent)</option>
						<option value="frosted">Frosted Milk (Deep Diffusion)</option>
						<option value="prism">Prism Aurora (Iridescent)</option>
					</select>
				</label>

				<div class="ms-settings-actions">
					<button class="glass-button mono is-accent" type="button" data-ms-apply-custom>
						Apply & Start Game
					</button>
				</div>
			</div>
		</div>
	</div>

	<!-- Minesweeper Grid Viewport (Adaptive Optical Stage) -->
	<div class="ms-board-viewport" data-ms-viewport>
		<div
			class="ms-grid"
			data-glass="panel"
			data-ms-grid
			role="grid"
			aria-label="Minesweeper Board"
			style="--grid-cols: 9; --grid-rows: 9; --cell-font-size: 1.4rem; --cell-radius: 9px; --cell-border: 2.2px;"
		>
			{
				Array.from({ length: 81 }).map((_, i) => (
					<button
						type="button"
						class="ms-cell mono is-unrevealed"
						data-glass="interactive clear"
						data-r={Math.floor(i / 9)}
						data-c={i % 9}
						role="gridcell"
						aria-label={`Tile ${Math.floor(i / 9) + 1}, ${(i % 9) + 1} (unrevealed)`}
					/>
				))
			}
		</div>
	</div>

	<!-- Footer Hint -->
	<div class="lab-hint mono">
		Left-click to reveal · Right-click or toggle Flag mode to plant 🚩 · First tap is always safe
	</div>
</div>

<script>
	interface CellData {
		r: number;
		c: number;
		isMine: boolean;
		isRevealed: boolean;
		isFlagged: boolean;
		count: number;
	}

	interface DifficultyConfig {
		rows: number;
		cols: number;
		mines: number;
	}

	interface EmojiTheme {
		name: string;
		normal: string;
		pressed: string;
		dead: string;
		won: string;
		mine: string;
		flag: string;
		empty: string;
	}

	const DIFFICULTIES: Record<string, DifficultyConfig> = {
		easy: { rows: 9, cols: 9, mines: 10 },
		medium: { rows: 12, cols: 12, mines: 24 },
		hard: { rows: 14, cols: 16, mines: 40 },
	};

	const EMOJI_THEMES: Record<string, EmojiTheme> = {
		aero: {
			name: 'Liquid Aero',
			normal: '(◕‿◕)',
			pressed: '(・_・)',
			dead: '(×_×)',
			won: '(★‿★)',
			mine: '💣',
			flag: '🚩',
			empty: '·',
		},
		cyber: {
			name: 'Cyber Synth',
			normal: '🤖',
			pressed: '⚡',
			dead: '💀',
			won: '👑',
			mine: '💥',
			flag: '💠',
			empty: '◇',
		},
		ocean: {
			name: 'Oceanic Crystal',
			normal: '🫧',
			pressed: '🌊',
			dead: '🦈',
			won: '💎',
			mine: '🐡',
			flag: '⚓',
			empty: '°',
		},
		kawaii: {
			name: 'Kawaii Cat',
			normal: '🐱',
			pressed: '🙀',
			dead: '😿',
			won: '😻',
			mine: '🐾',
			flag: '🐟',
			empty: '·',
		},
		retro: {
			name: 'Retro Classic',
			normal: '🙂',
			pressed: '😮',
			dead: '😵',
			won: '😎',
			mine: '💣',
			flag: '🚩',
			empty: '·',
		},
	};

	const root = document.querySelector<HTMLElement>('[data-minesweeper]');
	if (root) {
		const gridEl = root.querySelector<HTMLElement>('[data-ms-grid]')!;
		const minesEl = root.querySelector<HTMLElement>('[data-ms-mines]')!;
		const timeEl = root.querySelector<HTMLElement>('[data-ms-time]')!;
		const faceBtn = root.querySelector<HTMLButtonElement>('[data-ms-face]')!;
		const faceIcon = root.querySelector<HTMLElement>('[data-ms-face-icon]')!;
		const flagToggleBtn = root.querySelector<HTMLButtonElement>('[data-ms-flag-toggle]')!;
		const flagLabel = root.querySelector<HTMLElement>('[data-ms-flag-label]')!;
		const audioBtn = root.querySelector<HTMLButtonElement>('[data-ms-audio]')!;
		const audioDot = root.querySelector<HTMLElement>('[data-ms-audio-dot]')!;
		const settingsToggleBtn = root.querySelector<HTMLButtonElement>('[data-ms-settings-toggle]')!;
		const settingsCloseBtn = root.querySelector<HTMLButtonElement>('[data-ms-settings-close]')!;
		const settingsDrawer = root.querySelector<HTMLElement>('[data-ms-settings-drawer]')!;
		const diffBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-ms-diff]'));

		// Settings inputs & outputs
		const colsIn = root.querySelector<HTMLInputElement>('[data-ms-in="cols"]');
		const colsOut = root.querySelector<HTMLOutputElement>('[data-ms-out="cols"]');
		const rowsIn = root.querySelector<HTMLInputElement>('[data-ms-in="rows"]');
		const rowsOut = root.querySelector<HTMLOutputElement>('[data-ms-out="rows"]');
		const minesIn = root.querySelector<HTMLInputElement>('[data-ms-in="mines"]');
		const minesOut = root.querySelector<HTMLOutputElement>('[data-ms-out="mines"]');
		const themeIn = root.querySelector<HTMLSelectElement>('[data-ms-in="theme"]');
		const themeOut = root.querySelector<HTMLOutputElement>('[data-ms-out="theme"]');
		const glassIn = root.querySelector<HTMLSelectElement>('[data-ms-in="glass"]');
		const glassOut = root.querySelector<HTMLOutputElement>('[data-ms-out="glass"]');
		const applyCustomBtn = root.querySelector<HTMLButtonElement>('[data-ms-apply-custom]');

		let currentDiff = 'easy';
		let rows = 9;
		let cols = 9;
		let totalMines = 10;
		let activeThemeKey = 'aero';
		let activeGlassKey = 'clear';

		let board: CellData[][] = [];
		let isFirstClick = true;
		let isGameOver = false;
		let isGameWon = false;
		let isFlagMode = false;
		let audioEnabled = true;

		let flagsPlaced = 0;
		let cellsRevealed = 0;
		let timerId: number | null = null;
		let elapsedSeconds = 0;

		const getTheme = () => EMOJI_THEMES[activeThemeKey] || EMOJI_THEMES.aero;

		/* Cell glyphs are written with textContent / replaceChildren, never
		   innerHTML. Every value here is a literal out of EMOJI_THEMES above,
		   so there is no injection surface today — but textContent cannot parse
		   a payload even if one is ever threaded in, and it skips an HTML parse
		   on every cell of every reveal. The .empty-dot wrapper genuinely needs
		   an element, so it is built and appended rather than serialised from a
		   template string. */
		const setGlyph = (btn: HTMLButtonElement, glyph: string) => {
			btn.textContent = glyph;
		};
		const setDot = (btn: HTMLButtonElement, glyph: string) => {
			const dot = document.createElement('span');
			dot.className = 'empty-dot';
			dot.textContent = glyph;
			btn.replaceChildren(dot);
		};
		let audioCtx: AudioContext | null = null;
		const getAudioContext = () => {
			if (!audioCtx) {
				const AudioClass = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
				audioCtx = new AudioClass();
			}
			if (audioCtx.state === 'suspended') {
				audioCtx.resume();
			}
			return audioCtx;
		};

		const playSound = (freq: number, type: OscillatorType = 'sine', duration = 0.12) => {
			if (!audioEnabled) return;
			try {
				const ctx = getAudioContext();
				const t = ctx.currentTime;
				const osc = ctx.createOscillator();
				const gain = ctx.createGain();

				osc.type = type;
				osc.frequency.setValueAtTime(freq, t);

				gain.gain.setValueAtTime(0.12, t);
				gain.gain.exponentialRampToValueAtTime(0.001, t + duration);

				osc.connect(gain);
				gain.connect(ctx.destination);

				osc.start(t);
				osc.stop(t + duration);
			} catch {}
		};

		const startTimer = () => {
			if (timerId !== null) return;
			elapsedSeconds = 0;
			timerId = window.setInterval(() => {
				elapsedSeconds = Math.min(999, elapsedSeconds + 1);
				timeEl.textContent = String(elapsedSeconds).padStart(3, '0');
			}, 1000);
		};

		const stopTimer = () => {
			if (timerId !== null) {
				clearInterval(timerId);
				timerId = null;
			}
		};

		const setFace = (state: 'normal' | 'pressed' | 'dead' | 'won') => {
			if (!faceIcon) return;
			const theme = getTheme();
			faceIcon.textContent = theme[state];
		};

		const updateMinesDisplay = () => {
			const remaining = Math.max(-99, totalMines - flagsPlaced);
			minesEl.textContent = remaining < 0 ? `-${String(Math.abs(remaining)).padStart(2, '0')}` : String(remaining).padStart(3, '0');
		};

		const updateInputs = () => {
			if (colsIn) colsIn.value = String(cols);
			if (colsOut) colsOut.textContent = `${cols} Cols`;
			if (rowsIn) rowsIn.value = String(rows);
			if (rowsOut) rowsOut.textContent = `${rows} Rows`;

			const maxM = Math.max(5, rows * cols - 9);
			if (minesIn) {
				minesIn.max = String(maxM);
				minesIn.value = String(totalMines);
			}
			if (minesOut) {
				const pct = Math.round((totalMines / (rows * cols)) * 100);
				minesOut.textContent = `${totalMines} Mines (${pct}%)`;
			}
		};

		const createBoard = () => {
			board = [];
			for (let r = 0; r < rows; r++) {
				const row: CellData[] = [];
				for (let c = 0; c < cols; c++) {
					row.push({
						r,
						c,
						isMine: false,
						isRevealed: false,
						isFlagged: false,
						count: 0,
					});
				}
				board.push(row);
			}
		};

		const seedMines = (safeR: number, safeC: number) => {
			let planted = 0;
			const maxPossible = rows * cols - 1;
			const targetMines = Math.min(totalMines, maxPossible);

			while (planted < targetMines) {
				const r = Math.floor(Math.random() * rows);
				const c = Math.floor(Math.random() * cols);

				if (Math.abs(r - safeR) <= 1 && Math.abs(c - safeC) <= 1) {
					continue;
				}

				if (!board[r][c].isMine) {
					board[r][c].isMine = true;
					planted++;
				}
			}

			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					if (board[r][c].isMine) continue;
					let count = 0;
					for (let dr = -1; dr <= 1; dr++) {
						for (let dc = -1; dc <= 1; dc++) {
							const nr = r + dr;
							const nc = c + dc;
							if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && board[nr][nc].isMine) {
								count++;
							}
						}
					}
					board[r][c].count = count;
				}
			}
		};

		const renderDOM = () => {
			gridEl.replaceChildren();
			gridEl.style.setProperty('--grid-cols', String(cols));
			gridEl.style.setProperty('--grid-rows', String(rows));

			// Dynamically scale cell font and radius so large grids fit flawlessly
			const cellFontRem = Math.max(0.68, Math.min(1.45, 13.5 / cols));
			const cellRadiusPx = Math.max(4, Math.min(10, Math.round(90 / cols)));
			const cellBorderPx = cols > 13 ? 1.5 : 2.2;

			gridEl.style.setProperty('--cell-font-size', `${cellFontRem.toFixed(2)}rem`);
			gridEl.style.setProperty('--cell-radius', `${cellRadiusPx}px`);
			gridEl.style.setProperty('--cell-border', `${cellBorderPx}px`);

			// Update glass material attribute on grid container
			gridEl.setAttribute('data-glass-theme', activeGlassKey);

			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'ms-cell mono is-unrevealed';
					btn.setAttribute('data-glass', 'interactive clear');
					btn.dataset.r = String(r);
					btn.dataset.c = String(c);
					btn.setAttribute('role', 'gridcell');
					btn.setAttribute('aria-label', `Tile ${r + 1}, ${c + 1} (unrevealed)`);
					gridEl.appendChild(btn);
				}
			}
		};

		// Event delegation on grid container
		gridEl.addEventListener('click', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ms-cell');
			if (!btn) return;
			e.preventDefault();
			const r = Number(btn.dataset.r);
			const c = Number(btn.dataset.c);
			if (isFlagMode) {
				toggleFlag(r, c);
			} else {
				revealCell(r, c);
			}
		});

		gridEl.addEventListener('contextmenu', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ms-cell');
			if (!btn) return;
			e.preventDefault();
			const r = Number(btn.dataset.r);
			const c = Number(btn.dataset.c);
			toggleFlag(r, c);
		});

		gridEl.addEventListener('pointerdown', (e) => {
			const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.ms-cell');
			if (btn && !isGameOver && !isGameWon) setFace('pressed');
		});

		window.addEventListener('pointerup', () => {
			if (!isGameOver && !isGameWon) setFace('normal');
		});

		const getCellButton = (r: number, c: number): HTMLButtonElement | null => {
			return gridEl.querySelector<HTMLButtonElement>(`[data-r="${r}"][data-c="${c}"]`);
		};

		const revealCell = (r: number, c: number) => {
			if (isGameOver || isGameWon) return;
			const cell = board[r][c];
			if (cell.isRevealed || cell.isFlagged) return;

			if (isFirstClick) {
				isFirstClick = false;
				seedMines(r, c);
				startTimer();
			}

			cell.isRevealed = true;
			cellsRevealed++;
			const btn = getCellButton(r, c);
			if (!btn) return;

			btn.classList.remove('is-unrevealed');
			btn.classList.add('is-revealed');
			btn.removeAttribute('data-glass');
			btn.setAttribute('aria-expanded', 'true');

			const theme = getTheme();

			if (cell.isMine) {
				btn.classList.add('is-detonated');
				setGlyph(btn, '💥');
				gameOver(false);
				return;
			}

			playSound(340 + cell.count * 45, 'sine', 0.1);

			if (cell.count > 0) {
				btn.textContent = String(cell.count);
				btn.dataset.count = String(cell.count);
				btn.setAttribute('aria-label', `${cell.count} adjacent mines`);
			} else {
				// Empty safe cell: mark with dot indicator
				btn.classList.add('is-empty');
				setDot(btn, theme.empty);
				btn.setAttribute('aria-label', 'Empty cleared tile');

				// Cascade neighbors
				for (let dr = -1; dr <= 1; dr++) {
					for (let dc = -1; dc <= 1; dc++) {
						const nr = r + dr;
						const nc = c + dc;
						if (nr >= 0 && nr < rows && nc >= 0 && nc < cols) {
							if (!board[nr][nc].isRevealed) {
								revealCell(nr, nc);
							}
						}
					}
				}
			}

			checkWinCondition();
		};

		const toggleFlag = (r: number, c: number) => {
			if (isGameOver || isGameWon) return;
			const cell = board[r][c];
			if (cell.isRevealed) return;

			const btn = getCellButton(r, c);
			if (!btn) return;

			const theme = getTheme();
			cell.isFlagged = !cell.isFlagged;
			if (cell.isFlagged) {
				flagsPlaced++;
				btn.classList.add('is-flagged');
				setGlyph(btn, theme.flag);
				btn.setAttribute('aria-label', `Tile ${r + 1}, ${c + 1} (flagged)`);
				playSound(520, 'triangle', 0.08);
			} else {
				flagsPlaced--;
				btn.classList.remove('is-flagged');
				btn.replaceChildren();
				btn.setAttribute('aria-label', `Tile ${r + 1}, ${c + 1} (unrevealed)`);
				playSound(380, 'triangle', 0.08);
			}

			updateMinesDisplay();
		};

		const checkWinCondition = () => {
			const safeTilesTotal = rows * cols - totalMines;
			if (cellsRevealed === safeTilesTotal) {
				gameOver(true);
			}
		};

		const gameOver = (won: boolean) => {
			stopTimer();
			const theme = getTheme();
			if (won) {
				isGameWon = true;
				setFace('won');
				playSound(587.33, 'triangle', 0.15);
				setTimeout(() => playSound(880, 'sine', 0.35), 140);

				for (let r = 0; r < rows; r++) {
					for (let c = 0; c < cols; c++) {
						if (board[r][c].isMine) {
							const btn = getCellButton(r, c);
							if (btn && !board[r][c].isFlagged) {
								setGlyph(btn, theme.flag);
								btn.classList.add('is-flagged');
							}
						}
					}
				}
				minesEl.textContent = '000';
			} else {
				isGameOver = true;
				setFace('dead');
				playSound(180, 'sawtooth', 0.35);

				for (let r = 0; r < rows; r++) {
					for (let c = 0; c < cols; c++) {
						const cell = board[r][c];
						const btn = getCellButton(r, c);
						if (!btn) continue;

						if (cell.isMine && !cell.isRevealed) {
							btn.classList.remove('is-unrevealed');
							btn.classList.add('is-mine-revealed');
							btn.removeAttribute('data-glass');
							setGlyph(btn, theme.mine);
						} else if (!cell.isMine && cell.isFlagged) {
							btn.classList.add('is-wrong-flag');
							setGlyph(btn, '❌');
						}
					}
				}
			}
		};

		const resetGame = () => {
			stopTimer();
			isFirstClick = true;
			isGameOver = false;
			isGameWon = false;
			flagsPlaced = 0;
			cellsRevealed = 0;
			elapsedSeconds = 0;
			timeEl.textContent = '000';
			updateMinesDisplay();
			setFace('normal');
			updateInputs();
			createBoard();
			renderDOM();
		};

		faceBtn.addEventListener('click', resetGame);

		flagToggleBtn.addEventListener('click', () => {
			isFlagMode = !isFlagMode;
			flagToggleBtn.setAttribute('aria-pressed', String(isFlagMode));
			if (flagLabel) {
				const theme = getTheme();
				flagLabel.textContent = isFlagMode ? `Mode: ${theme.flag} Flag` : 'Mode: ⛏ Dig';
			}
			flagToggleBtn.classList.toggle('is-active', isFlagMode);
		});

		audioBtn.addEventListener('click', () => {
			audioEnabled = !audioEnabled;
			audioBtn.setAttribute('aria-pressed', String(audioEnabled));
			audioDot.classList.toggle('dot--live', audioEnabled);
		});

		// Settings drawer toggle
		const toggleSettings = (force?: boolean) => {
			const isHidden = settingsDrawer ? settingsDrawer.hidden : false;
			const nextState = force !== undefined ? !force : isHidden;
			if (settingsDrawer) settingsDrawer.hidden = !nextState;
			settingsToggleBtn.setAttribute('aria-expanded', String(nextState));
			settingsToggleBtn.classList.toggle('is-active', nextState);
		};

		settingsToggleBtn?.addEventListener('click', () => toggleSettings());
		settingsCloseBtn?.addEventListener('click', () => toggleSettings(false));

		diffBtns.forEach((btn) => {
			btn.addEventListener('click', () => {
				const d = btn.dataset.msDiff || 'easy';
				diffBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
				currentDiff = d;

				if (d === 'custom') {
					toggleSettings(true);
					return;
				}

				const cfg = DIFFICULTIES[d];
				if (!cfg) return;

				rows = cfg.rows;
				cols = cfg.cols;
				totalMines = cfg.mines;
				resetGame();
			});
		});

		// Custom Sliders
		colsIn?.addEventListener('input', () => {
			const c = Number(colsIn.value);
			if (colsOut) colsOut.textContent = `${c} Cols`;
			const maxM = Math.max(5, c * Number(rowsIn?.value || rows) - 9);
			if (minesIn) minesIn.max = String(maxM);
		});

		rowsIn?.addEventListener('input', () => {
			const r = Number(rowsIn.value);
			if (rowsOut) rowsOut.textContent = `${r} Rows`;
			const maxM = Math.max(5, r * Number(colsIn?.value || cols) - 9);
			if (minesIn) minesIn.max = String(maxM);
		});

		minesIn?.addEventListener('input', () => {
			const m = Number(minesIn.value);
			const totalCells = Number(colsIn?.value || cols) * Number(rowsIn?.value || rows);
			const pct = Math.round((m / totalCells) * 100);
			if (minesOut) minesOut.textContent = `${m} Mines (${pct}%)`;
		});

		themeIn?.addEventListener('change', () => {
			activeThemeKey = themeIn.value;
			if (themeOut) themeOut.textContent = themeIn.options[themeIn.selectedIndex].text.split(' (')[0];
			setFace(isGameOver ? 'dead' : isGameWon ? 'won' : 'normal');

			// Refresh visible flags & mines with the new theme
			const theme = getTheme();
			for (let r = 0; r < rows; r++) {
				for (let c = 0; c < cols; c++) {
					const cell = board[r][c];
					const btn = getCellButton(r, c);
					if (!btn) continue;
					if (cell.isFlagged) {
						setGlyph(btn, theme.flag);
					} else if (cell.isRevealed && cell.count === 0) {
						setDot(btn, theme.empty);
					} else if (isGameOver && cell.isMine) {
						setGlyph(btn, theme.mine);
					}
				}
			}
			if (flagLabel) {
				flagLabel.textContent = isFlagMode ? `Mode: ${theme.flag} Flag` : 'Mode: ⛏ Dig';
			}
		});

		glassIn?.addEventListener('change', () => {
			activeGlassKey = glassIn.value;
			if (glassOut) glassOut.textContent = glassIn.options[glassIn.selectedIndex].text.split(' (')[0];
			gridEl.setAttribute('data-glass-theme', activeGlassKey);
		});

		applyCustomBtn?.addEventListener('click', () => {
			cols = Number(colsIn?.value || 9);
			rows = Number(rowsIn?.value || 9);
			const maxM = Math.max(5, rows * cols - 9);
			totalMines = Math.min(Number(minesIn?.value || 10), maxM);

			currentDiff = 'custom';
			diffBtns.forEach((b) => b.classList.toggle('is-active', b.dataset.msDiff === 'custom'));
			toggleSettings(false);
			resetGame();
		});

		resetGame();
	}
</script>

