---
/**
 * HeaderLink — a navigation link that knows whether it is the current page.
 *
 * Active detection is prefix-based (except for the home route, which must match
 * exactly) so a blog post such as /blog/first-post/ keeps "Blog" highlighted.
 * The active state is exposed to assistive tech with aria-current="page", not
 * just with colour.
 */
interface Props {
	href: string;
	/** Defaults to the current request path; pass it explicitly in tests. */
	currentPath?: string;
	class?: string;
}

const { href, currentPath = Astro.url.pathname, class: className = '' } = Astro.props;

const path = currentPath.replace(/index\.html$/, '');
const isRoot = href === '/';
const isActive = isRoot ? path === '/' : path === href || path.startsWith(href);
---

<a
	href={href}
	class:list={['nav-link', className, { 'is-active': isActive }]}
	aria-current={isActive ? 'page' : undefined}
>
	<slot />
</a>

<style>
	.nav-link {
		display: inline-flex;
		align-items: center;
		padding: 0.42em 0.85em;
		border-radius: var(--radius-pill);
		border: 1px solid transparent;
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 450;
		letter-spacing: 0.004em;
		line-height: 1.3;
		color: var(--text-muted);
		text-decoration: none;
		white-space: nowrap;
		transition:
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	/* Hover/active washes come from the --nav-* surface tokens so both themes
	   stay visible: white film on the dark void, accent wash on the Aero sky. */
	@media (hover: hover) and (pointer: fine) {
		.nav-link:hover {
			color: var(--text-strong);
			background: var(--nav-hover);
		}
	}

	/* Active page: a filled pill plus brighter text. Never colour alone, so the
	   state survives greyscale and colour-vision differences. */
	.nav-link.is-active {
		color: var(--text-strong);
		background: var(--nav-active);
		border-color: var(--glass-border);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
	}

	.nav-link:focus-visible {
		color: var(--text-strong);
		outline-offset: 2px;
	}

	/* Dropdown variant: Header.astro passes class="nav-dropdown__link" for
	   links inside a nav dropdown panel — full-width rows, softer radius, the
	   same hover/active states as any other nav link. */
	.nav-dropdown__link {
		inline-size: 100%;
		justify-content: flex-start;
		padding: 0.5em 0.85em;
		border-radius: var(--radius-md);
	}

	/* Mobile nav sheet. `.nav-list` is rendered by Header.astro — Astro scopes
	   only the last part of a descendant selector, so this rule matches Header's
	   container while the class it styles stays owned by this component. That is
	   deliberate: every `.nav-link` rule lives in this one file. */
	@media (max-width: 899px) {
		.nav-list .nav-link {
			inline-size: 100%;
			justify-content: flex-start;
			padding: 0.72em 0.95em;
			font-size: 1rem;
			border-radius: var(--radius-md);
		}
	}
</style>
