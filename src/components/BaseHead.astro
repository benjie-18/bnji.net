---
/**
 * BaseHead — every document <head> concern, in one component.
 *
 * Title, description, canonical URL, Open Graph, Twitter/X, favicon, theme
 * colour, feed discovery, font preloads and JSON-LD all come from here, fed by
 * src/data/site.ts. Pages pass at most a title and a description; nothing is
 * hand-duplicated per page.
 *
 * Canonical rule: URLs are resolved against SITE.url, never against Astro.url.
 * Deriving them from the request would leak whatever host served the page —
 * localhost in dev, the *.workers.dev preview host on a branch deployment.
 */
import '../styles/global.css';
import '../styles/aero.css';
import { SITE, absoluteUrl, pageTitle } from '../data/site';

interface Props {
	/** Page title. Omit on the homepage; it already carries the site title. */
	title?: string;
	description?: string;
	/** Absolute or root-relative image. Defaults to the branded cover. */
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: Date | string;
	modifiedTime?: Date | string;
	/** True for pages that should stay out of search indexes. */
	noindex?: boolean;
}

const {
	title,
	description = SITE.description,
	image = SITE.defaultImage,
	type = 'website',
	publishedTime,
	modifiedTime,
	noindex = false,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = absoluteUrl(Astro.url.pathname.replace(/index\.html$/, ''));
const ogImage = absoluteUrl(image);

/*
 * The two theme colours, handed to the pre-paint script below through
 * define:vars so this file keeps a single source of truth. The object must be
 * FLAT: Astro emits one `const` per top-level key, so nesting these under a
 * single key would leave the script referencing identifiers that were never
 * declared. See the comment on that script for why they cannot simply be
 * interpolated into the markup.
 */

function toIso(value?: Date | string): string | undefined {
	if (!value) return undefined;
	const date = value instanceof Date ? value : new Date(value);
	return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
}

/** Compact identity graph. Keeps search results consistent with the site. */
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			name: SITE.author.name,
			url: absoluteUrl('/'),
			description: SITE.author.role,
			address: { '@type': 'PostalAddress', addressLocality: SITE.author.location },
			sameAs: [SITE.github],
		},
		{
			'@type': 'WebSite',
			name: SITE.fullName,
			url: absoluteUrl('/'),
			inLanguage: SITE.locale,
			author: { '@type': 'Person', name: SITE.author.name },
		},
		...(type === 'article'
			? [
					{
						'@type': 'BlogPosting',
						headline: fullTitle,
						description,
						image: ogImage,
						url: canonical,
						datePublished: toIso(publishedTime),
						dateModified: toIso(modifiedTime) ?? toIso(publishedTime),
						author: { '@type': 'Person', name: SITE.author.name },
					},
				]
			: []),
	],
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="generator" content={Astro.generator} />

<!-- Progressive enhancement flag + settings pre-paint. Inline and un-bundled
     on purpose: this must run synchronously BEFORE first paint, so the theme
     and every effects-state flag are already correct on frame one — no flash
     of the wrong theme, no intro that starts and then stops. It reads the
     same localStorage key as scripts/settings.ts (the settings store) and
     mirrors its applySettingsToRoot() contract; the store re-applies the
     same values at boot, idempotently. The legacy standalone theme key
     ('bnji-theme') is honoured as a migration fallback. -->
<!--
  theme-color and color-scheme are emitted BEFORE the pre-paint script below,
  because that script queries them. The parser has not reached them at that
  point, so the assignment was silently doing nothing and the browser chrome
  kept the dark value until boot() ran. Declaring the tags first is what makes
  the pre-paint swap observable in the same frame as the theme itself.
-->
<meta name="theme-color" content={SITE.themeColor} />
<meta name="color-scheme" content="dark light" />

<script
	is:inline
	define:vars={{
		THEME_COLOR_DARK: SITE.themeColor,
		THEME_COLOR_LIGHT: SITE.themeColorLight,
	}}
>
	(function () {
		var root = document.documentElement;
		root.classList.add('js');
		var s = null;
		try {
			var raw = localStorage.getItem('bnji-settings-v1');
			if (raw) s = JSON.parse(raw);
		} catch (e) {}
		var flag = function (key, fallback) {
			return s && typeof s[key] === 'boolean' ? s[key] : fallback;
		};
		var theme = s && (s.theme === 'light' || s.theme === 'dark') ? s.theme : null;
		if (!theme) {
			try {
				theme = localStorage.getItem('bnji-theme') === 'light' ? 'light' : 'dark';
			} catch (e) {
				theme = 'dark';
			}
		}
		root.dataset.theme = theme;
		// THEME_COLOR_LIGHT / THEME_COLOR_DARK are injected by define:vars
		// from SITE.themeColor / SITE.themeColorLight. They have to arrive
		// this way: an `is:inline` script is emitted verbatim, so it cannot
		// import from src/data/site.ts, and a bare frontmatter const is NOT
		// in scope inside it — define:vars is the supported way to hand
		// values across that boundary.
		var meta = document.querySelector('meta[name="theme-color"]');
		if (meta) meta.content = theme === 'light' ? THEME_COLOR_LIGHT : THEME_COLOR_DARK;
		var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		if (!flag('introEnabled', true) || reduced) root.dataset.intro = 'off';
		root.dataset.cursorEffects = flag('cursorEffects', true) ? 'on' : 'off';
		root.dataset.reducedEffects = flag('reducedEffects', false) ? 'on' : 'off';
		root.dataset.performanceMode = flag('performanceMode', false) ? 'on' : 'off';
		root.dataset.advancedGlass = flag('advancedGlass', true) ? 'on' : 'off';
		var uiScale =
			s && typeof s.uiScale === 'number' && s.uiScale >= 80 && s.uiScale <= 130
				? s.uiScale
				: 100;
		root.style.setProperty('--ui-scale', String(uiScale / 100));
	})();
</script>

<!-- Identity -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<!-- theme-color and color-scheme are emitted ABOVE the pre-paint script, which
     rewrites the former before first paint. Not repeated here. -->
<meta name="author" content={SITE.author.name} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />

<!-- Feed discovery -->
<link
	rel="alternate"
	type="application/rss+xml"
	title={`${SITE.fullName} — feed`}
	href={absoluteUrl('/rss.xml')}
/>

<!-- Fonts: self-hosted, preloaded because body copy uses them above the fold. -->
<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />
<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.fullName} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={`${SITE.fullName} — ${SITE.author.tagline}`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedTime && <meta property="article:published_time" content={toIso(publishedTime)} />}
{modifiedTime && <meta property="article:modified_time" content={toIso(modifiedTime)} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonical} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={`${SITE.fullName} — ${SITE.author.tagline}`} />

<!-- Structured data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
