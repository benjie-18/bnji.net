---
/**
 * ThemeToggle — flips <html data-theme> between the dark space theme and the
 * light Frutiger Aero theme.
 *
 * The button is a real <button> with aria-pressed, so assistive tech announces
 * it as a switch. Icons swap purely in CSS against the data-theme attribute —
 * no JS needed to redraw them, and the pre-paint script guarantees the right
 * icon is visible from the first frame.
 */
---

<button
	class="theme-toggle"
	type="button"
	data-theme-toggle
	aria-pressed="false"
	aria-label="Toggle colour theme"
>
	<!-- Sun: shown in dark mode (the action switches TO light). -->
	<svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<circle cx="12" cy="12" r="4.4" fill="currentColor" />
		<g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
			<path d="M12 2.6v2.5M12 18.9v2.5M2.6 12h2.5M18.9 12h2.5M5.2 5.2l1.8 1.8M17 17l1.8 1.8M18.8 5.2 17 7M7 17l-1.8 1.8" />
		</g>
	</svg>
	<!-- Moon: shown in light mode (the action switches TO dark). -->
	<svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<path
			d="M20 14.2A8.4 8.4 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z"
			fill="currentColor"
		/>
		<circle cx="17.4" cy="6.2" r="1.1" fill="currentColor" opacity="0.8" />
	</svg>
	<span class="sr-only">Toggle colour theme</span>
</button>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 34px;
		block-size: 34px;
		flex: none;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-bg-quiet);
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}

	.theme-toggle:hover {
		color: var(--text-strong);
		border-color: var(--glass-border-strong);
		background: var(--glass-bg);
		transform: translateY(-1px);
	}

	.theme-toggle:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 2px;
	}

	.theme-toggle__icon {
		inline-size: 18px;
		block-size: 18px;
	}

	/* Dark theme shows the sun (target = light); light shows the moon. */
	.theme-toggle__icon--sun {
		display: block;
	}
	.theme-toggle__icon--moon {
		display: none;
	}

	:global(html[data-theme='light']) .theme-toggle__icon--sun {
		display: none;
	}
	:global(html[data-theme='light']) .theme-toggle__icon--moon {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-toggle,
		.theme-toggle:hover {
			transition: none;
			transform: none;
		}
	}
</style>
