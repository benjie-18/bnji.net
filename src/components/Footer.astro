---
/**
 * Footer — the closing panel of the site.
 *
 * Same glass and space language as the rest of the page, deliberately quieter:
 * a large wordmark, the copyright line, real links, and the reserved
 * destinations rendered as inert "soon" text (never as dead links).
 *
 * Links come from src/data/navigation.ts and src/data/site.ts.
 */
import { FOOTER_NAV, FUTURE_NAV } from '../data/navigation';
import { SITE, SOCIAL_LINKS } from '../data/site';
import BrandMark from './BrandMark.astro';

// Rendered at build time. The site is prerendered, so this is the year of the
// last deploy rather than of the request — rebuilds keep it current.
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
		<div class="footer-panel" data-glass data-reveal>
			<div class="footer-top">
				<div class="footer-identity">
					<p class="footer-word" aria-hidden="true">{SITE.name}</p>
					<p class="footer-tagline">
						<BrandMark size={14} />
						{SITE.author.tagline}
					</p>
				</div>

				<div class="footer-columns">
					<nav class="footer-column" aria-label="Site">
						<p class="footer-heading">Site</p>
						<ul role="list">
							{FOOTER_NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
						</ul>
					</nav>

					<nav class="footer-column" aria-label="Elsewhere">
						<p class="footer-heading">Elsewhere</p>
						<ul role="list">
							{
								SOCIAL_LINKS.map((link) => (
									<li>
										<a href={link.href} rel={link.rel ?? 'noopener noreferrer'}>
											{link.label}
											{link.handle && <span class="footer-handle">{link.handle}</span>}
										</a>
									</li>
								))
							}
						</ul>
					</nav>

					<div class="footer-column">
						<p class="footer-heading">Incoming</p>
						<ul class="footer-soon" role="list">
							{
								FUTURE_NAV.map((item) => (
									<li>
										<span class="chip" title={item.description}>
											{item.label}
											<em>soon</em>
										</span>
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>

			<hr class="rule" />

			<div class="footer-base">
				<p class="footer-copy">
					&copy; {year} {SITE.author.name}
				</p>
				<p class="footer-stack mono">Astro · Cloudflare Workers · prerendered</p>
				<a class="footer-top-link" href="#top">
					Back to top <span aria-hidden="true">&uarr;</span>
				</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding-block: clamp(3rem, 8vh, 6rem) calc(var(--space-7) + env(safe-area-inset-bottom, 0px));
	}

	.footer-panel {
		padding: clamp(1.5rem, 3.4vw, 2.75rem);
	}

	.footer-top {
		display: grid;
		gap: clamp(1.75rem, 4vw, 3rem);
	}

	@media (min-width: 860px) {
		.footer-top {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
			align-items: start;
		}
	}

	/* Large but low-contrast: the wordmark should read as atmosphere, not as a
	   second hero competing with the one at the top of the page. */
	.footer-word {
		font-family: var(--font-display);
		font-size: clamp(3rem, 8vw, 5.5rem);
		font-weight: 200;
		letter-spacing: 0.06em;
		line-height: 0.95;
		color: transparent;
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.08));
		-webkit-background-clip: text;
		background-clip: text;
	}

	/* Light theme: white-on-sky is invisible, so the wordmark fades in deep
	   teal instead — same atmosphere, mirrored palette (tokens live in the
	   aero block of tokens.css). Forced-colours mode overrides `color` to
	   CanvasText and drops backgrounds, so this degrades correctly there. */
	:global(html[data-theme='light']) .footer-word {
		background: linear-gradient(180deg, var(--aero-wordmark-top), var(--aero-wordmark-bottom));
	}

	.footer-tagline {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-block-start: 0.9rem;
		font-size: var(--text-small);
		color: var(--text-muted);
		max-width: 34ch;
	}

	.footer-columns {
		display: grid;
		gap: clamp(1.5rem, 3vw, 2.5rem);
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
	}

	.footer-heading {
		font-family: var(--font-mono);
		font-size: var(--text-micro);
		font-weight: 400;
		letter-spacing: var(--tracking-mono);
		text-transform: uppercase;
		color: var(--text-dim);
		margin-block-end: 0.85rem;
	}

	.footer-column ul {
		list-style: none;
		display: grid;
		gap: 0.5rem;
	}

	.footer-column a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.5rem;
		color: var(--text-muted);
		font-size: var(--text-small);
		text-decoration: none;
		border-radius: var(--radius-xs);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.footer-column a:hover {
		color: var(--text-strong);
	}

	.footer-handle {
		font-family: var(--font-mono);
		font-size: var(--text-micro);
		color: var(--text-faint);
	}

	.footer-soon {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.footer-soon .chip em {
		font-style: normal;
		color: var(--text-faint);
	}

	.footer-base {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
	}

	.footer-copy,
	.footer-stack {
		color: var(--text-dim);
		font-size: var(--text-small);
	}

	.footer-stack {
		color: var(--text-faint);
	}

	.footer-top-link {
		margin-inline-start: auto;
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--text-micro);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-decoration: none;
		border-radius: var(--radius-pill);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.footer-top-link:hover {
		color: var(--accent-strong);
	}
</style>
