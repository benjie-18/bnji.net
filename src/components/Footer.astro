---
/**
 * Footer — ultra-minimal round pill dock.
 *
 * Compact floating pill dock: brandmark, copyright, stack, elsewhere links, and back-to-top.
 * Contained in a pill-shaped capsule with a low vertical profile, never overlapping floating layers.
 */
import { SITE, SOCIAL_LINKS } from '../data/site';
import { FOOTER_NAV } from '../data/navigation';
import BrandMark from './BrandMark.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-pill" data-glass="quiet">
		<div class="footer-left">
			<BrandMark size={14} />
			<span class="footer-copy">&copy; {year} {SITE.name}</span>
		</div>

		<nav class="footer-pages" aria-label="Site">
			<ul role="list">
				{FOOTER_NAV.map((link) => (
					<li><a href={link.href}>{link.label}</a></li>
				))}
			</ul>
		</nav>

		<nav class="footer-links" aria-label="Elsewhere">
			<ul class="footer-socials" role="list">
				{
					SOCIAL_LINKS.map((link) => (
						<li>
							<a href={link.href} rel={link.rel ?? 'noopener noreferrer'}>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a class="footer-top-link mono" href="#top">
			Top <span aria-hidden="true">&uarr;</span>
		</a>
	</div>
</footer>

<style>
	.site-footer {
		position: relative;
		z-index: var(--z-footer, 1);
		padding-block: var(--space-6) calc(var(--space-6) + env(safe-area-inset-bottom, 0px));
		padding-inline: var(--gutter);
		display: flex;
		justify-content: center;
		pointer-events: none;
	}

	.footer-pill {
		pointer-events: auto;
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.75rem 1.75rem;
		padding: 0.65rem 1.35rem;
		border-radius: var(--radius-pill);
		border: 1px solid var(--glass-border);
		background: var(--glass-bg-quiet);
		backdrop-filter: blur(var(--glass-blur)) saturate(160%);
		-webkit-backdrop-filter: blur(var(--glass-blur)) saturate(160%);
		box-shadow:
			inset 0 1px 1px 0 rgba(255, 255, 255, 0.16),
			0 8px 30px -6px rgba(0, 0, 0, 0.35);
		font-size: var(--text-micro);
		max-width: 100%;
	}

	:global(html[data-theme='light']) .footer-pill {
		background: rgba(255, 255, 255, 0.58);
		border-color: rgba(255, 255, 255, 0.88);
		box-shadow:
			inset 0 1px 2px 0 rgba(255, 255, 255, 0.95),
			inset 0 -1px 1px 0 rgba(0, 40, 100, 0.05),
			0 10px 28px -8px rgba(0, 40, 100, 0.12),
			0 2px 6px -1px rgba(0, 0, 0, 0.04);
	}

	.footer-left {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--text-dim);
	}

	.footer-copy {
		color: var(--text-strong);
		font-weight: 500;
	}

	.footer-dot {
		color: var(--text-faint);
	}

	.footer-stack {
		color: var(--text-faint);
		letter-spacing: 0.04em;
	}

	.footer-pages ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.45rem 0.9rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-pages a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: var(--text-micro);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.footer-pages a:hover,
	.footer-pages a:focus-visible {
		color: var(--accent-strong);
	}

	.footer-pages a:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 3px;
		border-radius: var(--radius-sm);
	}

	.footer-links {
		display: flex;
		align-items: center;
	}

	.footer-socials {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.footer-socials a {
		color: var(--text-muted);
		text-decoration: none;
		font-size: var(--text-micro);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.footer-socials a:hover {
		color: var(--accent-strong);
	}

	.footer-top-link {
		color: var(--text-dim);
		text-decoration: none;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		font-size: var(--text-micro);
		transition: color var(--dur-fast) var(--ease-out);
	}

	.footer-top-link:hover {
		color: var(--accent-strong);
	}

	@media (max-width: 640px) {
		.footer-pill {
			border-radius: var(--radius-pill);
			flex-direction: column;
			align-items: center;
			text-align: center;
			gap: 0.5rem;
			padding: 0.75rem 1.25rem;
		}
	}
</style>
