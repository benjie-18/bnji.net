---
/**
 * NetworkGrid — the hostname registry, rendered from src/data/network.ts.
 *
 * The site links to services rather than absorbing them: public and live hosts
 * are links, "soon" hosts are inert text, and private hosts (Cloudflare Access)
 * are listed without a link so this page can never become a doorway into
 * something that is meant to stay private.
 */
import { SERVICES, SERVICE_VISIBILITY_LABEL } from '../data/network';
import Chip from './Chip.astro';
import GlassPanel from './GlassPanel.astro';

interface Props {
	span?: number;
	revealDelay?: number;
}

const { span, revealDelay = 0 } = Astro.props;
---

<GlassPanel pad="md" reveal revealDelay={revealDelay} {span} class="network">
	<div class="network__head">
		<p class="network__title">The BNJI network</p>
		<p class="network__hint mono">hostnames, not pages</p>
	</div>

	<ul class="network__list" role="list">
		{
			SERVICES.map((service) => (
				<li class="network__row">
					<span class="network__host">
						{service.href ? (
							<a href={service.href} rel="noopener noreferrer">
								{service.host}
							</a>
						) : (
							service.host
						)}
					</span>
					<span class="network__label">{service.label}</span>
					<Chip
						tone={service.visibility === 'live' ? 'live' : service.visibility === 'soon' ? 'soon' : 'idle'}
						dot
						class="network__chip"
					>
						{SERVICE_VISIBILITY_LABEL[service.visibility]}
					</Chip>
				</li>
			))
		}
	</ul>
</GlassPanel>

<style>
	.network {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		block-size: 100%;
	}

	.network__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.network__title {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 450;
		color: var(--text-strong);
	}

	.network__hint {
		color: var(--text-faint);
	}

	.network__list {
		list-style: none;
		display: grid;
		gap: 0.1rem;
		margin: 0;
	}

	.network__row {
		display: grid;
		grid-template-columns: minmax(9rem, 1.1fr) minmax(0, 1fr) auto;
		align-items: center;
		gap: 0.5rem 1rem;
		padding-block: 0.5rem;
		border-block-end: 1px solid var(--glass-border);
	}

	.network__row:last-child {
		border-block-end: 0;
	}

	.network__host {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
		color: var(--text);
		overflow-wrap: anywhere;
	}

	.network__host a {
		color: inherit;
		text-decoration: none;
		border-block-end: 1px solid var(--accent-line);
		border-radius: 2px;
	}

	.network__host a:hover {
		color: var(--accent-strong);
	}

	.network__label {
		font-size: 0.88rem;
		color: var(--text-dim);
	}

	.network__chip {
		justify-self: end;
	}

	@media (max-width: 620px) {
		.network__row {
			grid-template-columns: minmax(0, 1fr) auto;
			row-gap: 0.2rem;
		}

		.network__label {
			grid-column: 1 / -1;
			order: 3;
			font-size: 0.82rem;
		}
	}
</style>
