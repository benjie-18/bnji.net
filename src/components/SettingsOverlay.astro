---
/**
 * SettingsOverlay — the site's single settings surface, opened by the header
 * gear (Header.astro, [data-settings-open]).
 *
 * It is a VIEW, not an owner: every control here is bound two-way to the
 * central settings store (scripts/settings.ts) by scripts/settings-overlay.ts.
 * Nothing in this file keeps local state; remove the overlay and the store,
 * persistence and pre-paint application all keep working.
 *
 * Contents (one field each in the store):
 *   Appearance — theme (dark/light radios), UI scale, advanced glass effects;
 *   Motion     — opening sequence (intro), reduced visual effects,
 *                performance mode, cursor effects, star/particle density;
 *   Audio      — mute, volume.
 *
 * Two controls deliberately hold NO store field, because they are not
 * preferences:
 *   Secret codes — a masked field for codes that unlock future UI effects.
 *                  It changes nothing today: there is no registry entry, so
 *                  every code answers "not enabled yet". It lives here so the
 *                  field is finished while the effects land; the dispatch is in
 *                  scripts/settings-codes.ts, which is also where the security
 *                  caveats belong. A code is NOT a login and is NOT stored —
 *                  it is cleared the moment it is submitted and again on close.
 *   Admin        — a real link to /admin/ (the admin route). It performs no
 *                  client-side check of its own: the server decides whether a
 *                  visitor may stay, and sends everyone else to /admin/login.
 *
 * Every control drives real behaviour (the store's header comment maps each
 * field to its consumer). The hint text under each label says exactly what
 * the setting does — no control pretends to do more than it does.
 *
 * Accessibility: role="dialog" + aria-modal, labelled by its title; the
 * controller traps Tab inside while open, closes on Escape or backdrop click,
 * and returns focus to the gear on close. Native inputs (radio/checkbox/
 * range) carry the semantics — no custom widgets to re-implement a11y for.
 *
 * Mounted once per page by Layout.astro. Styles: styles/settings.css
 * (imported below), glass via data-glass="raised" — token-driven, both
 * themes, no hand-rolled backdrop-filter.
 */
import '../styles/settings.css';
---

<div class="settings-backdrop" data-settings-backdrop hidden></div>

<section
	class="settings-overlay"
	id="settings-overlay"
	data-glass="raised"
	data-settings-overlay
	role="dialog"
	aria-modal="true"
	aria-labelledby="settings-title"
	tabindex="-1"
	hidden
>
	<header class="settings-overlay__head">
		<h2 class="settings-overlay__title" id="settings-title">Settings</h2>
		<button class="settings-overlay__close" type="button" data-settings-close>
			<span class="sr-only">Close settings</span>
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
			</svg>
		</button>
	</header>

	<!-- Appearance -->
	<fieldset class="settings-group">
		<legend class="settings-group__title mono">Appearance</legend>

		<div class="settings-row">
			<span class="settings-row__label" id="settings-theme-label">Theme</span>
			<div class="settings-segment" role="radiogroup" aria-labelledby="settings-theme-label">
				<label class="settings-segment__option">
					<input type="radio" name="settings-theme" value="dark" data-setting="theme" />
					<span class="mono">Dark</span>
				</label>
				<label class="settings-segment__option">
					<input type="radio" name="settings-theme" value="light" data-setting="theme" />
					<span class="mono">Light</span>
				</label>
			</div>
		</div>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-uiscale">
				UI scale
			</label>
			<span class="settings-row__control">
				<input
					id="settings-uiscale"
					type="range"
					min="80"
					max="130"
					step="5"
					data-setting="uiScale"
				/>
				<output class="mono" data-setting-output="uiScale">100%</output>
			</span>
		</div>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-glass">
				Advanced glass effects
			</label>
			<input id="settings-glass" type="checkbox" class="settings-switch" data-setting="advancedGlass" />
		</div>
	</fieldset>

	<!-- Motion & effects -->
	<fieldset class="settings-group">
		<legend class="settings-group__title mono">Motion &amp; effects</legend>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-intro">
				Opening sequence
			</label>
			<input id="settings-intro" type="checkbox" class="settings-switch" data-setting="introEnabled" />
		</div>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-reduced">
				Reduced visual effects
			</label>
			<input id="settings-reduced" type="checkbox" class="settings-switch" data-setting="reducedEffects" />
		</div>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-perf">
				Performance mode
			</label>
			<input id="settings-perf" type="checkbox" class="settings-switch" data-setting="performanceMode" />
		</div>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-cursor">
				Cursor effects
			</label>
			<input id="settings-cursor" type="checkbox" class="settings-switch" data-setting="cursorEffects" />
		</div>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-density">
				Star / particle density
			</label>
			<span class="settings-row__control">
				<input
					id="settings-density"
					type="range"
					min="0"
					max="100"
					step="10"
					data-setting="starDensity"
				/>
				<output class="mono" data-setting-output="starDensity">100%</output>
			</span>
		</div>
	</fieldset>

	<!-- Audio -->
	<fieldset class="settings-group">
		<legend class="settings-group__title mono">Audio</legend>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-muted">
				Mute audio
			</label>
			<input id="settings-muted" type="checkbox" class="settings-switch" data-setting="muted" />
		</div>

		<div class="settings-row">
			<label class="settings-row__label" for="settings-volume">
				Volume
			</label>
			<span class="settings-row__control">
				<input
					id="settings-volume"
					type="range"
					min="0"
					max="100"
					step="5"
					data-setting="volume"
				/>
				<output class="mono" data-setting-output="volume">60%</output>
			</span>
		</div>
	</fieldset>

	<!--
		Secret codes.
	-->
	<fieldset class="settings-group">
		<legend class="settings-group__title mono">Secret codes</legend>

		<div class="settings-row settings-row--stack">
			<label class="settings-row__label" for="settings-code">
				Code
			</label>
			<span class="settings-row__control">
				<input
					id="settings-code"
					class="settings-code__input"
					type="text"
					autocomplete="off"
					spellcheck="false"
					placeholder="Enter code..."
					aria-describedby="settings-code-status"
					data-settings-code
				/>
				<button class="glass-button glass-button--sm" type="button" data-glass="" data-settings-code-submit>
					Submit
				</button>
			</span>
		</div>

		<p class="settings-code__status mono" id="settings-code-status" role="status" aria-live="polite" data-settings-code-status>
			Type a code and submit it.
		</p>
	</fieldset>

	<!-- Admin: a real link to the real route. No client-side check of its own. -->
	<fieldset class="settings-group">
		<legend class="settings-group__title mono">Admin</legend>

		<div class="settings-row">
			<span class="settings-row__label">
				Admin panel
			</span>
			<a class="glass-button glass-button--sm" href="/admin/" data-glass="">
				Admin
			</a>
		</div>
	</fieldset>
</section>
