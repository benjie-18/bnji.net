---
/**
 * Header — the floating pill navigation.
 *
 * Links come from src/data/navigation.ts; nothing here is hard-coded, so a
 * destination can be added without touching this file. The nav arrives at 200ms
 * in the load sequence, right after the starfield.
 *
 * Responsive contract
 * -------------------
 *  - >= 900px: brand + inline links inside one pill.
 *  - <  900px: brand + a disclosure button; the same list becomes a glass sheet
 *    under the pill. Closed means `visibility: hidden`, so its links leave both
 *    the layout and the tab order.
 *  - No JavaScript: the sheet is shown inline and the dock stops floating
 *    (rules in global.css), because a menu button that cannot open is worse
 *    than a slightly taller bar.
 *
 * Boundary note: this component styles the pill and the list container. The
 * links themselves are HeaderLink.astro, which owns every `.nav-link` rule
 * including its mobile variant. The dock's own positioning (fixed, centred,
 * pointer-transparent) lives in global.css with the other structural shells.
 */
import { PRIMARY_NAV } from '../data/navigation';
import { SITE } from '../data/site';
import BrandMark from './BrandMark.astro';
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<!-- <header> so every page gets a real banner landmark, not a bare div. -->
<header class="nav-dock" data-nav data-load style="--load-delay: 200ms">
	<nav class="nav-pill" data-glass="raised" aria-label="Primary">
		<a class="brand" href="/">
			<BrandMark size={20} />
			<span class="brand-word">{SITE.name}</span>
			<span class="sr-only"> — {SITE.author.name}, home</span>
		</a>

		<ul class="nav-list" id="primary-navigation" data-nav-panel role="list">
			{
				PRIMARY_NAV.map((item) => (
					<li>
						<HeaderLink href={item.href}>{item.label}</HeaderLink>
					</li>
				))
			}
		</ul>

		<ThemeToggle />

		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="primary-navigation"
		>
			<span class="sr-only">Toggle navigation menu</span>
			<span class="nav-toggle-bars" aria-hidden="true">
				<span></span>
				<span></span>
			</span>
		</button>
	</nav>
</header>

<style>
	.nav-pill {
		position: relative; /* anchor for the mobile sheet */
		display: flex;
		align-items: center;
		gap: clamp(0.35rem, 1.4vw, 1rem);
		max-width: 100%;
		min-height: var(--nav-height);
		padding: 0.34rem 0.4rem 0.34rem 0.9rem;
		border-radius: var(--radius-pill);
		pointer-events: auto; /* the dock itself is pointer-transparent */
		transition:
			background-color var(--dur-base) var(--ease-out),
			border-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	/* Once the page has scrolled, the pill gains a little more fill so it stays
	   legible over bright content. scripts/scroll.ts toggles .is-stuck on the
	   dock, which is why the selector starts at .nav-dock. */
	.nav-dock.is-stuck .nav-pill {
		background: var(--glass-bg-raised);
		border-color: var(--glass-border-strong);
		box-shadow: var(--glass-shadow-raised);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding-block: 0.3em;
		color: var(--text-strong);
		text-decoration: none;
		border-radius: var(--radius-pill);
	}

	.brand-word {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		/* Optical compensation so the wordmark looks centred in the pill. */
		margin-inline-end: -0.18em;
		transition: color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.brand:hover .brand-word {
			color: var(--accent-strong);
		}
	}

	.nav-list {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		list-style: none;
		margin: 0;
	}

	.nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		inline-size: 40px;
		block-size: 40px;
		margin-inline-start: auto;
		border-radius: var(--radius-pill);
		border: 1px solid var(--glass-border);
		background: rgba(255, 255, 255, 0.04);
		color: var(--text);
		cursor: pointer;
		transition:
			background-color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-toggle:hover {
			background: rgba(255, 255, 255, 0.09);
			border-color: var(--glass-border-strong);
		}
	}

	.nav-toggle-bars {
		display: grid;
		gap: 5px;
		inline-size: 16px;
	}

	.nav-toggle-bars span {
		display: block;
		block-size: 1.5px;
		inline-size: 100%;
		border-radius: 2px;
		background: currentColor;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	/* --- Small screens: the list becomes a glass sheet --------------------- */

	@media (max-width: 899px) {
		.nav-toggle {
			display: inline-flex;
		}

		.nav-list {
			position: absolute;
			inset-inline: 0;
			inset-block-start: calc(100% + 10px);
			flex-direction: column;
			align-items: stretch;
			gap: 0.1rem;
			padding: 0.5rem;
			border-radius: var(--radius-lg);
			border: 1px solid var(--glass-border-strong);
			box-shadow: var(--glass-shadow-raised);
			/* Not backdrop-filter, and deliberately so: the sheet is a DOM child of
			   the pill, and an element with backdrop-filter becomes a "backdrop
			   root" for its descendants — the sheet could only blur the pill's own
			   already-blurred backdrop, which renders flat and costs fill rate on
			   the devices that can least afford it. A near-solid dark panel over a
			   near-black page is visually the same thing, so that is what it is. */
			background: rgba(6, 8, 14, 0.94);
			/* Closed: invisible AND unreachable by keyboard and screen reader. */
			opacity: 0;
			visibility: hidden;
			transform: translate3d(0, -8px, 0);
			transition:
				opacity var(--dur-fast) var(--ease-out),
				transform var(--dur-fast) var(--ease-out),
				visibility 0s linear var(--dur-fast);
		}

		.nav-list.is-open {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition:
				opacity var(--dur-base) var(--ease-out),
				transform var(--dur-base) var(--ease-spring),
				visibility 0s;
		}

		/* Two bars become a cross. */
		.nav-toggle[aria-expanded='true'] .nav-toggle-bars span:first-child {
			transform: translateY(3.25px) rotate(45deg);
		}

		.nav-toggle[aria-expanded='true'] .nav-toggle-bars span:last-child {
			transform: translateY(-3.25px) rotate(-45deg);
		}
	}
</style>
