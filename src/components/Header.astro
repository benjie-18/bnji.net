---
/**
 * Header — the floating pill navigation.
 *
 * Links come from src/data/navigation.ts; nothing here is hard-coded, so a
 * destination can be added without touching this file. The nav arrives at 200ms
 * in the load sequence, right after the starfield.
 *
 * The pill's tool cluster carries the settings GEAR ([data-settings-open]),
 * which opens the SettingsOverlay (Layout.astro) via scripts/settings-overlay.ts.
 * The theme toggle that used to sit here now lives inside that overlay.
 *
 * Structure: four top-level entries — Home, Projects ▾, Community ▾, Me ▾.
 * The groups are disclosure dropdowns: a real <button> trigger (aria-expanded /
 * aria-controls) plus a glass panel (data-glass="raised" — the same token-
 * driven surface system as the pill, correct in both themes by construction;
 * no hand-rolled backdrop-filter here). Grouped destinations appear ONLY
 * inside their dropdown.
 *
 * Dropdown behaviour lives in scripts/interactions.ts → initNavDropdowns:
 * arrow keys move through items, Escape closes and returns focus to the
 * trigger, Tab is trapped inside the open group, tap opens / tap-outside
 * closes, panels near the right viewport edge flip to right-aligned, and
 * focus leaving the group closes it.
 *
 * Responsive contract
 * -------------------
 *  - >= 900px: brand + inline entries inside one pill; dropdown panels float
 *    under their trigger.
 *  - <  900px: brand + a disclosure button; the same list becomes a glass sheet
 *    under the pill. Inside the sheet, dropdown panels go position:static and
 *    accordion open under their trigger. Closed means `visibility: hidden`, so
 *    links leave both the layout and the tab order.
 *  - No JavaScript: triggers cannot open, so a no-JS rule hides them and lays
 *    the group links out inline (desktop) / stacked (sheet) — every route stays
 *    reachable, mirroring the existing no-JS sheet rule in global.css.
 *
 * Boundary note: this component styles the pill, the list container and the
 * dropdown chrome. The links themselves are HeaderLink.astro, which owns every
 * `.nav-link` rule including the dropdown variant. The dock's own positioning
 * (fixed, centred, pointer-transparent) lives in global.css.
 */
import { isNavGroup, PRIMARY_NAV } from '../data/navigation';
import { SITE } from '../data/site';
import BrandMark from './BrandMark.astro';
import HeaderLink from './HeaderLink.astro';

const path = Astro.url.pathname.replace(/index\.html$/, '');
/** Same prefix rule as HeaderLink: a group trigger lights up for its children. */
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href));
---

<!-- <header> so every page gets a real banner landmark, not a bare div. -->
<header class="nav-dock" data-nav data-load style="--load-delay: 200ms">
	<nav class="nav-pill" data-glass="raised" aria-label="Primary">
		<a class="brand" href="/">
			<BrandMark size={20} />
			<span class="sr-only">{SITE.name} — home</span>
		</a>

		<ul class="nav-list" id="primary-navigation" data-nav-panel role="list">
			{
				PRIMARY_NAV.map((entry) =>
					isNavGroup(entry) ? (
						<li class="nav-group" data-nav-group>
							<button
								class:list={[
									'nav-group__trigger',
									{ 'is-active': entry.items.some((item) => isCurrent(item.href)) },
								]}
								type="button"
								data-nav-dropdown-trigger
								aria-expanded="false"
								aria-controls={`nav-dropdown-${entry.slug}`}
							>
								{entry.label}
								<svg class="nav-group__chevron" viewBox="0 0 12 12" aria-hidden="true">
									<path
										d="M2.5 4.5 6 8l3.5-3.5"
										fill="none"
										stroke="currentColor"
										stroke-width="1.6"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
							</button>
							<div
								class="nav-dropdown"
								id={`nav-dropdown-${entry.slug}`}
								data-glass="raised"
								data-nav-dropdown
								aria-label={entry.label}
							>
								<ul role="list">
									{entry.items.map((item) => (
										<li>
											<HeaderLink href={item.href} class="nav-dropdown__link">
												{item.label}
											</HeaderLink>
										</li>
									))}
								</ul>
							</div>
						</li>
					) : (
						<li>
							<HeaderLink href={entry.href}>{entry.label}</HeaderLink>
						</li>
					),
				)
			}
		</ul>

		<!-- Tool cluster: the settings gear (the reserved slot is now taken).
		     It opens the SettingsOverlay mounted once in Layout.astro; the
		     controller in scripts/settings-overlay.ts binds [data-settings-open]
		     triggers, so the markup here is just the button. The theme toggle
		     that used to live here moved INTO the overlay (settings store). -->
		<div class="nav-tools">
			<!-- Phase E (chat plan §8.3): in-app notification badge — unread DMs +
			     pending friend requests, polled by scripts/notifications-ui.ts.
			     Hidden until the API reports a real count: no unwired claims. -->
			<a class="nav-badge" href="/friends/" data-notif-badge hidden aria-label="Notifications">
				<span class="nav-badge__count" data-notif-count>0</span>
			</a>
			<button
				class="settings-gear"
				type="button"
				data-settings-open
				aria-label="Settings"
				aria-expanded="false"
				aria-controls="settings-overlay"
			>
				<svg class="settings-gear__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path
						d="M12 15.4a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8Z"
						stroke="currentColor"
						stroke-width="1.7"
					/>
					<path
						d="M19.4 14.4a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.86 2.86l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V21a2 2 0 1 1-4 0v-.11a1.7 1.7 0 0 0-1.11-1.56 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.86-2.86l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.56-1.03H3a2 2 0 1 1 0-4h.11a1.7 1.7 0 0 0 1.56-1.11 1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.86-2.86l.06.06a1.7 1.7 0 0 0 1.87.34H9a1.7 1.7 0 0 0 1-1.56V3a2 2 0 1 1 4 0v.11a1.7 1.7 0 0 0 1.03 1.56 1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.86 2.86l-.06.06a1.7 1.7 0 0 0-.34 1.87V9a1.7 1.7 0 0 0 1.56 1H21a2 2 0 1 1 0 4h-.11a1.7 1.7 0 0 0-1.49 1.4Z"
						stroke="currentColor"
						stroke-width="1.7"
						stroke-linecap="round"
						stroke-linejoin="round"
					/>
				</svg>
			</button>
		</div>

		<button
			class="nav-toggle"
			type="button"
			data-nav-toggle
			aria-expanded="false"
			aria-controls="primary-navigation"
		>
			<span class="sr-only">Toggle navigation menu</span>
			<span class="nav-toggle-bars" aria-hidden="true">
				<span></span>
				<span></span>
			</span>
		</button>
	</nav>
</header>

<style>
	.nav-pill {
		position: relative; /* anchor for the mobile sheet */
		display: flex;
		align-items: center;
		gap: clamp(0.35rem, 1.4vw, 1rem);
		max-width: 100%;
		min-height: var(--nav-height);
		padding: 0.34rem 0.4rem 0.34rem 0.9rem;
		border-radius: var(--radius-pill);
		pointer-events: auto; /* the dock itself is pointer-transparent */
		transition:
			background-color var(--dur-base) var(--ease-out),
			border-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out);
	}

	/* Once the page has scrolled, the pill gains a little more fill so it stays
	   legible over bright content. scripts/scroll.ts toggles .is-stuck on the
	   dock, which is why the selector starts at .nav-dock. */
	.nav-dock.is-stuck .nav-pill {
		background: var(--glass-bg-raised);
		border-color: var(--glass-border-strong);
		box-shadow: var(--glass-shadow-raised);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding-block: 0.3em;
		color: var(--text-strong);
		text-decoration: none;
		border-radius: var(--radius-pill);
	}

	/* Wordmark removed: the star alone is the home affordance. */
	.brand :global(.brand-mark) {
		transition: transform var(--dur-base) var(--ease-spring);
	}

	@media (hover: hover) and (pointer: fine) {
		.brand:hover :global(.brand-mark) {
			transform: rotate(45deg) scale(1.08);
		}
	}

	.nav-list {
		display: flex;
		align-items: center;
		gap: 0.15rem;
		list-style: none;
		margin: 0;
	}

	/* Tool cluster (settings gear today; room for more round buttons). */
	.nav-tools {
		display: flex;
		align-items: center;
		gap: 0.15rem;
	}

	/* The gear wears exactly the language the theme toggle used to: a 34px
	   glass-rimmed round button (tokens, so both themes), lift on hover,
	   accent outline on keyboard focus. */
	/* Phase E §8.3: header notification badge (messages + friend requests). */
	.nav-badge {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-inline-size: 20px;
		block-size: 20px;
		padding-inline: 5px;
		border: 1px solid var(--glass-border-strong);
		border-radius: 999px;
		background: var(--glass-bg-raised);
		color: var(--text-strong, #fff);
		font-size: 0.62rem;
		font-weight: 700;
		line-height: 1;
		text-decoration: none;
	}
	.nav-badge[hidden] { display: none; }
	.nav-badge:hover,
	.nav-badge:focus-visible { border-color: var(--glass-border); color: var(--text-strong, #fff); }

	.settings-gear {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 34px;
		block-size: 34px;
		flex: none;
		border: 1px solid var(--glass-border);
		border-radius: 50%;
		background: var(--glass-bg-quiet);
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}

	.settings-gear:hover {
		color: var(--text-strong);
		border-color: var(--glass-border-strong);
		background: var(--glass-bg);
		transform: translateY(-1px);
	}

	.settings-gear:focus-visible {
		outline: 2px solid var(--accent-strong);
		outline-offset: 2px;
	}

	.settings-gear[aria-expanded='true'] {
		color: var(--text-strong);
		border-color: var(--glass-border-strong);
	}

	.settings-gear__icon {
		inline-size: 18px;
		block-size: 18px;
		transform-origin: center;
		transition: transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	:global(.settings-gear.is-spinning .settings-gear__icon) {
		animation: gear-spin 0.65s cubic-bezier(0.25, 1, 0.5, 1);
	}

	@keyframes gear-spin {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.settings-gear), :global(.settings-gear:hover), :global(.settings-gear.is-spinning .settings-gear__icon) {
			transition: none;
			transform: none;
			animation: none;
		}
	}

	/* --- Dropdown groups ---------------------------------------------------- */
	/* Trigger mirrors the .nav-link visual rhythm. HeaderLink.astro owns the
	   actual .nav-link rules (component boundary), so the handful of matching
	   declarations here are deliberate duplication of *look*, not of logic. */

	.nav-group {
		position: relative;
		display: flex;
	}

	.nav-group__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.42em 0.85em;
		border-radius: var(--radius-pill);
		border: 1px solid transparent;
		background: none;
		font-family: var(--font-display);
		font-size: 0.9rem;
		font-weight: 450;
		letter-spacing: 0.004em;
		line-height: 1.3;
		color: var(--text-muted);
		cursor: pointer;
		white-space: nowrap;
		transition:
			color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-group__trigger:hover {
			color: var(--text-strong);
			background: var(--nav-hover);
		}
	}

	/* A child route is current: the trigger wears the same active pill a
	   HeaderLink would (aria-current lives on the link inside). */
	.nav-group__trigger.is-active {
		color: var(--text-strong);
		background: var(--nav-active);
		border-color: var(--glass-border);
		box-shadow: inset 0 1px 0 var(--glass-highlight);
	}

	.nav-group__trigger:focus-visible {
		color: var(--text-strong);
		outline-offset: 2px;
	}

	.nav-group__chevron {
		inline-size: 10px;
		flex: none;
		color: var(--text-dim);
		transition: transform var(--dur-fast) var(--ease-out);
	}

	.nav-group:global(.is-open) .nav-group__chevron {
		transform: rotate(180deg);
	}

	/* Panel: glass comes from data-glass="raised" (styles/glass.css) — themed
	   by tokens, so dark and light are both correct for free. The descendant
	   selector outranks the bare [data-glass] rule's position: relative.
	   Closed = visibility:hidden, so links leave the tab order (same contract
	   as the mobile sheet). */
	.nav-group .nav-dropdown {
		position: absolute;
		inset-block-start: calc(100% + 10px);
		inset-inline-start: 0;
		z-index: 2;
		display: grid;
		min-inline-size: 13rem;
		padding: 0.5rem;
		border-radius: var(--radius-lg);
		opacity: 0;
		visibility: hidden;
		transform: translate3d(0, -8px, 0);
		pointer-events: none;
		transition:
			opacity var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out),
			visibility 0s linear var(--dur-fast);
	}

	.nav-group:global(.is-open) .nav-dropdown {
		opacity: 1;
		visibility: visible;
		transform: none;
		pointer-events: auto;
		transition:
			opacity var(--dur-base) var(--ease-out),
			transform var(--dur-base) var(--ease-spring),
			visibility 0s;
	}

	/* Edge-aware flip: initNavDropdowns measures the panel against the right
	   viewport edge on every open and toggles this. */
	.nav-group .nav-dropdown:global(.nav-dropdown--flip) {
		inset-inline-start: auto;
		inset-inline-end: 0;
	}

	.nav-group .nav-dropdown ul {
		display: grid;
		gap: 0.1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	/* --- No JavaScript: triggers cannot open, so lay the group links out
	   inline (desktop) / stacked (sheet) — every route stays reachable. The
	   panel loses its glass chrome and becomes a plain flex row. ----------- */
	:global(html:not(.js)) .nav-group__trigger {
		display: none;
	}

	:global(html:not(.js)) .nav-group .nav-dropdown {
		position: static;
		display: flex;
		min-inline-size: 0;
		padding: 0;
		opacity: 1;
		visibility: visible;
		transform: none;
		pointer-events: auto;
		border: 0;
		background: none;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	:global(html:not(.js)) .nav-group .nav-dropdown::before,
	:global(html:not(.js)) .nav-group .nav-dropdown::after {
		content: none;
	}

	:global(html:not(.js)) .nav-group .nav-dropdown ul {
		display: flex;
		align-items: center;
		gap: 0.1rem;
	}

	.nav-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		inline-size: 40px;
		block-size: 40px;
		margin-inline-start: auto;
		border-radius: var(--radius-pill);
		border: 1px solid var(--glass-border);
		background: rgba(255, 255, 255, 0.04);
		color: var(--text);
		cursor: pointer;
		transition:
			background-color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.nav-toggle:hover {
			background: rgba(255, 255, 255, 0.09);
			border-color: var(--glass-border-strong);
		}
	}

	.nav-toggle-bars {
		display: grid;
		gap: 5px;
		inline-size: 16px;
	}

	.nav-toggle-bars span {
		display: block;
		block-size: 1.5px;
		inline-size: 100%;
		border-radius: 2px;
		background: currentColor;
		transition: transform var(--dur-fast) var(--ease-out);
	}

	/* --- Small screens: the list becomes a glass sheet --------------------- */

	@media (max-width: 899px) {
		.nav-toggle {
			display: inline-flex;
		}

		.nav-list {
			position: absolute;
			inset-inline: 0;
			inset-block-start: calc(100% + 10px);
			flex-direction: column;
			align-items: stretch;
			gap: 0.1rem;
			padding: 0.5rem;
			border-radius: var(--radius-lg);
			border: 1px solid var(--glass-border-strong);
			box-shadow: var(--glass-shadow-raised);
			/* Not backdrop-filter, and deliberately so: the sheet is a DOM child of
			   the pill, and an element with backdrop-filter becomes a "backdrop
			   root" for its descendants — the sheet could only blur the pill's own
			   already-blurred backdrop, which renders flat and costs fill rate on
			   the devices that can least afford it. A near-solid panel over the
			   page is visually the same thing, so that is what it is: --nav-sheet-bg
			   is the historical near-black in the dark theme and a sky-tinted
			   near-white in the light theme (tokens.css), so the sheet never lands
			   dark-on-light or vice versa. */
			background: var(--nav-sheet-bg);
			/* Closed: invisible AND unreachable by keyboard and screen reader. */
			opacity: 0;
			visibility: hidden;
			transform: translate3d(0, -8px, 0);
			transition:
				opacity var(--dur-fast) var(--ease-out),
				transform var(--dur-fast) var(--ease-out),
				visibility 0s linear var(--dur-fast);
		}

		:global(.nav-list.is-open) {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition:
				opacity var(--dur-base) var(--ease-out),
				transform var(--dur-base) var(--ease-spring),
				visibility 0s;
		}

		/* Two bars become a cross. */
		.nav-toggle[aria-expanded='true'] .nav-toggle-bars span:first-child {
			transform: translateY(3.25px) rotate(45deg);
		}

		.nav-toggle[aria-expanded='true'] .nav-toggle-bars span:last-child {
			transform: translateY(-3.25px) rotate(-45deg);
		}

		/* Dropdowns inside the sheet: an accordion, not a floating panel. The
		   sheet is position:static territory — no edge flip can overflow it.
		   When closed, it must be display:none and zeroed out so it does not
		   create ghost spacing/gaps between siblings. */
		.nav-group {
			display: grid;
			gap: 0.1rem;
		}

		.nav-group__trigger {
			inline-size: 100%;
			justify-content: space-between;
			padding: 0.72em 0.95em;
			font-size: 1rem;
			border-radius: var(--radius-md);
		}

		.nav-group .nav-dropdown {
			position: static;
			min-inline-size: 0;
			padding: 0;
			margin: 0;
			height: 0;
			overflow: hidden;
			opacity: 0;
			visibility: hidden;
			display: none;
			transform: none;
		}

		.nav-group:global(.is-open) .nav-dropdown {
			display: grid;
			height: auto;
			padding: 0.25rem 0.5rem 0.5rem;
			opacity: 1;
			visibility: visible;
			transform: none;
		}

		:global(html:not(.js)) .nav-group .nav-dropdown {
			display: flex;
			height: auto;
			padding: 0.25rem 0.5rem 0.5rem;
			opacity: 1;
			visibility: visible;
		}

		:global(html:not(.js)) .nav-group .nav-dropdown ul {
			flex-direction: column;
			align-items: stretch;
		}
	}

</style>
