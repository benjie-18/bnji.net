---
/**
 * CursorGlow — a theme-aware halo that follows a real mouse pointer.
 *
 * scripts/interactions.ts moves it with translate3d only. It is hidden (and the
 * JS bails out) on touch devices and when the visitor prefers reduced motion,
 * because a simulated cursor on a phone is both distracting and wasteful.
 *
 * Sized neatly to englobe the mouse pointer itself (~38px) rather than spreading
 * as a massive screen-wide halo.
 *
 * The two themes get two different materials:
 *   - dark:  a stellar aura — blue core, violet mid, pink rim — with luminous glow.
 *   - light: a Frutiger Aero water lens — bright aqua core, caustic green rim
 *     and a hot specular dot.
 *
 * It sits above content but never intercepts pointer events.
 */
---

<div class="cursor-glow" data-cursor-glow aria-hidden="true"></div>

<style>
	.cursor-glow {
		position: fixed;
		inset-block-start: 0;
		inset-inline-start: 0;
		z-index: var(--z-cursor);
		inline-size: 38px;
		block-size: 38px;
		/* Offset by half so translate3d(x, y) places the centre on the pointer. */
		margin-block-start: -19px;
		margin-inline-start: -19px;
		pointer-events: none;
		opacity: 0;
		border-radius: 50%;
		/* Dark: neat pointer aura with luminous core and soft diffraction ring */
		background:
			radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.4), transparent 28%),
			radial-gradient(circle, var(--cursor-core) 0%, var(--cursor-mid) 40%, var(--cursor-rim) 72%, transparent 100%);
		box-shadow: 0 0 16px var(--cursor-mid, rgba(127, 212, 255, 0.35));
		transition: opacity var(--dur-base) var(--ease-out);
		will-change: transform, opacity;
	}

	/* Light: subtle water lens aura englobing the pointer */
	:global(html[data-theme='light']) .cursor-glow {
		background:
			radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.75), transparent 32%),
			radial-gradient(circle, var(--cursor-core) 0%, var(--cursor-mid) 42%, var(--cursor-rim) 75%, transparent 100%);
		box-shadow: 0 0 14px rgba(0, 180, 240, 0.32);
		mix-blend-mode: normal;
	}

	/* No halo without a hovering pointer, and none at all for reduced motion. */
	@media (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
		.cursor-glow {
			display: none;
		}
	}

	/* Settings-store gates (attributes are set pre-paint, so the halo never
	   appears for a visitor who turned it off — scripts/interactions.ts
	   mirrors this live). Reduced effects calms the cursor too. */
	:global(html[data-cursor-effects='off']) .cursor-glow,
	:global(html[data-reduced-effects='on']) .cursor-glow {
		display: none;
	}

	@media (max-width: 720px) {
		.cursor-glow {
			inline-size: 32px;
			block-size: 32px;
			margin-block-start: -16px;
			margin-inline-start: -16px;
		}
	}
</style>
