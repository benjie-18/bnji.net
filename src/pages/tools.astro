---
/**
 * /tools/ — one browser tool, fully local.
 *
 * Each tool is its own component under src/components/tools/ and its behaviour is
 * a module under src/scripts/ started from boot(). The page itself only
 * composes them, so a second tool is one component plus one nav entry — no page
 * rewrite.
 *
 * Privacy is a structural property here, not a promise: there is no API route,
 * no fetch and no form post behind the tool, so "nothing is uploaded" is
 * checkable in the diff.
 */
import GlassPanel from '../components/GlassPanel.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ImageConverter from '../components/tools/ImageConverter.astro';
import { SITE } from '../data/site';
import Layout from '../layouts/Layout.astro';
import '../styles/tools.css';

const description = `A tool that runs entirely in the browser by ${SITE.author.name}: an image converter and optimizer for PNG, JPEG and WebP. Nothing is uploaded.`;
---

<Layout title="Tools" description={description}>
	<PageHeader
		index="09"
		label="TOOLS"
		titleId="page-title"
		title="Tools that run in your browser"
		description="The tool decodes, transforms and encodes locally. No file leaves this tab, there is no upload step, and nothing is stored — close the page and the work is gone."
		meta={['1 tool', 'No upload', 'No account']}
	/>

	<div class="container tools-body">
		<ImageConverter />

		<section class="tools-notes" aria-labelledby="tools-notes-title">
			<SectionHeading
				index="02"
				label="LIMITS"
				titleId="tools-notes-title"
				title="What this tool does not do"
				description="Said plainly, so nobody waits for a feature that is not there."
			/>

			<div class="tools-notes__grid">
				<GlassPanel variant="quiet" radius="md" pad="md" reveal>
					<h3 class="tools-notes__title">Image tool</h3>
					<p class="tools-notes__text">
						Converts between PNG, JPEG and WebP and resizes. It does not remove backgrounds, does not
						compress arbitrary files, and does not convert PDFs, documents or audio. Quality applies to
						JPEG and WebP only — PNG is lossless, so its slider stays off. Output metadata such as EXIF
						is not preserved, and JPEG output has no transparency.
					</p>
				</GlassPanel>
				<GlassPanel variant="quiet" radius="md" pad="md" reveal revealDelay={70}>
					<h3 class="tools-notes__title">Requirements</h3>
					<p class="tools-notes__text">
						Needs a current browser with canvas support. Large files are refused with the
						limit stated rather than silently truncated, and a format the browser cannot encode is
						reported instead of quietly substituted.
					</p>
				</GlassPanel>
			</div>
		</section>
	</div>
</Layout>
