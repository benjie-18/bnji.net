---
/**
 * /me/blog/ — the blog index.
 *
 * Posts come from the content collection via src/data/blog.ts, which is the same
 * accessor the homepage preview and the RSS feed use, so ordering and draft
 * filtering can never disagree between them.
 */
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import { getBlogPosts } from '../../../data/blog';
import { SITE } from '../../../data/site';
import Layout from '../../../layouts/Layout.astro';

const posts = await getBlogPosts();
const description = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.';
---

<Layout title="Blog" description={description}>
	<PageHeader
		index="05"
		label="BLOG"
		titleId="page-title"
		title="Blog!!"
		description="omg this is so 2013 core internet buzzword buzzword.. ok anyways im gonna yap here (or not idk maybe thisll be revolutionary). 💞"
	/>

	<div class="container blog-body">
		<div class="blog-grid">
			{
				posts.map((post, index) => (
					<PostCard
						post={post}
						variant="tile"
						showImage
						index={index}
						revealDelay={index * 80}
						headingLevel="h2"
					/>
				))
			}
		</div>
	</div>
</Layout>

<style>
	.blog-body {
		display: grid;
		gap: var(--grid-gap);
		padding-block-end: clamp(3rem, 8vh, 6rem);
	}

	.blog-grid {
		display: grid;
		gap: var(--grid-gap);
	}

	@media (min-width: 760px) {
		.blog-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.blog-foot {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.blog-foot a {
		font-family: var(--font-mono);
		font-size: var(--text-small);
		color: var(--text-muted);
		text-decoration: none;
		border-block-end: 1px solid var(--accent-line);
		border-radius: 2px;
	}

	.blog-foot a:hover {
		color: var(--accent-strong);
	}
</style>
