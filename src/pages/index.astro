---
/**
 * Homepage — composition only.
 *
 * This file is intentionally short: it declares the order of the sections and
 * nothing else. Each section is its own component in src/components/, so a
 * change to (say) the projects grid is a change to ProjectsPreview.astro and the
 * resulting diff says exactly that.
 *
 * Progression: hero -> identity -> projects -> interests -> system -> writing ->
 * lab -> contact. The footer comes from the layout.
 */
import AboutPreview from '../components/AboutPreview.astro';
import BlogPreview from '../components/BlogPreview.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import IntroSequence from '../components/IntroSequence.astro';
import LabPreview from '../components/LabPreview.astro';
import ProjectsPreview from '../components/ProjectsPreview.astro';
import ServicesPreview from '../components/ServicesPreview.astro';
import StatusPreview from '../components/StatusPreview.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<IntroSequence />
	<Hero />
	<AboutPreview />
	<ProjectsPreview />
	<ServicesPreview />
	<StatusPreview />
	<BlogPreview />
	<LabPreview />
	<ContactSection />
</Layout>
