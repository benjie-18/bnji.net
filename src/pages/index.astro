---
/**
 * Homepage — composition only.
 *
 * Progression: hero -> projects -> writing -> lab -> contact.
 *
 * Sections with placeholder content (AboutPreview, ServicesPreview, StatusPreview)
 * are cleanly commented out below to eliminate bloat and keep the homepage lean and focused.
 * They remain fully intact and can be re-enabled simply by uncommenting their tags.
 */
// Placeholder sections (can be re-enabled whenever needed):
// import AboutPreview from '../components/AboutPreview.astro';
// import ServicesPreview from '../components/ServicesPreview.astro';
// import StatusPreview from '../components/StatusPreview.astro';

import BlogPreview from '../components/BlogPreview.astro';
import ContactSection from '../components/ContactSection.astro';
import Hero from '../components/Hero.astro';
import IntroSequence from '../components/IntroSequence.astro';
import LabPreview from '../components/LabPreview.astro';
import ProjectsPreview from '../components/ProjectsPreview.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<IntroSequence slot="intro" />
	<Hero />

	{/* Real showcase: featured projects */}
	<ProjectsPreview />

	{/* Real content: recent articles and writing */}
	<BlogPreview />

	{/* Interactive real-time physics & optical laboratory */}
	<LabPreview />

	{/* Direct communication / message drawer */}
	<ContactSection />

	{/* 
		Optional placeholder sections (can easily be re-enabled by uncommenting):
		<AboutPreview />
		<ServicesPreview />
		<StatusPreview />
	*/}
</Layout>

