---
/**
 * /messages/ — chat plan Phase D: live private messaging between registered
 * accounts (plan §7.1). Static shell; every piece of data arrives over the
 * authenticated API, so nothing private is baked into the build.
 *
 * Built from the global layer and nothing else: panels are `data-glass`, the
 * thread box is a nested `data-glass="quiet"` panel, fields are `.glass-field`,
 * rows are `.glass-item`, controls are `.glass-button`, and the two status lines
 * are `.glass-status` elements placed under the field they answer (one under the
 * handle form, one under the composer) — never above the content. The page's own
 * CSS is therefore layout, message bubbles and nothing else.
 *
 * The disclosure line is mandatory product copy (plan §12.6 + owner answer D10):
 * plainly what is stored, who can read it, and that there is no
 * end-to-end encryption — the site may never imply otherwise. It is one sentence,
 * and the client writes it because the retention figure is config.
 */
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import GlassButton from '../components/GlassButton.astro';
---

<Layout title="Messages" description="Private messages between accounts on bnji.net.">
	<PageHeader
		index="10"
		label="MESSAGES"
		titleId="page-title"
		title="Messages"
		description="Private conversations between registered accounts."
	/>

	<div class="container dm-body" data-messages-root>
		<section class="dm-panel dm-signin" data-dm-signin data-glass="raised large" hidden>
			<h2>Messages are for accounts</h2>
			<p>
				<a href="/games/">Create or sign in to an account on the Games page</a>, then come
				back.
			</p>
		</section>

		<section class="dm-panel dm-signed-in" data-dm-signed-in data-glass="raised large" hidden>
			<p class="dm-disclosure" data-dm-disclosure></p>

			<div class="dm-layout">
				<div class="dm-side">
					<form class="dm-new" data-dm-new-form>
						<label class="glass-label" for="dm-new-handle">Start a conversation</label>
						<div class="dm-new__row">
							<input id="dm-new-handle" class="glass-field" name="handle" type="text" placeholder="exact handle"
								pattern="[a-z0-9_]{3,20}" minlength="3" maxlength="20" autocomplete="off"
								autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="go" required
								data-dm-new-handle />
							<GlassButton type="submit" variant="primary" size="sm">Open</GlassButton>
						</div>
						<p class="glass-status" data-dm-status role="status" aria-live="polite" aria-atomic="true"></p>
					</form>

					<h2 class="dm-side__title">Conversations</h2>
					<ul class="dm-list" data-dm-list role="list"></ul>
					<p class="dm-empty" data-dm-list-empty hidden>No conversations yet.</p>
				</div>

				<div class="dm-thread-wrap" data-glass="quiet">
					<div class="dm-thread-head" data-dm-thread-head hidden>
						<h2 data-dm-partner>Conversation</h2>
						<span class="dm-conn" data-dm-conn></span>
					</div>
					<ol class="dm-thread" data-dm-thread tabindex="0" aria-label="Messages"></ol>
					<p class="dm-thread-empty" data-dm-thread-empty>Pick a conversation, or start one by handle.</p>

					<form class="dm-composer" data-dm-composer hidden>
						<div class="dm-image-chip" data-dm-image-chip hidden>
							<span class="chip chip--accent" data-dm-image-name></span>
							<button class="glass-button glass-button--quiet glass-button--sm" type="button" data-dm-image-remove
								aria-label="Remove attached image">Remove</button>
						</div>
						<div class="dm-composer__row">
							<textarea class="glass-field" data-dm-text rows="2" placeholder="Write a message" aria-label="Message"></textarea>
							<label class="glass-button glass-button--quiet glass-button--sm dm-attach" data-dm-attach>
								<input type="file" accept="image/png,image/jpeg,image/webp" data-dm-image-input hidden />
								<span aria-hidden="true">🖼</span>
								<span class="sr-only">Attach an image</span>
							</label>
							<GlassButton type="submit" variant="primary" size="sm" ariaLabel="Send message">Send</GlassButton>
						</div>
						<p class="glass-status" data-dm-send-status role="status" aria-live="polite" aria-atomic="true"></p>
					</form>
				</div>
			</div>
		</section>
	</div>
</Layout>

<style>
	.dm-body { display: grid; gap: var(--space-4); padding-block: var(--space-5) var(--space-8); }

	/* Layout, message bubbles, and nothing else: the material, fields, buttons,
	   rows and status lines all come from styles/glass.css. */
	/* Same inset as --parent-pad, which `large` declares for nested radii. */
	.dm-panel { padding: var(--glass-pad-lg); }
	.dm-panel[hidden] { display: none; }
	.dm-signin h2 { margin: 0 0 var(--space-2); color: var(--text-strong); font-size: var(--text-title); }
	.dm-signin p { margin: 0; max-width: 44rem; color: var(--text-muted); }
	.dm-signin a { color: var(--text-strong); }

	/* The one disclosure: an accent hairline instead of a filled box, so it reads
	   as a note about the page and not as another panel. */
	.dm-disclosure {
		margin: 0 0 var(--space-4);
		padding-inline-start: var(--space-3);
		border-inline-start: 2px solid var(--accent-line);
		color: var(--text-muted);
		font-size: var(--text-small);
		line-height: 1.6;
	}

	.dm-layout { display: grid; grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr); gap: var(--space-4); align-items: start; }
	@media (max-width: 760px) { .dm-layout { grid-template-columns: 1fr; } }

	.dm-side { display: grid; gap: var(--space-3); }
	.dm-new { display: grid; gap: var(--space-1); }
	.dm-new__row { display: flex; gap: var(--space-2); align-items: center; }
	.dm-new__row .glass-field { flex: 1 1 10rem; }
	.dm-side__title {
		margin: var(--space-2) 0 0;
		font-size: var(--text-micro);
		letter-spacing: var(--tracking-mono);
		text-transform: uppercase;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}
	.dm-list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); max-block-size: 24rem; overflow-y: auto; }
	.dm-list__button { display: grid; gap: 0.15rem; text-align: start; cursor: pointer; inline-size: 100%; }
	.dm-list__name { display: flex; justify-content: space-between; gap: var(--space-2); color: var(--text-strong); font-weight: 600; }
	.dm-list__preview { color: var(--text-muted); font-size: var(--text-micro); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	/* Unread count: a chip inside a row that is itself a button, so it must not
	   read as a second control — tinted fill, no border, no shadow. */
	.dm-list__badge {
		min-inline-size: 1.3rem;
		padding-inline: var(--space-1);
		border-radius: var(--radius-pill);
		background: var(--accent-soft);
		color: var(--text-strong);
		font-size: var(--text-micro);
		font-weight: 700;
		text-align: center;
	}

	.dm-thread-wrap { display: grid; gap: var(--space-3); min-block-size: 20rem; padding: var(--space-4); }
	.dm-thread-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-4); }
	.dm-thread-head h2 { margin: 0; font-size: var(--text-title); color: var(--text-strong); }
	.dm-conn { color: var(--text-muted); font-size: var(--text-micro); }
	.dm-thread { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); max-block-size: 50vh; overflow-y: auto; }
	.dm-empty, .dm-thread-empty { margin: 0; color: var(--text-muted); font-size: var(--text-small); }

	/* Bubbles are the one shape that is genuinely this page's: an asymmetric
	   corner says who sent it before any colour does. */
	.dm-msg { max-inline-size: min(36rem, 85%); justify-self: start; padding: var(--space-2) var(--space-3); border-radius: var(--radius-md) var(--radius-md) var(--radius-md) var(--radius-xs); background: var(--glass-bg); }
	.dm-msg--me { justify-self: end; border-radius: var(--radius-md) var(--radius-md) var(--radius-xs) var(--radius-md); background: var(--accent-soft); }
	.dm-msg__body { margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; color: var(--text); }
	.dm-msg img { display: block; max-inline-size: 100%; max-block-size: 22rem; border-radius: var(--radius-xs); margin-block: var(--space-1); }
	.dm-msg__meta { display: flex; gap: var(--space-2); align-items: center; margin-block-start: var(--space-1); color: var(--text-muted); font-size: var(--text-micro); }

	.dm-composer { display: grid; gap: var(--space-2); }
	.dm-composer__row { display: flex; gap: var(--space-2); align-items: end; }
	.dm-composer__row .glass-field { flex: 1 1 12rem; resize: vertical; min-block-size: 2.6rem; }
	.dm-attach { flex: none; padding-inline: 0.7rem; }
	.dm-image-chip { display: inline-flex; align-items: center; gap: var(--space-2); justify-self: start; }
</style>

<script>
	import { mountMessages } from '../scripts/messages-ui';
	const root = document.querySelector<HTMLElement>('[data-messages-root]');
	if (root) void mountMessages(root);
</script>
