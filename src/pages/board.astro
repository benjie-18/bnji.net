---
/**
 * /board/ — the public message board's dedicated home.
 *
 * The board used to be a global overlay on every page; it now lives on this
 * route only, linked from the primary nav. All of its pieces ship together:
 * MessageBoard.astro (markup) imports styles/board.css and boots
 * scripts/board.ts, so no other page carries board CSS, JS or listeners.
 * The physics engine (scripts/board-physics.ts) is untouched by the move.
 *
 * The overlay field is fixed and pointer-transparent, so bubbles float over
 * the page header while everything on the page stays clickable; the composer
 * is mobile-safe (dvh sizing, safe-area padding, visual-viewport tracking in
 * scripts/board.ts) and never covers the field or its own slider when the
 * virtual keyboard opens.
 */
import MessageBoard from '../components/MessageBoard.astro';
import PageHeader from '../components/PageHeader.astro';
import Layout from '../layouts/Layout.astro';

const description =
	'The public message board: leave a note and watch it float. Bubbles in the light theme, stars in the dark — drag them, collide them, read the archive.';
---

<Layout title="Board" description={description}>
	<PageHeader
		index="08"
		label="BOARD"
		titleId="page-title"
		title="Message Board"
		description="One public board for everyone. Post a message and it joins the drift — floating, colliding and glowing with the theme. Drag any bubble (or star) you like; the slider decides how many recent messages are in the sky."
		meta={['Public', 'Draggable', 'Archive inside']}
	/>

	<MessageBoard />
</Layout>
