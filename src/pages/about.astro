---
/**
 * /about/ — profile overview and a link to the full social profile.
 *
 * HIDDEN FOR NOW: redundant with the /gizlyy/ profile. It is out of the
 * navigation (src/data/navigation.ts) and out of the sitemap + noindexed,
 * but the route itself is left intact so bringing it back is a two-line
 * change (uncomment the nav entry, drop noindex + the sitemap filter).
 *
 * Copy lives here rather than in data/ because it is prose specific to one page;
 * anything reused (name, location, tagline, socials) comes from data/site.ts.
 */
import ProfileCard from '../components/ProfileCard.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../data/site';
import Layout from '../layouts/Layout.astro';

const title = `About ${SITE.author.name}`;
const description = 'Lorem ipsum dolor sit amet, consectetur adipiscing elit.';
---

<Layout title="About" description={description} noindex={true}>
	<PageHeader
		index="01"
		label="IDENTITY"
		title={title}
		titleId="page-title"
		description={SITE.author.tagline}
	/>

	<div class="container">
		<div class="about-body">
			<section class="section section--tight" aria-labelledby="card-title">
				<h2 id="card-title" class="sr-only">Profile card</h2>
				<ProfileCard />
				<div class="profile-cta">
					<a class="profile-cta__link" href="/gizlyy/" data-glass="interactive quiet">
						<Icon name="link" size={16} />
						<span class="profile-cta__text">
							<strong>Full social profile</strong>
							<span class="profile-cta__desc">Links, games, music, reactions and more</span>
						</span>
						<Icon name="arrow-right" size={14} />
					</a>
				</div>
			</section>
		</div>
	</div>
</Layout>

<style>
	.section--tight {
		padding-block: clamp(2.5rem, 6vh, 4.5rem);
	}

	.about-body {
		padding-block-end: clamp(3rem, 8vh, 6rem);
	}

	/* --- Profile CTA ----------------------------------------------------- */
	.profile-cta {
		margin-top: 1.25rem;
		display: flex;
		justify-content: center;
	}

	.profile-cta__link {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.65rem 1rem;
		border-radius: var(--radius-lg);
		color: var(--text);
		text-decoration: none;
		font-size: var(--text-small);
		transition:
			background-color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			transform var(--dur-fast) var(--ease-out);
	}

	.profile-cta__link:hover {
		transform: translateY(-1px);
	}

	.profile-cta__text {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.profile-cta__text strong {
		font-weight: 600;
	}

	.profile-cta__desc {
		font-size: var(--text-micro);
		color: var(--text-dim);
	}

	.profile-cta__link .icon:last-child {
		flex: none;
		color: var(--text-faint);
		transition: transform var(--dur-fast) var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.profile-cta__link:hover .icon:last-child {
			transform: translateX(3px);
		}
	}

</style>
