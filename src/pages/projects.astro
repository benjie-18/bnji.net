---
/**
 * /projects/ — every project in src/data/projects.ts.
 *
 * Featured projects get the wide flagship treatment; the rest flow into a
 * two-column bento. Adding a project to the data file is enough to make it
 * appear here — this page has no per-project markup.
 */
import PageHeader from '../components/PageHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getAllProjects } from '../data/projects';
import { SITE } from '../data/site';
import Layout from '../layouts/Layout.astro';

const projects = getAllProjects();
const featured = projects.filter((project) => project.featured);
const rest = projects.filter((project) => !project.featured);

const description = `Projects by ${SITE.author.name} — software, local AI infrastructure and homelab work, with the stack behind each one.`;
---

<Layout title="Projects" description={description}>
	<PageHeader
		index="02"
		label="PROJECTS"
		titleId="page-title"
		title="Things I build and keep running"
	/>

	<div class="container projects-body">
		<div class="bento">
			{
				featured.map((project, index) => (
					<ProjectCard
						project={project}
						index={index}
						feature
						span={index === 0 ? 12 : 6}
						revealDelay={index * 90}
						headingLevel="h2"
					/>
				))
			}

			{
				rest.map((project, index) => (
					<ProjectCard
						project={project}
						index={featured.length + index}
						span={6}
						revealDelay={index * 70}
						headingLevel="h2"
					/>
				))
			}
		</div>

	</div>
</Layout>

<style>
	.projects-body {
		display: grid;
		gap: var(--grid-gap);
		padding-block-end: clamp(3rem, 8vh, 6rem);
	}

</style>
