---
/**
 * /admin — the operator's console for the message board and profile system.
 *
 * NOT prerendered (`prerender = false`), which is what makes the '/admin'
 * access rule in access.config.ts enforceable: the middleware only runs on
 * requests that execute Worker code. A prerendered admin page would be
 * served straight off the edge without ever being checked.
 *
 * The page ships NO data. Everything it shows arrives from /api/admin/* after
 * the client exchanges the access token for a session cookie, and every one
 * of those routes re-checks the credential independently — so a bypass of the
 * page reveals nothing, because the data was never in the HTML to begin with.
 *
 * Tabs:
 *   Overview   security totals + board totals at a glance
 *   Security   the security_events log, filterable by surface / IP / device
 *   Board      message moderation, including hidden and deleted rows
 *   Playlist   the music queue: import a provider link, edit the draft, reorder
 *   Config     every public config value, plus binding/secret presence
 */
import Layout from '../../layouts/Layout.astro';
// Global (not scoped) on purpose: most admin markup is built by
// admin-dashboard.ts at runtime, and Astro's scoped styles never reach
// elements created after render — the old moderation buttons and config
// cards rendered unstyled because of exactly that.
import '../../styles/admin.css';

// NOT PRERENDERED. This line is the entire access control for the page.
//
// Astro prerenders pages by default, and a prerendered page is served
// straight off the edge as a static asset — the Worker never runs, so
// src/middleware.ts never runs, and the '/admin' rule in ACCESS_RULES is
// never evaluated. The build would happily bake a redirect (or worse, the
// whole dashboard) into dist/client/admin/index.html and publish it.
//
// scripts/verify-access.mjs asserts this at build time, because getting it
// wrong is silent and looks like it works.
export const prerender = false;
---

<Layout
	title="Admin"
	description="BNJI.NET operator console."
	noindex={true}
>
	<div class="admin" data-admin>
		<header class="admin__header" data-glass="raised">
			<div>
				<p class="eyebrow">Operator console</p>
				<h1 class="admin__title text-luminous">Admin</h1>
			</div>
			<div class="admin__header-actions">
				<span class="admin__status" data-admin-status role="status" aria-live="polite" />
				<button class="glass-button glass-button--sm" data-glass="" type="button" data-admin-refresh>Refresh</button>
				<button class="glass-button glass-button--sm glass-button--quiet" data-glass="" type="button" data-admin-logout>Sign out</button>
			</div>
		</header>

		<nav class="admin__tabs" aria-label="Admin sections" data-glass="raised" data-admin-tabs>
			<span class="admin__tab-indicator" aria-hidden="true" data-tab-indicator></span>
			<button class="admin__tab" type="button" data-tab="stats" aria-selected="true">
				Statistics
			</button>
			<button class="admin__tab" type="button" data-tab="overview" aria-selected="false">
				Overview
			</button>
			<button class="admin__tab" type="button" data-tab="board" aria-selected="false">
				Message board
			</button>
			<button class="admin__tab" type="button" data-tab="playlist" aria-selected="false">
				Playlist
			</button>
			<button class="admin__tab" type="button" data-tab="security" aria-selected="false">
				Security log
			</button>
			<button class="admin__tab" type="button" data-tab="settings" aria-selected="false">
				Settings
			</button>
			<button class="admin__tab" type="button" data-tab="config" aria-selected="false">
				Configuration
			</button>
		</nav>

		<p class="admin__error" role="alert" data-admin-error hidden />

		<!-- Statistics: the site-wide numbers, grouped by where they come from -->
		<section class="admin__panel" data-panel="stats">
			<p class="admin__hint">
				Every number below is read through the same store method the public
				feature uses, so it cannot disagree with what visitors see.
			</p>

			<div class="admin__cards" data-stats-root>
				<div class="admin__card" data-glass>
					<h2 class="admin__h2">Traffic</h2>
					<div data-stats-traffic />
					<div class="admin__stack" data-stats-traffic-list />
				</div>

				<div class="admin__card" data-glass>
					<h2 class="admin__h2">Engagement</h2>
					<div class="admin__stack" data-stats-engagement />
				</div>

				<div class="admin__card" data-glass>
					<h2 class="admin__h2">Message board</h2>
					<div data-stats-board />
				</div>

				<div class="admin__card" data-glass>
					<h2 class="admin__h2">Security</h2>
					<div data-stats-security />
				</div>
			</div>
		</section>

		<!-- Overview -->
		<section class="admin__panel" data-panel="overview" hidden>
			<div class="admin__cards">
				<div class="admin__card" data-glass>
					<h2 class="admin__h2">Security events</h2>
					<div data-overview-security />
				</div>

				<div class="admin__card" data-glass>
					<h2 class="admin__h2">Message board</h2>
					<div data-overview-board />
				</div>

				<div class="admin__card" data-glass>
					<h2 class="admin__h2">Environment</h2>
					<div data-overview-env />
				</div>
			</div>
		</section>

		<!-- Security log -->
		<section class="admin__panel" data-panel="security" hidden>
			<form class="admin__filters" data-glass data-security-filters>
				<label>
					<span>Surface</span>
					<select name="surface" data-filter-surface>
						<option value="">All surfaces</option>
						<option value="profile">Profile</option>
						<option value="board">Message board</option>
						<option value="dm">Direct message</option>
					</select>
				</label>
				<label>
					<span>IP address</span>
					<input name="ip" type="text" placeholder="203.0.113.45" data-filter-ip />
				</label>
				<label>
					<span>Device fingerprint</span>
					<input name="device" type="text" placeholder="af72f902…" data-filter-device />
				</label>
				<label class="admin__check">
					<input name="enrichedOnly" type="checkbox" data-filter-enriched />
					<span>With device data only</span>
				</label>
				<label>
					<span>Rows</span>
					<input name="limit" type="number" min="1" max="500" value="50" data-filter-limit />
				</label>
				<button class="glass-button glass-button--sm glass-button--primary" data-glass="" type="submit">Apply</button>
			</form>
			<p class="admin__hint">
				Filter by device fingerprint to see everything one device did, across every surface.
			</p>
			<div class="admin__table-wrap" data-glass data-security-table />
			<div class="admin__card" data-glass>
				<h2 class="admin__h2">Published Paint activity</h2>
				<p class="admin__hint">
					Only accepted Sync &amp; refresh publishes appear here. Local edits are not logged; entries contain action summaries, not pointer paths or sticker images. The opaque visitor/session ID is temporary and does not identify an account or person. Retained for up to 60 days, capped at 5,000 entries.
				</p>
				<div class="admin__table-wrap" data-paint-activity />
			</div>
		</section>

		<!-- Board moderation -->
		<section class="admin__panel" data-panel="board" hidden>
			<form class="admin__filters" data-glass data-board-filters>
				<label>
					<span>Status</span>
					<select name="status" data-board-status>
						<option value="">All statuses</option>
						<option value="reported">Reported</option>
						<option value="visible">Visible</option>
						<option value="hidden">Hidden</option>
						<option value="deleted">Deleted</option>
					</select>
				</label>
				<label>
					<span>Min reports</span>
					<input name="minReports" type="number" min="0" value="0" data-board-min-reports />
				</label>
				<label>
					<span>Search text</span>
					<input name="search" type="text" placeholder="message text" data-board-search />
				</label>
				<button class="glass-button glass-button--sm glass-button--primary" data-glass="" type="submit">Apply</button>
			</form>
			<div class="admin__table-wrap" data-glass data-board-table />
		</section>

		<!-- Music playlist: import a provider link, edit the draft, reorder -->
		<section class="admin__panel" data-panel="playlist" hidden>
			<div class="admin__card" data-glass>
				<h2 class="admin__h2">Add a track</h2>
				<p class="admin__hint">
					Paste one YouTube video link. Metadata is resolved server-side and every
					field stays editable before saving; a valid link plus a title is enough,
					and artist, album and the publication date are optional. If the lookup
					fails or comes back incomplete, the same form is there to fill in by hand.
				</p>
				<form class="admin__form" data-playlist-import>
					<!--
						type="text", not type="url": the browser's own "please enter a URL"
						tooltip cannot say WHY a link was refused, and the server replies with
						the specific reason (insecure scheme, wrong host, a malformed path, a
						bad video id). inputmode keeps the URL keyboard on mobile.
					-->
					<label class="admin__field">
						<span>YouTube video URL</span>
					<input
						type="text"
						name="url"
						required
						inputmode="url"
						autocomplete="off"
						spellcheck="false"
						placeholder="https://youtube.com/watch?v=… or https://youtu.be/…"
						data-playlist-url
					/>
					</label>
					<div class="admin__actions">
						<button class="glass-button glass-button--primary" data-glass="" type="submit" data-playlist-resolve>
							Resolve metadata
						</button>
					</div>
				</form>
				<p class="admin__hint" data-playlist-lookup hidden></p>
			</div>

			<form class="admin__card admin__playlist-draft" data-glass data-playlist-draft hidden>
				<h2 class="admin__h2">Review before saving</h2>
				<p class="admin__hint" data-playlist-draft-note></p>

				<label class="admin__field">
					<span>Provider</span>
					<input type="text" data-playlist-draft-provider readonly />
				</label>

				<label class="admin__field">
					<span>Link (normalised from the provider id)</span>
					<input type="text" data-playlist-draft-url readonly />
				</label>

				<label class="admin__field">
					<span>Title (required)</span>
					<input type="text" required maxlength="200" data-playlist-draft-title />
				</label>

				<label class="admin__field">
					<span>Artist (optional)</span>
					<input type="text" maxlength="120" data-playlist-draft-artist />
				</label>

				<label class="admin__field">
					<span>Album (optional)</span>
					<input type="text" maxlength="160" data-playlist-draft-album />
				</label>

				<label class="admin__field">
					<span data-playlist-date-label>Date (optional)</span>
					<input
						type="text"
						inputmode="numeric"
						placeholder="YYYY-MM-DD"
						maxlength="10"
						data-playlist-draft-date
					/>
				</label>
				<p class="admin__hint" data-playlist-date-hint></p>

				<p class="admin__error" role="alert" data-playlist-error hidden></p>

				<div class="admin__actions">
					<button class="glass-button glass-button--primary" data-glass="" type="submit" data-playlist-save>
						Save to playlist
					</button>
					<button class="glass-button glass-button--quiet" data-glass="" type="button" data-playlist-discard>
						Discard draft
					</button>
				</div>
			</form>

			<div class="admin__card" data-glass>
				<h2 class="admin__h2">Playlist order</h2>
				<p class="admin__hint">
					Order is playback order. An empty playlist stays empty: nothing is restored
					automatically after the last item is removed.
				</p>
				<div class="admin__table-wrap" data-playlist-table></div>
			</div>
		</section>

		<!-- Settings: the access token -->
		<section class="admin__panel" data-panel="settings" hidden>
			<div class="admin__card admin__card--narrow" data-glass>
			<h2 class="admin__h2">Access token</h2>
			<p class="admin__hint" data-token-state>
				The token is stored as a SHA-256 hash. It cannot be read back, by
				design — if it is lost, re-seed the
				<code>admin_credentials</code> row.
			</p>

			<form class="admin__form" data-token-form>
				<label class="admin__field">
					<span>Current token</span>
					<input
						type="password"
						name="current"
						autocomplete="current-password"
						required
						data-token-current
					/>
				</label>

				<label class="admin__field">
					<span>New token</span>
					<input
						type="password"
						name="new"
						autocomplete="new-password"
						required
						minlength="8"
						data-token-new
					/>
				</label>

				<label class="admin__field">
					<span>Confirm new token</span>
					<input
						type="password"
						name="confirm"
						autocomplete="new-password"
						required
						minlength="8"
						data-token-confirm
					/>
				</label>

				<p class="admin__hint">
					Changing the token signs out every existing session immediately —
					sessions are bound to the token that minted them. Use at least 8
					characters; the seeded value is shorter and should be replaced at
					your first login.
				</p>

				<button class="glass-button glass-button--primary" data-glass="" type="submit" data-token-submit>Change token</button>
			</form>
			<p class="admin__error" role="alert" data-token-error hidden />
			</div>
		</section>

		<!-- Configuration -->
		<section class="admin__panel" data-panel="config" hidden>
			<p class="admin__hint">
				Values are read from the same modules the running site uses, so this can never
				drift from actual behaviour. Secrets are reported as present or absent only —
				never returned.
			</p>
			<div class="admin__cards" data-config-groups />
		</section>
	</div>
</Layout>

<script>
	import { startAdminDashboard } from '../../scripts/admin-dashboard';

	startAdminDashboard();
</script>
