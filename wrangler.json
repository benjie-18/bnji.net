{
	"name": "bnjibot",
	"compatibility_date": "2026-09-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "BOARD_DB",
			"database_name": "bnji-board",
			"database_id": "4a121806-46a2-4d19-ae17-e06e5ad794f3",
			"migrations_dir": "migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "BOARD_KV",
			"id": "593c5c160a1c44e78f81dc9aaa857e9c"
		}
	],
	"triggers": {
		"crons": [
			"0 * * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"durable_objects": {
		"bindings": [
			{
				"name": "GAME_ROOMS",
				"class_name": "GameRoom"
			},
			{
				"name": "DM_CONVERSATIONS",
				"class_name": "DMConversation"
			},
			{
				"name": "PRESENCE",
				"class_name": "Presence"
			}
		]
	},
	"migrations": [
		{
			"tag": "game-rooms-v1",
			"new_sqlite_classes": [
				"GameRoom"
			]
		},
		{
			"tag": "dm-conversations-v1",
			"new_sqlite_classes": [
				"DMConversation"
			]
		},
		{
			"tag": "presence-v1",
			"new_sqlite_classes": [
				"Presence"
			]
		}
	],
	"previews": {
		"d1_databases": [
			{
				"binding": "BOARD_DB",
				"database_name": "bnji-board-preview",
				"database_id": "1c71da3f-0a6e-4347-af0a-85303d3ed352"
			}
		],
		"kv_namespaces": [
			{
				"binding": "BOARD_KV",
				"id": "73caa06123e144d899c2eb167f8dc211"
			}
		],
		"durable_objects": {
			"bindings": [
				{
					"name": "GAME_ROOMS",
					"class_name": "GameRoom"
				},
				{
					"name": "DM_CONVERSATIONS",
					"class_name": "DMConversation"
				},
				{
					"name": "PRESENCE",
					"class_name": "Presence"
				}
			]
		}
	}
}
